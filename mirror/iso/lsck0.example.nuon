{
    profile: "luca"                   # profiles/<name>, or "custom"
    platform: "luca-pc"               # platforms/<name> (luca-pc, luca-notebook), "server" or "custom"
    username: "luca"
    keymap: "de-latin1"               # also used for the Wi-Fi password
    disk: "/dev/disk/by-id/nvme-Samsung_SSD_980_1TB_S64ANS0T000000X"  # erased; a by-id path, /dev/sdX can change between boots
    encrypt: true
    password: "ask"                   # disk and login password; "ask" or left out asks, a crypt hash is refused
    home_network: false

    wifi: [
        {ssid: "home", psk: "passphrase"}
    ]

    unattended: false                 # true: no summary and no erase confirmation, missing keys take their defaults, required ones must be set here or in the environment

    # a server or custom platform also takes (defaults shown):
    # hostname: "archlinux"            # letters, digits and dashes
    # groups: [base core desktop]      # package groups; base is always included
    # timezone: "Europe/Berlin"
    # locale: "en_US.UTF-8"
    # ssh_key: ""                      # one ssh public key line; empty leaves just the console
    # secure_boot: "microsoft"         # "own", "microsoft" or "off"
    # root_password: "ask"             # empty keeps root locked
    # user_password: "ask"             # login and sudo; empty reuses the disk password

    # unattended runs and the test harness also take:
    # server: false                    # shorthand for the server platform
    # reinstall: false                 # erase a disk still mid-install
    # report: ""                       # watcher url every stage beacons to (dot test)
    # source: {bundle: "", lfs: ""}    # where the installer pulls the repo bundle and lfs from
}
