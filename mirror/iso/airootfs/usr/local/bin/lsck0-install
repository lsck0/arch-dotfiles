#!/usr/bin/env -S nu --no-config-file
# the lsck0 iso's installer on tty1: answers (lsck0.nuon, lsck0.* boot parameters), internet (cable or wi-fi), then
# the repo's own bootstrap.sh, which clones the newest signed master; the baked checkout only launches it

const LAUNCHER = "/usr/share/lsck0/arch-dotfiles"
# the bootstrap's questions: the answer file's keys and types, and this script's texts
const QUESTIONS = "scripts/lib/bootstrap/questions.nuon"
const DOTFILES_URL = "https://github.com/lsck0/arch-dotfiles.git"
const CLONE_DIR = "/tmp/arch-dotfiles"
const ANSWERS_NAME = "lsck0.nuon"
const ANSWERS_LABEL = "/dev/disk/by-label/LSCK0"
const BOOT_MEDIUM = "/run/archiso/bootmnt"
const STAGE_DIR = "/run/lsck0"
const ISO_GLOB = "archlinux-lsck0*.iso"
const ISO_SEARCH_DEPTH = 2
const CMDLINE_PARAM = '(?:^|\s)lsck0\.(?<key>[^\s=]+)=(?:"(?<quoted>[^"]*)"|(?<plain>\S*))'
const MEDIA_FSTYPES = [vfat exfat iso9660 udf ntfs ntfs3]
# the two hosts an install needs first: the [lsck0] packages and the repo
const PROBES = [https://mirror.lsck0.dev https://github.com]
const PROBE_TIMEOUT_S = 5
# dhcp on a cable lands well within this
const ONLINE_WAIT = 20sec
const ONLINE_POLL = 1sec
const CABLE_POLL = 5sec
const WIFI_SCAN_WAIT = 3sec
const KEYMAP_DEFAULT = "de-latin1"
const PASSWORD_ASK = "ask"
const PASSWORD_HASH = '^\$(1|2[aby]|5|6|y|gy|7)\$'
const LOG = "/tmp/lsck0-install.log"
const TUI_BACKTITLE = "Arch Linux install"
const TUI_WIDTH = 72
const TUI_MENU_ROWS = 12
const PICK_RESCAN = "rescan"
const PICK_HIDDEN = "hidden"
const PICK_SHELL = "shell"
# a question's kind as the answer file's type
const KIND_TYPES = {
    text: string password: string flag: bool menu: string keymap: string profile: string platform: string
    groups: "list<string>" disk: string
}
const SOURCE_PATH_KEYS = [bundle lfs]

# -----------------------------------------------------------------------------
# answers
# -----------------------------------------------------------------------------

export def questions-load [repo: path]: nothing -> record { open ($repo | path join $QUESTIONS) }

# {name} in a questions.nuon text
def text-fill [text: string, values: record]: nothing -> string {
    $values | items {|name, value| {name: $name, value: $value} } | reduce --fold $text {|v, acc| $acc | str replace --all $"{($v.name)}" ($v.value | into string) }
}

# answer-file key: {type, env (the BOOTSTRAP_* it sets), keys (a record's own), password}
export def answers-spec [questions: record]: nothing -> record {
    let asked = $questions.questions | where {|e| $e.id? != null } | each {|e|
        {id: $e.id, type: ($KIND_TYPES | get $e.kind), env: $e.env, keys: null, password: ($e.kind == "password")}
    }
    let own = $questions.answers | each {|a| {id: $a.id, type: $a.type, env: ($a.env? | default ""), keys: $a.keys?, password: false} }
    $asked ++ $own | uniq-by id | reduce --fold {} {|k, acc| $acc | insert $k.id ($k | reject id) }
}

def type-of [value: any]: nothing -> string {
    let t = $value | describe
    if ($t | str starts-with "record") { return record }
    if ($t | str starts-with "list") or ($t | str starts-with "table") {
        if ($value | all {|v| ($v | describe) == "string" }) { return "list<string>" }
        if ($value | all {|v| ($v | describe) | str starts-with "record" }) { return "list<record>" }
    }
    $t
}

def record-problems [r: record, spec: record, prefix: string]: nothing -> list<string> {
    $r | items {|k, v|
        if $k not-in $spec {
            $"($prefix)($k): unknown key, one of ($spec | columns | str join ' ')"
        } else if (type-of $v) != ($spec | get $k) and not (($spec | get $k) == "list<string>" and ($v | is-empty)) {
            $"($prefix)($k): expected ($spec | get $k), got (type-of $v)"
        }
    } | compact
}

export def answers-problems [spec: record, a: record]: nothing -> list<string> {
    let top = record-problems $a ($spec | items {|k, v| {k: $k, type: $v.type} } | reduce --fold {} {|it, acc| $acc | insert $it.k $it.type }) ""
    if ($top | is-not-empty) { return $top }
    let wifi = $a.wifi? | default [] | enumerate | each {|w|
        let p = record-problems $w.item $spec.wifi.keys $"wifi.($w.index)."
        if ($w.item.ssid? | is-empty) { $p | append $"wifi.($w.index).ssid: missing" } else { $p }
    } | flatten
    let source = if $a.source? == null { [] } else {
        let p = record-problems $a.source $spec.source.keys "source."
        if ($a.source.bundle? | is-empty) { $p | append "source.bundle: missing" } else { $p }
    }
    let hashed = $spec | items {|k, v| if $v.password { $k } } | compact | where {|k| ($a | get --optional $k | default "") =~ $PASSWORD_HASH }
        | each {|k| $"($k): a crypt hash, the bootstrap takes the password itself or \"ask\"" }
    $wifi ++ $source ++ $hashed
}

def cmdline-value [spec: record, key: string, raw: string]: nothing -> any {
    let leaf = $key | split row "." | last
    let type = if ($key | str starts-with "wifi.") { $spec.wifi.keys | get --optional $leaf } else if ($key | str starts-with "source.") { $spec.source.keys | get --optional $leaf } else { $spec | get --optional $key | get --optional type }
    match $type {
        "bool" => (match ($raw | str lowercase) { "1" | "true" | "yes" => true, "0" | "false" | "no" => false, _ => $raw })
        "list<string>" => ($raw | split row "," | where $it != "")
        _ => $raw
    }
}

# lsck0.answers=<url or path>, lsck0.<key>=<value>; wifi.ssid/wifi.psk set the first network
export def answers-cmdline [spec: record, cmdline: string]: nothing -> record {
    $cmdline | parse --regex $CMDLINE_PARAM | reduce --fold {answers: null, overrides: {}} {|p, acc|
        let raw = if ($p.quoted | is-not-empty) { $p.quoted } else { $p.plain }
        if $p.key == "answers" { return ($acc | update answers $raw) }
        let path = if ($p.key | str starts-with "wifi.") { $p.key | str replace "wifi." "wifi.0." } else { $p.key }
        let cells = $path | split row "." | each {|c| if $c =~ '^\d+$' { $c | into int } else { $c } } | into cell-path
        let overrides = if ($p.key | str starts-with "wifi.") and ($acc.overrides.wifi? == null) { $acc.overrides | insert wifi [{}] } else { $acc.overrides }
        $acc | update overrides ($overrides | upsert $cells (cmdline-value $spec $p.key $raw))
    }
}

def answers-parse [text: string, origin: string]: nothing -> record {
    let a = try { $text | from nuon } catch {|e| error make {msg: $"($origin): not nuon: ($e.msg)"} }
    if ($a | describe | str starts-with "record") { $a } else { error make {msg: $"($origin): expected a record"} }
}

# source paths are relative to the answer file; copied out, so its medium can be unmounted (it may be the target disk)
def answers-stage [a: record, dir: path]: nothing -> record {
    if $a.source? == null { return $a }
    mkdir $STAGE_DIR
    $SOURCE_PATH_KEYS | reduce --fold $a {|k, acc|
        let p = $acc.source | get --optional $k
        if $p == null or ($p =~ '^https?://') { return $acc }
        let from = if ($p | str starts-with "/") { $p } else { $dir | path join $p }
        let to = $STAGE_DIR | path join ($from | path basename)
        cp $from $to
        $acc | update source ($acc.source | upsert $k $to)
    }
}

def answers-in [dir: path]: nothing -> list<path> {
    let beside = glob --depth $ISO_SEARCH_DEPTH ($dir | path join "**" $ISO_GLOB) | each { path dirname | path join $ANSWERS_NAME }
    [($dir | path join $ANSWERS_NAME)] ++ $beside | uniq | where { path exists }
}

# the LSCK0 partition first, then the boot medium, then every other medium; a ventoy stick has the file beside the iso
def answers-media []: nothing -> any {
    let devices = ^lsblk -J -l -pno NAME,FSTYPE,MOUNTPOINT | from json | get blockdevices
        | where fstype in $MEDIA_FSTYPES
    let label = if ($ANSWERS_LABEL | path exists) { $ANSWERS_LABEL | path expand } else { "" }
    let ordered = ($devices | where name == $label) ++ ($devices | where name != $label)
    for f in (answers-in $BOOT_MEDIUM) { return {file: $f, dir: ($f | path dirname)} }
    for d in $ordered {
        let mounted = $d.mountpoint | is-not-empty
        let dir = if $mounted { $d.mountpoint } else { $STAGE_DIR | path join mnt ($d.name | path basename) }
        if not $mounted {
            mkdir $dir
            if (^mount -o ro $d.name $dir | complete).exit_code != 0 { continue }
        }
        let found = answers-in $dir | get --optional 0
        let a = if $found == null { null } else {
            let parsed = try { answers-parse (open --raw $found) $"($d.name):($found | path relative-to $dir)" } catch {|e| {error: $e.msg} }
            if $parsed.error? != null { $parsed } else { answers-stage $parsed ($found | path dirname) | insert origin $"($d.name):($found | path relative-to $dir)" }
        }
        if not $mounted { ^umount $dir | complete | ignore }
        if $a != null { return $a }
    }
    null
}

def answers-fetch [where: string]: nothing -> record {
    if $where =~ '^https?://' {
        let r = ^curl -fsS -m $PROBE_TIMEOUT_S $where | complete
        if $r.exit_code != 0 { error make {msg: $"($where): ($r.stderr | str trim)"} }
        return (answers-parse $r.stdout $where)
    }
    let file = if ($where | str starts-with "/") { $where } else { $BOOT_MEDIUM | path join $where }
    if not ($file | path exists) { error make {msg: $"($where): no such file"} }
    answers-stage (answers-parse (open --raw $file) $where) ($file | path dirname)
}

export def answers-env [spec: record, a: record]: nothing -> record {
    $a | items {|k, v|
        let key = $spec | get --optional $k | default {env: "", password: false}
        if $key.env == "" or ($key.password and $v == $PASSWORD_ASK) { return null }
        let text = match (type-of $v) { "bool" => (if $v { "1" } else { "0" }), "list<string>" => ($v | str join " "), _ => $v }
        {$key.env: $text}
    } | compact | reduce --fold {} {|it, acc| $acc | merge $it }
}

def answers-or-die [spec: record, a: record]: nothing -> record {
    let problems = answers-problems $spec ($a | reject --optional origin)
    if ($problems | is-not-empty) { error make {msg: $"answers: ($problems | str join '; ')"} }
    $a | reject --optional origin
}

# -----------------------------------------------------------------------------
# network
# -----------------------------------------------------------------------------

# empty when online, else what is missing in a few words
def network-missing [t: record]: nothing -> string {
    let up = ls /sys/class/net | get name | path basename | where $it != "lo" | where {|i| (open --raw $"/sys/class/net/($i)/operstate" | str trim) == "up" }
    if ($up | is-empty) { return $t.no_link }
    if (^ip -j route show default | from json | is-empty) { return (text-fill $t.no_address {devices: ($up | str join ' ')}) }
    for url in $PROBES {
        let code = ^curl -s -o /dev/null -m $PROBE_TIMEOUT_S -w "%{http_code}" $url | complete | get stdout
        if $code in ["" "000"] { return (text-fill $t.no_answer {host: ($url | url parse | get host)}) }
    }
    ""
}

def network-wait [t: record, timeout: duration]: nothing -> string {
    let deadline = (date now) + $timeout
    mut missing = network-missing $t
    while $missing != "" and (date now) < $deadline {
        sleep $ONLINE_POLL
        $missing = network-missing $t
    }
    $missing
}

def wifi-device []: nothing -> any {
    ls /sys/class/net | get name | where {|d| $d | path join wireless | path exists } | get --optional 0 | if $in == null { null } else { path basename }
}

def wifi-scan [device: string]: nothing -> table {
    ^iwctl station $device scan | complete | ignore
    sleep $WIFI_SCAN_WAIT
    ^iwctl station $device get-networks | complete | get stdout | ansi strip | lines
    | parse --regex '^\s*>?\s+(?<ssid>\S.*?)\s{2,}(?<security>\S+)\s+(?<signal>\*+)\s*$'
}

def wifi-connect [t: record, device: string, network: record]: nothing -> string {
    let verb = if ($network.hidden? | default false) { "connect-hidden" } else { "connect" }
    let secret = if ($network.psk? | is-empty) { [] } else { [--passphrase $network.psk] }
    let r = ^iwctl ...$secret station $device $verb $network.ssid | complete
    if $r.exit_code != 0 { return $"($network.ssid): ($r.stdout | ansi strip | str trim | default --empty $t.wifi.failed)" }
    network-wait $t $ONLINE_WAIT
}

def --wrapped dlg [...args: string]: nothing -> any {
    # collected inside the try: a cancelled box raises, and its empty stream must not leak out
    try { ^dialog --backtitle $TUI_BACKTITLE --stdout ...$args | collect } catch { null }
}

# a passphrase is typed in the console's layout, so the bootstrap's keymap is settled before it
def --env keymap-ensure [t: record]: nothing -> nothing {
    if ($env.BOOTSTRAP_KEYMAP? | is-not-empty) { return }
    let keymap = dlg --title $t.keymap.title --inputbox $t.keymap.text "8" ($TUI_WIDTH | into string) $KEYMAP_DEFAULT | default $KEYMAP_DEFAULT | str trim
    if (^loadkeys $keymap | complete).exit_code == 0 { $env.BOOTSTRAP_KEYMAP = $keymap }
}

# loops until both probes answer: the iso installs nothing offline
def --env network-step [t: record, networks: list]: nothing -> bool {
    mut missing = network-wait $t $ONLINE_WAIT
    let device = wifi-device
    if $missing != "" and $device != null {
        ^rfkill unblock wifi | complete | ignore
        for n in $networks {
            print (text-fill $t.connecting {ssid: $n.ssid})
            $missing = wifi-connect $t $device $n
            if $missing == "" { break }
            print $"install: ($missing)"
        }
    }
    while $missing != "" {
        if $device == null {
            print (text-fill $t.waiting {missing: $missing, wait: $CABLE_POLL})
            sleep $CABLE_POLL
            $missing = network-missing $t
            continue
        }
        let found = wifi-scan $device
        let items = $found | each {|n| [$n.ssid $"($n.security) ($n.signal)"] } | flatten
        let extra = [$PICK_RESCAN $t.wifi.rescan $PICK_HIDDEN $t.wifi.hidden $PICK_SHELL $t.wifi.shell]
        let pick = dlg --title $t.wifi.title --menu (text-fill $t.wifi.text {missing: $missing}) "0" ($TUI_WIDTH | into string) ($TUI_MENU_ROWS | into string) ...$items ...$extra
        if $pick == null or $pick == $PICK_SHELL { return false }
        if $pick == $PICK_RESCAN { $missing = network-missing $t; continue }
        let hidden = $pick == $PICK_HIDDEN
        let ssid = if $hidden { dlg --title $t.wifi.title --inputbox $t.wifi.name "8" ($TUI_WIDTH | into string) | default "" } else { $pick }
        if $ssid == "" { continue }
        let open = not $hidden and ($found | where ssid == $ssid | get --optional 0.security) == "open"
        if not $open { keymap-ensure $t }
        let psk = if $open { "" } else { dlg --title $t.wifi.title --insecure --passwordbox (text-fill $t.wifi.password {ssid: $ssid}) "8" ($TUI_WIDTH | into string) | default "" }
        $missing = wifi-connect $t $device {ssid: $ssid, psk: $psk, hidden: $hidden}
    }
    true
}

# -----------------------------------------------------------------------------
# install
# -----------------------------------------------------------------------------

# an unpublished tree (the vm test's snapshot) on top of master; nothing verifies it
def checkout-from-bundle [source: record]: nothing -> path {
    let local = {|p| if $p =~ '^https?://' { let to = $"/tmp/(random uuid)"; ^curl -fsSo $to $p; $to } else { $p } }
    rm --recursive --force $CLONE_DIR
    ^git clone -q $DOTFILES_URL $CLONE_DIR
    let bundle = do $local $source.bundle
    let ref = ^git bundle list-heads $bundle | lines | first | split row " " | last
    ^git -C $CLONE_DIR fetch -q $bundle $ref
    ^git -C $CLONE_DIR checkout -q FETCH_HEAD
    if ($source.lfs? | is-not-empty) { ^tar -xf (do $local $source.lfs) -C ($CLONE_DIR | path join .git) }
    $CLONE_DIR
}

# unattended runs keep a log; the dialog screens of an interactive one would garble it
def run-logged [unattended: bool, argv: list<string>]: nothing -> nothing {
    if $unattended { ^bash -o pipefail -c $'"$@" 2>&1 | tee ($LOG)' run-logged ...$argv } else { run-external ...$argv }
}

def main [] {
    let questions = questions-load $LAUNCHER
    let spec = answers-spec $questions
    print "install: looking for an answer file"
    let cmdline = answers-cmdline $spec (open --raw /proc/cmdline)
    let media = try { answers-media } catch {|e| {error: $e.msg} }
    if $media.error? != null { print $"install: ($media.error), nothing installed"; return }
    if $media != null { print $"install: answers from ($media.origin)" }
    let early = try { answers-or-die $spec (($media | default {}) | merge deep $cmdline.overrides) } catch {|e| print $"install: ($e.msg), nothing installed"; return }
    if ($early.keymap? | is-not-empty) { ^loadkeys $early.keymap | complete | ignore }
    $env.BOOTSTRAP_KEYMAP = $early.keymap? | default ""

    if not (network-step $questions.iso ($early.wifi? | default [])) { print "install: stopped; run lsck0-install to start over"; return }
    print "install: online"
    let answers = if $cmdline.answers == null { $early } else {
        try {
            answers-or-die $spec (($media | default {}) | merge deep (answers-fetch $cmdline.answers) | merge deep $cmdline.overrides)
        } catch {|e| print $"install: ($e.msg), nothing installed"; return }
    }
    let env_answers = answers-env $spec $answers | merge (if $env.BOOTSTRAP_KEYMAP == "" { {} } else { {BOOTSTRAP_KEYMAP: $env.BOOTSTRAP_KEYMAP} })

    # bootstrap.sh's pacman -Sy needs the iso's keyring, which pacman-init.service may still be filling
    ^systemctl start pacman-init.service
    let unattended = $answers.unattended? | default false
    let status = with-env $env_answers {
        let argv = if $answers.source? != null {
            print "install: an unverified tree from the answers' source"
            [bash ((checkout-from-bundle $answers.source) | path join bootstrap.sh)]
        } else {
            # as `bash -c`, with no file behind it, bootstrap.sh clones the newest master and checks its signature
            [bash -c (open --raw ($LAUNCHER | path join bootstrap.sh)) lsck0-install]
        }
        try { run-logged $unattended $argv; 0 } catch { $env.LAST_EXIT_CODE }
    }
    if $status != 0 {
        print $"install: failed \(exit ($status)\)(if $unattended { $', log in ($LOG)' } else { '' }); run lsck0-install to start over"
    }
}
