#!/usr/bin/env -S nu --no-config-file

const ANSWERS_LABEL = "/dev/disk/by-label/LSCK0"
const ANSWERS_GLOB = "lsck0*.nuon"
const ANSWERS_NONE = "none"
const ANSWERS_WAIT_S = 10
const BOOT_MEDIUM = "/run/archiso/bootmnt"
const CA_BUNDLE = "/etc/ssl/certs/ca-certificates.crt"
const CABLE_POLL = 5sec
const CLONE_DIR = "/tmp/arch-dotfiles"
# dialog exits -1 (255) on an error, like esc: the env moves error and timeout to codes of their own
const DLG_EXIT = {ok: 0, cancel: 1, timeout: 5, error: 6, esc: 255}
const DLG_RETRIES = 3
const CMDLINE_PARAM = '(?:^|\s)lsck0\.(?<key>keymap|wifi\.ssid|wifi\.psk)=(?:"(?<quoted>[^"]*)"|(?<plain>\S*))'
const INSECURE_PARAM = '(?:^|\s)lsck0\.insecure=1(?:\s|$)'
const ISO_GLOB = "archlinux-lsck0*.iso"
const ISO_SEARCH_DEPTH = 2
const IWD_PLAIN_NAME = '^[A-Za-z0-9 _-]+$'
const KEYMAP_DEFAULT = "de-latin1"
const MEDIA_FSTYPES = [vfat exfat iso9660 udf ntfs ntfs3]
const ONLINE_POLL = 1sec
const ONLINE_WAIT = 20sec
const PROBLEM_CHARS_MAX = 60
const PICK_HIDDEN = "hidden"
const PICK_RESCAN = "rescan"
const PICK_SHELL = "shell"
const PROBES = [https://mirror.lsck0.dev https://github.com]
const PROBE_TIMEOUT_S = 5
const SIGNING_KEY = "/usr/share/lsck0/signing-key.asc"
const SOURCE_PATH_KEYS = [bundle lfs]
const STAGE_DIR = "/run/lsck0"
const STAGE_ID_CHARS = 16
const STUB_IN_REPO = "mirror/iso/airootfs/usr/local/bin/lsck0-install"
const TRUST = "/usr/share/lsck0/trust.nuon"
const TUI_BACKTITLE = "Arch Linux install"
const TUI_BOX_ROWS = "8"
const TUI_MENU_ROWS = "12"
const TUI_WIDTH = "72"
const WIFI_SCAN_WAIT = 3sec

const TEXT = {
    keymap: {title: "keyboard", text: "Keyboard layout for the Wi-Fi password (the install asks again):"}
    wifi: {
        title: "Wi-Fi"
        text: "{missing}\n\nPick a network:"
        rescan: "scan again"
        hidden: "a hidden network"
        shell: "a shell, no install"
        name: "Network name:"
        password: "Password for {ssid}, empty if open:"
        eap_method: "Authentication for {ssid}:"
        identity: "Username for {ssid} (user@realm):"
        domain: "Server domain for {ssid} (e.g. example.edu), required:"
        no_domain: "{ssid}: an enterprise network needs a server domain"
        no_creds: "{ssid}: an enterprise network needs a username and password"
        failed: "did not connect"
        draw_failed: "the dialog could not be drawn (terminal too small?): {err}; scanning again"
        draw_stop: "the dialog could not be drawn {count} times: {err}"
    }
    source: {
        title: "unverified source"
        text: "The answer file {origin} brings its own tree (source). It is not signed, replaces the verified master and runs as root.\n\nInstall from it?"
    }
    answers: {
        title: "answer file"
        text: "Install with which answer file?"
        one: "Install with {origin}? (picked in {wait}s)"
        none: "no answer file, every question is asked"
        ignored: "Ignored, not readable:"
        unusable: "No usable answer file, every question is asked."
        draw_failed: "the answer file menu could not be drawn {count} times: {err}"
        missing: "answer file {origin}: source.{key} {path} not found"
    }
    connecting: "install: connecting to {ssid}"
    waiting: "install: {missing}; checking again in {wait}, Ctrl+C for a shell"
    no_link: "no network: plug in a cable or pick a Wi-Fi network"
    no_address: "{devices} is up but has no address yet"
    no_answer: "{host} does not answer over https"
}

def text-fill [text: string, values: record]: nothing -> string {
    $values | transpose name value | reduce --fold $text {|v, acc| $acc | str replace --all $"{($v.name)}" ($v.value | into string) }
}

def is-a [kind: string]: any -> bool {
    ($in | describe) =~ $'^($kind)\b'
}

# lsck0.nuon and lsck0.<name>.nuon, at the medium's root and beside an iso on it
def answers-in [dir: path]: nothing -> list<path> {
    let beside = glob --depth $ISO_SEARCH_DEPTH ($dir | path join "**" $ISO_GLOB) | each { path dirname }
    [$dir] ++ $beside | uniq | each {|d| glob --depth 1 ($d | path join $ANSWERS_GLOB) | sort } | flatten | uniq
}

def answers-text [file: path]: nothing -> string {
    open --raw $file | into binary | decode utf-8
}

# Why an answer file cannot be used, empty when it can: it must parse as a nuon record.
export def answers-check [text: string]: nothing -> string {
    try {
        if ($text | from nuon | is-a record) { "" } else { "not a record" }
    } catch {|e|
        # the innermost error names the fault and its offset into the text
        mut d = $e.details? | default {}
        while ($d.inner? | default [] | is-not-empty) { $d = $d.inner.0 }
        let label = $d.labels? | default [] | get --optional 0
        let at = if $label == null { "" } else {
            let before = try { $text | into binary | bytes at 0..<$label.span.start | decode utf-8 } catch { "" }
            $"line ($before | split row "\n" | length): ($label.text)"
        }
        $"not nuon, ($at | default --empty $e.msg)" | str substring 0..<$PROBLEM_CHARS_MAX
    }
}

export def answers-unattended [text: string]: nothing -> bool {
    (try { $text | from nuon | get --optional unattended } catch { null }) == true
}

# The first file of each real path and each content: the boot medium seen twice, or one file copied to two media, is
# offered once.
export def answers-dedupe [found: list<record>]: nothing -> list<record> {
    $found | reduce --fold [] {|f, acc| if ($acc | any {|k| $k.real == $f.real or $k.hash == $f.hash }) { $acc } else { $acc ++ [$f] } }
}

# How long the menu of several files waits before it takes the first: only when the first is the one file that says
# unattended. Two unattended files (a stick for two machines) always wait for a pick, so a stick booted on the wrong
# machine never erases it with the other machine's answers.
export def answers-menu-timeout [usable: list<record>]: nothing -> duration {
    let unattended = $usable | where { $in.unattended? | default false } | length
    if $unattended == 1 and ($usable | get --optional 0.unattended | default false) { $ANSWERS_WAIT_S * 1sec } else { 0sec }
}

# Where a staged answer file keeps a source file it names: beside it, by its base name.
export def answers-source-staged [answers_dir: path, source_path: string]: nothing -> path {
    $answers_dir | path join ($source_path | path basename)
}

# Where staging puts a picked file and the local source files it names: a dir of its own, named by its content, so
# two files' sources never share one. from is resolved against source_dir, the picked file's dir on its medium.
export def answers-stage-plan [picked: record, stage_root: path, source_dir: path]: nothing -> record {
    let dir = $stage_root | path join ($picked.hash | str substring 0..<$STAGE_ID_CHARS)
    let source = try { $picked.text | from nuon | get --optional source } catch { null }
    let sources = if not ($source | is-a record) { [] } else {
        $SOURCE_PATH_KEYS | each {|k|
            let p = $source | get --optional $k
            if ($p | is-a string) and not ($p =~ '^https?://') {
                let from = if ($p | str starts-with "/") { $p } else { $source_dir | path join $p }
                {key: $k, path: $p, from: $from, to: (answers-source-staged $dir $p)}
            }
        } | compact
    }
    {dir: $dir, copy: ($dir | path join ($picked.rel | path basename)), sources: $sources}
}

# One answer file as found: root is the dir it was found under, device the one mounted there for the scan alone
# (empty when the medium stays mounted), so staging can reach its sources again.
def answers-read [file: path, origin: string, root: path, device: string]: nothing -> record {
    let text = try { answers-text $file } catch { "" }
    {
        origin: $origin, real: ($file | path expand), hash: ($text | hash sha256), text: $text, problem: (answers-check $text)
        unattended: (answers-unattended $text), rel: ($file | path relative-to $root), root: $root, device: $device
    }
}

# Every answer file on the media, the boot medium first, then the LSCK0 label, each once.
def answers-all []: nothing -> list<record> {
    let boot = answers-in $BOOT_MEDIUM | each {|f| answers-read $f $f $BOOT_MEDIUM "" }
    # the boot medium's own device is listed again, mounted at BOOT_MEDIUM
    let devices = ^lsblk -J -l -pno NAME,FSTYPE,MOUNTPOINT | from json | get blockdevices
        | where {|d| $d.fstype in $MEDIA_FSTYPES and $d.mountpoint != $BOOT_MEDIUM }
    let label = if ($ANSWERS_LABEL | path exists) { $ANSWERS_LABEL | path expand } else { "" }
    let media = ($devices | where name == $label) ++ ($devices | where name != $label)
    let found = $media | reduce --fold $boot {|d, acc|
        let mounted = $d.mountpoint | is-not-empty
        let dir = if $mounted { $d.mountpoint } else { $STAGE_DIR | path join mnt ($d.name | path basename) }
        if not $mounted {
            mkdir $dir
            if (^mount -o ro $d.name $dir | complete).exit_code != 0 { return $acc }
        }
        let device = if $mounted { "" } else { $d.name }
        let read = answers-in $dir | each {|f| answers-read $f $"($d.name):($f | path relative-to $dir)" $dir $device }
        if not $mounted { ^umount $dir | complete | ignore }
        $acc ++ $read
    }
    answers-dedupe $found
}

# The picked file and its local sources, copied to a dir of their own: {file, origin}. A source it names that is not
# there stops the install instead of borrowing another file's.
def answers-stage [picked: record]: nothing -> record {
    if $picked.device != "" {
        mkdir $picked.root
        let r = ^mount -o ro $picked.device $picked.root | complete
        if $r.exit_code != 0 { error make {msg: $"answer file ($picked.origin): ($r.stderr | str trim)"} }
    }
    let plan = answers-stage-plan $picked $STAGE_DIR ($picked.root | path join $picked.rel | path dirname)
    let copied = try {
        mkdir $plan.dir
        for s in $plan.sources {
            if not ($s.from | path exists) { error make {msg: (text-fill $TEXT.answers.missing {origin: $picked.origin, key: $s.key, path: $s.path})} }
            cp $s.from $s.to
        }
        ""
    } catch {|e| $e.msg }
    if $picked.device != "" { ^umount $picked.root | complete | ignore }
    if $copied != "" { error make {msg: $copied} }
    $picked.text | save --force $plan.copy
    {file: $plan.copy, origin: $picked.origin}
}

# The menu's footnote naming the files left out, empty when none are.
def answers-ignored-text [broken: list<record>]: nothing -> string {
    if ($broken | is-empty) { return "" }
    $"\n\n($TEXT.answers.ignored)\n" + ($broken | each {|b| $"  ($b.origin): ($b.problem)" } | str join "\n")
}

# The answer file to install with, or null for none. One usable file is a timed yes/no that keeps it, so an unattended
# boot goes on by itself; several are a menu with none as its last entry, timed only when the first says unattended.
# A broken file is named, never offered.
def answers-find []: nothing -> any {
    let found = answers-all
    let usable = $found | where problem == ""
    let broken = $found | where problem != ""
    for b in $broken { print $"install: ignoring ($b.origin): ($b.problem)" }
    let ignored = answers-ignored-text $broken
    let rows = if ($broken | is-empty) { $TUI_BOX_ROWS } else { "0" }
    let width = tui-width
    let wait = $ANSWERS_WAIT_S | into string
    if ($usable | is-empty) {
        if ($broken | is-not-empty) { dlg --title $TEXT.answers.title --timeout $wait --msgbox $"($TEXT.answers.unusable)($ignored)" $rows $width | ignore }
        return null
    }
    if ($usable | length) == 1 {
        let text = text-fill $TEXT.answers.one {origin: $usable.0.origin, wait: $wait}
        let d = dlg --title $TEXT.answers.title --timeout $wait --yes-label "use it" --no-label "none" --yesno $"($text)($ignored)" $rows $width
        # only a no turns it down: the timeout, esc and a box that cannot draw keep it
        return (if $d.kind == cancel { null } else { $usable.0 })
    }
    let items = $usable | enumerate | each {|f| [($f.index | into string) $f.origin] } | flatten
    let timeout = answers-menu-timeout $usable
    let timed = if $timeout > 0sec { [--timeout ($timeout / 1sec | into string)] } else { [] }
    let fallback = if $timeout > 0sec { $usable.0 } else { null }
    mut failures = 0
    loop {
        let menu = dlg --title $TEXT.answers.title ...$timed --menu $"($TEXT.answers.text)($ignored)" "0" $width $TUI_MENU_ROWS ...$items $ANSWERS_NONE $TEXT.answers.none
        match $menu.kind {
            ok => { return (if $menu.out == $ANSWERS_NONE { null } else { $usable | get ($menu.out | into int) }) }
            timeout => { return $usable.0 }
            error => {
                $failures += 1
                # a menu that cannot draw picks what its timeout would: the unattended first file, else none
                if $failures >= $DLG_RETRIES { print $"install: (text-fill $TEXT.answers.draw_failed {count: $failures, err: $menu.err})"; return $fallback }
            }
            # cancel and esc: someone is at the console, so it asks again
            _ => {}
        }
    }
}

# The answer file to install with ({file, origin}, or null for none), or the error that stops the install. A stub
# switched to master's keeps the pick made before the switch; a picked file that does not parse stops here instead of
# giving way to another.
def answers-pick []: nothing -> record {
    let handed = $env.LSCK0_ANSWERS? | default ""
    if ($env.LSCK0_STUB_UPDATED? | is-not-empty) and $handed != "" {
        if $handed == $ANSWERS_NONE { return {found: null, error: ""} }
        let origin = $env.LSCK0_ANSWERS_ORIGIN? | default $handed
        let problem = try { answers-check (answers-text $handed) } catch { "not readable" }
        if $problem != "" { return {found: null, error: $"answer file ($origin): ($problem)"} }
        return {found: {file: $handed, origin: $origin}, error: ""}
    }
    let picked = try { answers-find } catch {|e| print $"install: the media scan failed, no answer file: ($e.msg)"; null }
    if $picked == null { return {found: null, error: ""} }
    try { {found: (answers-stage $picked), error: ""} } catch {|e| {found: null, error: $e.msg} }
}

def answers-early [file: any]: nothing -> record {
    let a = if $file == null { {} } else { try { open --raw $file | from nuon } catch { {} } }
    let a = if ($a | is-a record) { $a } else { {} }
    let wifi = $a.wifi? | default [] | if ($in | is-a list) or ($in | is-a table) { $in } else { [] }
        | where {|w| ($w | is-a record) and ($w.ssid? | is-a string) }
    let params = open --raw /proc/cmdline | parse --regex $CMDLINE_PARAM
        | each {|p| {key: $p.key, value: (if ($p.quoted | is-not-empty) { $p.quoted } else { $p.plain })} }
    let param = {|k| $params | where key == $k | get --optional 0.value }
    let wifi = if (do $param wifi.ssid) == null { $wifi } else { [{ssid: (do $param wifi.ssid), psk: (do $param wifi.psk | default "")}] ++ $wifi }
    let keymap = do $param keymap | default ($a.keymap? | if ($in | is-a string) { $in } else { "" })
    let source = $a.source? | if ($in | is-a record) and ($in.bundle? | is-a string) { $in } else { null }
    let report = $a.report? | if ($in | is-a string) and ($in =~ '^https?://') { $in } else { "" }
    {keymap: $keymap, wifi: $wifi, source: $source, report: $report}
}

def network-missing []: nothing -> string {
    let up = ls /sys/class/net | get name | path basename | where $it != "lo" | where {|i| (open --raw $"/sys/class/net/($i)/operstate" | str trim) == "up" }
    if ($up | is-empty) { return $TEXT.no_link }
    if (^ip -j route show default | from json | is-empty) { return (text-fill $TEXT.no_address {devices: ($up | str join ' ')}) }
    for url in $PROBES {
        let code = ^curl -s -o /dev/null -m $PROBE_TIMEOUT_S -w "%{http_code}" $url | complete | get stdout
        if $code in ["" "000"] { return (text-fill $TEXT.no_answer {host: ($url | url parse | get host)}) }
    }
    ""
}

def network-wait [timeout: duration]: nothing -> string {
    let deadline = (date now) + $timeout
    mut missing = network-missing
    while $missing != "" and (date now) < $deadline {
        sleep $ONLINE_POLL
        $missing = network-missing
    }
    $missing
}

def wifi-device []: nothing -> any {
    ls /sys/class/net | get name | where {|d| $d | path join wireless | path exists } | get --optional 0 | if $in == null { null } else { path basename }
}

def wifi-scan [device: string]: nothing -> table {
    ^iwctl station $device scan | complete | ignore
    sleep $WIFI_SCAN_WAIT
    ^iwctl station $device get-networks | complete | get stdout | ansi strip | lines
    | parse --regex '^\s*>?\s+(?<ssid>\S.*?)\s{2,}(?<security>\S+)\s+(?<signal>\*+)\s*$'
}

# An iwd 802.1X provisioning file at /var/lib/iwd/=<hex ssid>.8021x, so iwctl connects an enterprise network without
# prompting. Server validation is mandatory: EAP-<M>-CACert (the system CA bundle) plus ServerDomainMask, or the
# supplicant would hand credentials to any AP broadcasting the SSID.
def wifi-provision [network: record]: nothing -> nothing {
    let m = ($network.eap | str uppercase)
    # TTLS non-EAP phase2 needs iwd's Tunneled- token (Tunneled-PAP, Tunneled-MSCHAPv2); PEAP's inner is a bare EAP name
    let p2raw = ($network.phase2? | default "mschapv2" | str lowercase)
    let p2 = if $m == "TTLS" {
        match $p2raw { "pap" => "Tunneled-PAP", "chap" => "Tunneled-CHAP", "mschapv2" => "Tunneled-MSCHAPv2", _ => $"Tunneled-($p2raw | str uppercase)" }
    } else { $p2raw | str uppercase }
    # the outer (anonymous) realm must route to the home RADIUS: the identity's realm, not the cert domain
    let realm = if ($network.identity | str contains "@") { $network.identity | split row "@" | last } else { $network.domain }
    let outer = $network.anonymous_identity? | default --empty $"anonymous@($realm)"
    let lines = [
        "[Security]"
        $"EAP-Method=($m)"
        $"EAP-Identity=($outer)"
        # iwd consults no system trust store: without a CA, ServerDomainMask alone validates nothing
        $"EAP-($m)-CACert=($CA_BUNDLE)"
        $"EAP-($m)-ServerDomainMask=($network.domain)"
        $"EAP-($m)-Phase2-Method=($p2)"
        $"EAP-($m)-Phase2-Identity=($network.identity)"
        $"EAP-($m)-Phase2-Password=($network.password)"
        ""
        "[Settings]"
        "AutoConnect=true"
    ]
    let name = if $network.ssid =~ $IWD_PLAIN_NAME { $network.ssid } else {
        $"=($network.ssid | encode hex | str lowercase)"
    }
    let file = $"/var/lib/iwd/($name).8021x"
    # create at 0600 before writing: the file holds the EAP password, so it must never exist with a wider umask
    ^install -m 600 /dev/null $file
    $lines | str join "\n" | $"($in)\n" | save --force $file
}

def wifi-connect [device: string, network: record]: nothing -> string {
    if ($network.eap? | is-not-empty) {
        if ($network.domain? | default "" | is-empty) { return (text-fill $TEXT.wifi.no_domain {ssid: $network.ssid}) }
        # an unattended answer file can omit these; wifi-provision reads them non-optionally
        if ($network.identity? | default "" | is-empty) or ($network.password? | default "" | is-empty) {
            return (text-fill $TEXT.wifi.no_creds {ssid: $network.ssid})
        }
        wifi-provision $network
        let r = ^iwctl station $device connect $network.ssid | complete
        if $r.exit_code != 0 { return $"($network.ssid): ($r.stdout | ansi strip | str trim | default --empty $TEXT.wifi.failed)" }
        return (network-wait $ONLINE_WAIT)
    }
    let verb = if ($network.hidden? | default false) == true { "connect-hidden" } else { "connect" }
    let psk = $network.psk? | default "" | into string
    let secret = if ($psk | is-empty) { [] } else { [--passphrase $psk] }
    let r = ^iwctl ...$secret station $device $verb $network.ssid | complete
    if $r.exit_code != 0 { return $"($network.ssid): ($r.stdout | ansi strip | str trim | default --empty $TEXT.wifi.failed)" }
    network-wait $ONLINE_WAIT
}

# Box width clamped to the terminal so a narrow console (serial, IPMI) still draws; floor 40, cap TUI_WIDTH.
def tui-width []: nothing -> string {
    let cols = try { term size | get columns } catch { 0 }
    if $cols < 1 { return $TUI_WIDTH }
    [([($cols - 4) ($TUI_WIDTH | into int)] | math min) 40] | math max | into string
}

# What a dialog exit means: ok, cancel, esc, timeout or error. An error writes stderr, which marks it on a dialog that
# ignores DIALOG_ERROR; an esc after the whole timeout is the timeout of a dialog that ignores DIALOG_TIMEOUT.
export def dlg-kind [code: int, err: string, timeout: duration, elapsed: duration]: nothing -> string {
    if $code == $DLG_EXIT.ok { return "ok" }
    if ($err | is-not-empty) or $code not-in [$DLG_EXIT.cancel $DLG_EXIT.timeout $DLG_EXIT.esc] { return "error" }
    if $code == $DLG_EXIT.cancel { return "cancel" }
    if $code == $DLG_EXIT.timeout or ($timeout > 0sec and $elapsed >= $timeout) { return "timeout" }
    "esc"
}

# {kind, out, err}, kind from dlg-kind. Callers tell a cancel or esc from an error, so a box that cannot draw is
# retried a bounded number of times instead of being read as the user's answer.
def --wrapped dlg [...args: string]: nothing -> record {
    let at = $args | enumerate | where item == "--timeout" | get --optional 0.index
    let timeout = if $at == null { 0sec } else { ($args | get ($at + 1) | into int) * 1sec }
    let codes = {DIALOG_TIMEOUT: ($DLG_EXIT.timeout | into string), DIALOG_ERROR: ($DLG_EXIT.error | into string)}
    let start = date now
    let r = with-env $codes { ^dialog --backtitle $TUI_BACKTITLE --stdout ...$args | complete }
    let err = $r.stderr | ansi strip | str trim
    {kind: (dlg-kind $r.exit_code $err $timeout ((date now) - $start)), out: ($r.stdout | str trim), err: $err}
}

# only for typing the Wi-Fi password: the install's keyboard menu still asks, preselected with this one, so an Enter
# on the prefilled default does not decide the installed layout
def --env keymap-ensure []: nothing -> nothing {
    if ($env.BOOTSTRAP_KEYMAP? | is-not-empty) or ($env.BOOTSTRAP_KEYMAP_DEFAULT? | is-not-empty) { return }
    let d = dlg --title $TEXT.keymap.title --inputbox $TEXT.keymap.text $TUI_BOX_ROWS (tui-width) $KEYMAP_DEFAULT
    let keymap = if $d.kind == ok and ($d.out | is-not-empty) { $d.out } else { $KEYMAP_DEFAULT }
    if (^loadkeys $keymap | complete).exit_code == 0 { $env.BOOTSTRAP_KEYMAP_DEFAULT = $keymap }
}

def --env network-step [networks: list]: nothing -> bool {
    mut missing = network-wait $ONLINE_WAIT
    let device = wifi-device
    if $missing != "" and $device != null {
        ^rfkill unblock wifi | complete | ignore
        for n in $networks {
            print (text-fill $TEXT.connecting {ssid: $n.ssid})
            $missing = wifi-connect $device $n
            if $missing == "" { break }
            print $"install: ($missing)"
        }
    }
    mut draw_failures = 0
    while $missing != "" {
        if $device == null {
            print (text-fill $TEXT.waiting {missing: $missing, wait: $CABLE_POLL})
            sleep $CABLE_POLL
            $missing = network-missing
            continue
        }
        let width = tui-width
        let found = wifi-scan $device
        let items = $found | each {|n| [$n.ssid $"($n.security) ($n.signal)"] } | flatten
        let extra = [$PICK_RESCAN $TEXT.wifi.rescan $PICK_HIDDEN $TEXT.wifi.hidden $PICK_SHELL $TEXT.wifi.shell]
        let menu = dlg --title $TEXT.wifi.title --menu (text-fill $TEXT.wifi.text {missing: $missing}) "0" $width $TUI_MENU_ROWS ...$items ...$extra
        # a draw failure is no cancel: rescan and draw again, up to DLG_RETRIES times in a row
        if $menu.kind == error {
            $draw_failures += 1
            if $draw_failures >= $DLG_RETRIES { print $"install: (text-fill $TEXT.wifi.draw_stop {count: $draw_failures, err: $menu.err})"; return false }
            print $"install: (text-fill $TEXT.wifi.draw_failed {err: $menu.err})"
            $missing = network-missing
            continue
        }
        $draw_failures = 0
        let pick = $menu.out
        if $menu.kind != ok or $pick == $PICK_SHELL { return false }
        if $pick == $PICK_RESCAN { $missing = network-missing; continue }
        let hidden = $pick == $PICK_HIDDEN
        let name = if $hidden { dlg --title $TEXT.wifi.title --inputbox $TEXT.wifi.name $TUI_BOX_ROWS $width } else { {kind: ok, out: $pick} }
        if $name.kind != ok or ($name.out | is-empty) { continue }
        let ssid = $name.out
        let security = if $hidden { "" } else { $found | where ssid == $ssid | get --optional 0.security | default "" }
        if $security != "open" { keymap-ensure }
        if $security == "8021x" {
            let method = dlg --title $TEXT.wifi.title --menu (text-fill $TEXT.wifi.eap_method {ssid: $ssid}) "0" $width "3" peap "PEAP / MSCHAPv2" ttls-pap "TTLS / PAP" ttls-mschapv2 "TTLS / MSCHAPv2"
            if $method.kind != ok { continue }
            let eap = if $method.out == peap { {eap: peap, phase2: mschapv2} } else if $method.out == "ttls-pap" { {eap: ttls, phase2: pap} } else { {eap: ttls, phase2: mschapv2} }
            let id = dlg --title $TEXT.wifi.title --inputbox (text-fill $TEXT.wifi.identity {ssid: $ssid}) $TUI_BOX_ROWS $width
            if $id.kind != ok or ($id.out | is-empty) { continue }
            let dom = dlg --title $TEXT.wifi.title --inputbox (text-fill $TEXT.wifi.domain {ssid: $ssid}) $TUI_BOX_ROWS $width
            if $dom.kind != ok or ($dom.out | is-empty) { print $"install: (text-fill $TEXT.wifi.no_domain {ssid: $ssid})"; continue }
            let pw = dlg --title $TEXT.wifi.title --insecure --passwordbox (text-fill $TEXT.wifi.password {ssid: $ssid}) $TUI_BOX_ROWS $width
            if $pw.kind != ok { continue }
            $missing = wifi-connect $device {ssid: $ssid, eap: $eap.eap, phase2: $eap.phase2, identity: $id.out, domain: $dom.out, password: $pw.out}
        } else {
            let open = $security == "open"
            let pw = if $open { {kind: ok, out: ""} } else { dlg --title $TEXT.wifi.title --insecure --passwordbox (text-fill $TEXT.wifi.password {ssid: $ssid}) $TUI_BOX_ROWS $width }
            if $pw.kind != ok { continue }
            $missing = wifi-connect $device {ssid: $ssid, psk: $pw.out, hidden: $hidden}
        }
    }
    true
}

def checkout-master []: nothing -> path {
    let trust = open $TRUST
    rm --recursive --force $CLONE_DIR
    ^git clone -q $trust.url $CLONE_DIR
    let gnupg = mktemp --directory
    let r = try {
        ^gpg --homedir $gnupg --batch -q --import $SIGNING_KEY
        with-env {GNUPGHOME: $gnupg} { ^git -C $CLONE_DIR verify-commit --raw HEAD | complete }
    } catch {|e| rm --recursive --force $gnupg; error make {msg: $"signing key: ($e.msg)"} }
    rm --recursive --force $gnupg
    let head = ^git -C $CLONE_DIR rev-parse --short HEAD | str trim
    if not ($r.stderr | lines | any {|l| $l =~ $'^\[GNUPG:\] VALIDSIG .* ($trust.fingerprint)$' }) {
        error make {msg: $"($trust.url) HEAD ($head) is not signed by ($trust.fingerprint)"}
    }
    print $"install: master ($head), signed by ($trust.fingerprint)"
    $CLONE_DIR
}

def source-allowed [origin: string]: nothing -> bool {
    if (open --raw /proc/cmdline) =~ $INSECURE_PARAM { return true }
    if (^systemd-detect-virt --vm --quiet | complete).exit_code == 0 { return true }
    let text = text-fill $TEXT.source.text {origin: $origin}
    (^dialog --backtitle $TUI_BACKTITLE --stdout --defaultno --title $TEXT.source.title --yesno $text "10" (tui-width) | complete).exit_code == 0
}

# The answers' tree over master: its bundle and lfs are urls or the files staged beside the answer file.
def checkout-bundle [repo: path, source: record, answers_dir: path]: nothing -> nothing {
    let local = {|p|
        if $p =~ '^https?://' { let to = $answers_dir | path join (random uuid); ^curl -fsSo $to $p; return $to }
        let staged = answers-source-staged $answers_dir $p
        if not ($staged | path exists) {
            error make {msg: $"answer file source ($p) not found next to the answer file"}
        }
        $staged
    }
    let bundle = do $local $source.bundle
    let ref = ^git bundle list-heads $bundle | lines | first | split row " " | last
    ^git -C $repo fetch -q $bundle $ref
    ^git -C $repo checkout -q FETCH_HEAD
    if ($source.lfs? | is-a string) { ^tar -xf (do $local $source.lfs) -C ($repo | path join .git) }
    print $"install: an unverified tree from the answers' source, (^git -C $repo rev-parse --short HEAD | str trim)"
}

def main [] {
    print "install: looking for an answer file"
    let pick = answers-pick
    if $pick.error != "" { print $"install: ($pick.error); fix it and run lsck0-install to start over"; return }
    let found = $pick.found
    if $found != null { print $"install: answers from ($found.origin)" }
    let early = answers-early $found.file?
    if ($early.keymap | is-not-empty) and (^loadkeys $early.keymap | complete).exit_code == 0 { $env.BOOTSTRAP_KEYMAP = $early.keymap }

    if not (network-step $early.wifi) { print "install: stopped; run lsck0-install to start over"; return }
    print "install: online"
    ^systemctl start pacman-init.service
    let reuse = $env.LSCK0_CHECKOUT? | default ""
    let repo = if ($reuse | is-not-empty) { $reuse } else {
        try {
            let repo = checkout-master
            if $early.source != null {
                if (source-allowed $found.origin) { checkout-bundle $repo $early.source ($found.file | path dirname) } else { print "install: the answers' source is not used, installing the verified master" }
            }
            $repo
        } catch {|e| print $"install: ($e.msg)"; null }
    }
    let newer = if $repo == null { "" } else { $repo | path join $STUB_IN_REPO }
    if ($env.LSCK0_STUB_UPDATED? | is-empty) and ($newer | path exists) and (open --raw $newer) != (open --raw $env.CURRENT_FILE) {
        print "install: master has a newer installer, switching to it"
        let pick = if $found == null { {LSCK0_ANSWERS: $ANSWERS_NONE} } else { {LSCK0_ANSWERS: $found.file, LSCK0_ANSWERS_ORIGIN: $found.origin} }
        with-env ({LSCK0_STUB_UPDATED: "1", LSCK0_CHECKOUT: $repo} | merge $pick) { exec nu --no-config-file $newer }
    }
    # none tells the second stage not to search the media again for the file the user turned down
    let handover = {LSCK0_INSTALL: "1"} | merge (if $found == null { {LSCK0_ANSWERS: $ANSWERS_NONE} } else { {LSCK0_ANSWERS: $found.file, LSCK0_ANSWERS_ORIGIN: $found.origin} })
    let status = if $repo == null { 1 } else {
        with-env $handover { try { ^bash ($repo | path join bootstrap.sh); 0 } catch { $env.LAST_EXIT_CODE } }
    }
    if $status != 0 {
        print $"install: failed \(exit ($status)\); run lsck0-install to start over"
        # the answers' watcher (dot test) gets the log and the verdict instead of reading the screen
        if ($early.report | is-not-empty) {
            ^curl -sT /tmp/lsck0-install.log $"($early.report)/bootstrap.log" | complete | ignore
            ^curl -s $"($early.report)/beacon/bootstrap-fail" | complete | ignore
        }
    }
}
