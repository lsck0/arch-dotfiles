# Maintainer: Luca Sandrock <luca.sandrock@proton.me>
# Reason for custom package: a window share stalls when the shared window resizes (upstream #445, #451; fix from #465),
# and the portal segfaults when it shuts down with a stream attached (upstream #431, no upstream fix)
# Based on Arch's PKGBUILD (Caleb Maclennan); drop once upstream ships a fix

pkgname=xdg-desktop-portal-hyprland
pkgver=1.5.0
_protocolver=044a434ec371f985655389bcef09286b1af3d77c
pkgrel=3
pkgdesc='xdg-desktop-portal backend for hyprland'
url="https://github.com/hyprwm/$pkgname"
arch=(x86_64)
license=(MIT)
provides=(xdg-desktop-portal-impl)
depends=(
    libgcc
    libstdc++
    glibc
    hyprlang libhyprlang.so
    hyprutils libhyprutils.so
    hyprtoolkit
    libinih
    pipewire
    qt6-base
    sdbus-cpp libsdbus-c++.so
    util-linux-libs libuuid.so
    xdg-desktop-portal
)
makedepends=(cmake
    hyprland-protocols
    hyprwayland-scanner
    wayland
    wayland-protocols)
optdepends=('grim: required for the screenshot portal to function'
    'slurp: support for interactive mode for the screenshot portal')
_archive="$pkgname-$pkgver"
source=("$url/archive/v$pkgver/$_archive.tar.gz"
    "https://github.com/hyprwm/hyprland-protocols/archive/$_protocolver.tar.gz"
    0001-screencopy-request-a-new-frame-after-a-failed-one.patch
    0002-screencopy-skip-stream-callbacks-during-teardown.patch)
sha256sums=('8f9eddad706b0bbca2dc24f9894e07969ec5aed163249d6eac3932cfaf38e6a9'
    'da075667ab2aecb271f6cbd49490f14c725f417d7522c49269decf7f14431d3e'
    'a8ec207ba38ff83135c49e1bd8ac08743c46ab084a8830c0f2c4aeb3b53ee7b4'
    '739b3560c6fbc8c530a2a9cd5b1599b98d57429dd9e15500a2a6659bc5cb8bed')

prepare() {
    patch -d "$_archive" -Np1 < "$srcdir/0001-screencopy-request-a-new-frame-after-a-failed-one.patch"
    patch -d "$_archive" -Np1 < "$srcdir/0002-screencopy-skip-stream-callbacks-during-teardown.patch"
    cd "$_archive/subprojects"
    rm -rf hyprland-protocols sdbus-cpp
    ln -sfT "$srcdir/hyprland-protocols-$_protocolver" hyprland-protocols
}

build() {
    cd "$_archive"
    cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBEXECDIR=/usr/lib \
        -D CMAKE_BUILD_TYPE=Release
    cmake --build build
}

package() {
    cd "$_archive"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
