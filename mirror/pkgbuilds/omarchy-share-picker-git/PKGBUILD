# Maintainer: Luca Sandrock <luca.sandrock@proton.me>
# Reason for custom package: upstream's picker drops every floating window from the window list (a8b4009), so a
# floating file manager, Steam dialog or anything floated by hand never shows up to share in Discord or OBS; pinned,
# with that filter removed

pkgname=omarchy-share-picker-git
_pkgname=omarchy-share-picker
pkgver=0.1.0.r12.g7720c58
pkgrel=1
pkgdesc="Share picker for xdg-desktop-portal-hyprland (screen, window, region)"
arch=(x86_64 aarch64)
url="https://github.com/falser101/omarchy-share-picker"
license=(MIT)
depends=(gcc-libs glibc grim hyprland slurp xdg-desktop-portal-hyprland)
makedepends=(cargo git pkgconf wayland)
provides=("$_pkgname")
conflicts=("$_pkgname")
# main, 2026-09-03
_commit=7720c5860e8f6f88b39927ea51434778fa21502f
source=(
    "$_pkgname::git+$url.git#commit=$_commit"
    # lists floating windows too: only hidden, unmapped and tiny ones stay out
    0001-list-floating-windows.patch
)
sha256sums=(
    SKIP
    # written for 7720c58, 2026-11-27
    1bbaaccbe31a5dc0eeabdd564f7690a1b225a1fc34f57b6b5656d8d2922cc301
)

pkgver() {
    cd "$_pkgname"
    printf '0.1.0.r%s.g%s\n' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$_pkgname"
    patch -Np1 < "$srcdir/0001-list-floating-windows.patch"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --bins
}

package() {
    cd "$_pkgname"
    install -Dm755 target/release/omarchy-share-picker "$pkgdir/usr/bin/omarchy-share-picker"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
