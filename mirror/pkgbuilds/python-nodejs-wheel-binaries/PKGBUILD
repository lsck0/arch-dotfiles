# Maintainer: Luca Sandrock <luca.sandrock@proton.me>
# Reason for custom package: use system node

pkgname=python-nodejs-wheel-binaries
pkgver=24.19.0
pkgrel=1
pkgdesc="Python API of the nodejs-wheel binaries, backed by the system node"
arch=(any)
url="https://github.com/njzjz/nodejs-wheel"
license=(MIT)
depends=(python nodejs npm)
_name=nodejs-wheel
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=(8a39a4b57aeb765a6c7b6e30014f46c8cbf22fc322b913b8dd4a70a6f1f042dc)

prepare() {
    cd "$_name-$pkgver"
    # pytubefix imports nodejs_wheel only for ROOT_DIR/bin/node: point it at the system node under /usr
    sed -i 's|^ROOT_DIR = os.path.dirname(__file__)$|ROOT_DIR = "/usr"|' nodejs_wheel/executable.py
    grep -qx 'ROOT_DIR = "/usr"' nodejs_wheel/executable.py
}

package() {
    cd "$_name-$pkgver"
    local site
    site="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
    install -Dm644 -t "$pkgdir$site/nodejs_wheel" nodejs_wheel/{__init__,__main__,executable}.py nodejs_wheel/py.typed
    # the dist-info importlib.metadata and pip check look up for pytubefix's nodejs-wheel-binaries requirement
    local dist="$pkgdir$site/nodejs_wheel_binaries-$pkgver.dist-info"
    install -d "$dist"
    printf 'Metadata-Version: 2.1\nName: nodejs-wheel-binaries\nVersion: %s\n' "$pkgver" > "$dist/METADATA"
    printf 'pacman\n' > "$dist/INSTALLER"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
