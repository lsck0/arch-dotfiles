# Maintainer: Luca Sandrock <luca.sandrock@proton.me>
pkgname=liquid-fixpoint
pkgver=r0
pkgrel=1
pkgdesc="Horn clause constraint solver behind Liquid Haskell and Flux"
arch=(x86_64)
url="https://github.com/ucsd-progsys/liquid-fixpoint"
license=(BSD-3-Clause)
depends=(gmp z3)
makedepends=(git)
options=(!strip)
# arch's stack (2.11) builds no setup shim against the ghc 9.10 cabal: initialBuildSteps is gone
_stackver=3.11.1
source=("git+$url.git"
        "stack-$_stackver::https://github.com/commercialhaskell/stack/releases/download/v$_stackver/stack-$_stackver-linux-x86_64-bin")
sha256sums=(SKIP
            67c66e918801c41ae4d286b1c91f9124f691c1c7d56071b53889cf4a5c667550)

pkgver() {
    cd liquid-fixpoint
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd liquid-fixpoint
    # stack keeps its ghc and package db out of the build user's home
    export STACK_ROOT="$srcdir/stack"
    install -m755 "$srcdir/stack-$_stackver" "$srcdir/stack-bin"
    "$srcdir/stack-bin" --install-ghc build --copy-bins --local-bin-path "$srcdir/bin"
}

package() {
    install -Dm755 "$srcdir/bin/fixpoint" "$pkgdir/usr/bin/fixpoint"
}
