# Maintainer: Luca Sandrock <luca.sandrock@proton.me>
# Reason for custom package: deleted from the AUR

pkgname=feather-wallet-bin
pkgver=2.9.1
pkgrel=1
pkgdesc="A free and open-source Monero desktop wallet"
arch=(x86_64)
url="https://featherwallet.org"
license=(BSD-3-Clause)
provides=(feather-wallet)
conflicts=(featherwallet-bin feather-wallet)
options=(!strip !debug)
source=(
    "feather-$pkgver-linux.zip::https://github.com/feather-wallet/feather/releases/download/$pkgver/feather-$pkgver-linux.zip"
    "feather-$pkgver-linux.zip.asc::https://github.com/feather-wallet/feather/releases/download/$pkgver/feather-$pkgver-linux.zip.asc"
    "feather-$pkgver.tar.gz::https://github.com/feather-wallet/feather/archive/refs/tags/$pkgver.tar.gz"
)
noextract=("feather-$pkgver-linux.zip")
sha256sums=(
    # 2.9.1, released 2026-11-02; zip sha256 matches the signed hashes in the release notes
    f1d40d619664d9e6318c086b9015ee72bc69741ec86148ce2ea2ef75ef47feed
    69493d0aa0e0beb248e84d31c4dd11bc5e692c59ea0f021db8b0eca180a6e5e6
    d9af11efeafa7099f5191051a02eadb9fea676f80e5c786f06d5eb291f38e343
)
# FeatherWallet <dev@featherwallet.org>, also shipped in the source as src/assets/gpg_keys/featherwallet.asc
validpgpkeys=(8185E158A33330C7FD61BC0D1F76E155CEFBA71C)

package() {
    local share="$srcdir/feather-$pkgver/contrib/flatpak/share"

    install -dm755 "$pkgdir/opt/feather"
    bsdtar -xf "$srcdir/feather-$pkgver-linux.zip" -C "$pkgdir/opt/feather"
    mv "$pkgdir/opt/feather/feather-$pkgver" "$pkgdir/opt/feather/feather"
    chmod 0755 "$pkgdir/opt/feather/feather"

    install -dm755 "$pkgdir/usr/bin"
    ln -s /opt/feather/feather "$pkgdir/usr/bin/feather"

    install -Dm644 "$share/applications/org.featherwallet.Feather.desktop" "$pkgdir/usr/share/applications/feather.desktop"
    sed -i 's|Exec=/app/startup|Exec=feather|; s|Icon=org.featherwallet.Feather|Icon=feather|' \
        "$pkgdir/usr/share/applications/feather.desktop"
    install -Dm644 "$share/icons/hicolor/256x256/apps/org.featherwallet.Feather.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/feather.png"
    install -Dm644 "$share/icons/hicolor/128x128/apps/org.featherwallet.Feather.png" \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/feather.png"
    install -Dm644 "$srcdir/feather-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
