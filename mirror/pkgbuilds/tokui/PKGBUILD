# Maintainer: Luca Sandrock <luca.sandrock@proton.me>
# Reason for custom package: not in the AUR; pinned to the v0.12.0 commit, go modules checked by its go.sum

pkgname=tokui
pkgver=0.12.0
pkgrel=1
pkgdesc="Code statistics TUI on top of tokei: lines of code per folder and language"
arch=(x86_64)
url="https://github.com/zdyxry/tokui"
license=(MIT)
depends=(tokei git)
makedepends=(git go)
_commit=e257427cae88a3b4b21378441220b67581663342
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=(SKIP)

build() {
    cd "$pkgname"
    export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
    go build -o "$pkgname" .
}

package() {
    install -Dm755 "$pkgname/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
