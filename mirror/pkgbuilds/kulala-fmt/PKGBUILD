# Maintainer: Luca Sandrock <luca.sandrock@proton.me>
# Reason for custom package: pin last working release

pkgname=kulala-fmt
# the last release with its own tree-sitter grammar: 3.x+ hands parsing to a token-gated kulala-core binary
pkgver=2.11.0
pkgrel=1
# so the downgrade from 4.6.1 wins
epoch=1
pkgdesc="Formatter and converter for Kulala HTTP (.http/.rest) files"
arch=(x86_64)
url="https://github.com/mistweaverco/kulala-fmt"
license=(MIT)
depends=(nodejs)
makedepends=(npm python)
options=(!debug)
source=("$pkgname-$pkgver.tgz::https://registry.npmjs.org/@mistweaverco/kulala-fmt/-/kulala-fmt-$pkgver.tgz")
sha256sums=(081f8e4192cfe46fcdbec66fc447f3e33d5f5fa766a4ce6863fc6848a9e53ed8)

package() {
    # the grammar is a native addon built by its install script, which npm blocks unless allowed
    npm install -g --prefix "$pkgdir/usr" --allow-scripts=@mistweaverco/tree-sitter-kulala,tree-sitter \
        "$srcdir/$pkgname-$pkgver.tgz"

    # standard npm package cleanup: keep only the built addon (the rest of build/ embeds $srcdir paths), normalise perms
    local mod="$pkgdir/usr/lib/node_modules/@mistweaverco/kulala-fmt"
    local grammar="$mod/node_modules/@mistweaverco/tree-sitter-kulala/build"
    find "$grammar" -mindepth 1 -maxdepth 1 ! -name Release -exec rm -rf {} +
    find "$grammar/Release" -mindepth 1 ! -name '*.node' -exec rm -rf {} +
    # tree-sitter itself ships prebuilds for every platform, strip chokes on the foreign ones
    find "$mod/node_modules/tree-sitter/prebuilds" -mindepth 1 -maxdepth 1 ! -name linux-x64 -exec rm -rf {} +
    find "$pkgdir/usr" -type d -exec chmod 755 {} +
    install -Dm644 "$mod/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2> /dev/null || true
}
