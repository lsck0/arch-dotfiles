# Maintainer: Luca Sandrock <luca.sandrock@proton.me>
# Reason for custom package: not in the repos

pkgname=leptosfmt
pkgver=0.1.34
pkgrel=1
pkgdesc="View macro formatter for the Leptos web framework"
arch=(x86_64)
url="https://crates.io/crates/leptosfmt"
license=(MIT Apache-2.0)
depends=(gcc-libs)
makedepends=(cargo)
options=(!lto)
source=("$pkgname-$pkgver.tar.gz::https://static.crates.io/crates/$pkgname/$pkgname-$pkgver.crate")
# 0.1.34, 2026-11-18
sha256sums=(09200ee30dec9a612c5f0345cb5aabf2567d616d4ab05cfcad552dbc03cc0f8f)

prepare() {
    cd "$pkgname-$pkgver"
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$pkgname-$pkgver"
    cargo build --frozen --release
}

package() {
    install -Dm755 "$pkgname-$pkgver/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
}
