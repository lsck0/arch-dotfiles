{
    "core/locale": {
        lang: en_US.UTF-8
        formats: de_DE.UTF-8
        keyboard_layout: de
        keyboard_variant: nodeadkeys
        keyboard_options: ["ctrl:nocaps" "terminate:ctrl_alt_bksp"]
        wifi_country: DE
    }
    "desktop/pipewire": {
        eq_target: alsa_output.usb-Logitech_PRO_X_2_LIGHTSPEED_0000000000000000-00.analog-stereo
        # the board's realtek: nothing in its jacks, its S/PDIF (no jack sense) caught the fallback as "a52 2"
        disabled_cards: [alsa_card.pci-0000_7b_00.6]
    }
    "programming/task": {
        sync_url: "https://tasks.lsck0.dev"
    }
    "base/boot/remote-unlock": {
        ssh_unlock: true
    }
    "creating/obs": {
        vaapi_render_node: "/dev/dri/by-path/pci-0000:03:00.0-render"
        canvas: "3840x2160"
        mic: alsa_input.usb-MV-SILICON_fifine_Microphone_20190808-00.mono-fallback
        monitor_device: alsa_output.usb-Logitech_PRO_X_2_LIGHTSPEED_0000000000000000-00.analog-stereo
        stream_encoder: ffmpeg_vaapi_tex
        record_encoder: av1_ffmpeg_vaapi_tex
    }
    "programming/trmnl-claude": {
        poster: true
    }
    "desktop/hyprland": {
        monitors: [
            {
                output: DP-1
                mode: "3840x2160@144"
                position: "0x0"
                scale: 1.666667
            }
            {
                output: DP-2
                mode: "3840x2160@144"
                position: "2304x0"
                scale: 1.666667
            }
        ]
        main_monitor: DP-2
        workspaces: {
            "1": DP-2
            "2": DP-2
            "3": DP-2
            "4": DP-2
            "5": DP-1
            "6": DP-1
            "7": DP-1
            "8": DP-1
            "9": DP-1
            "10": DP-1
        }
        app_workspaces: [
            {
                class: "^[Ss]potify$"
                workspace: 5
                silent: true
            }
            {
                class: "^discord$"
                workspace: 5
                silent: true
                tabbed: true
            }
            {
                class: "^app.fluxer.FluxerDesktop$"
                workspace: 5
                silent: true
                tabbed: true
            }
            {
                class: "^com.obsproject.Studio$"
                workspace: 7
                silent: false
            }
        ]
        autostart: [
            {
                cmd: discord
            }
            {
                cmd: "gtk-launch spotify"
                after: discord
            }
            {
                cmd: "fluxer --password-store=gnome-libsecret --remote-debugging-port=9234 --autostart"
                after: discord
            }
            {
                cmd: firefox
                workspace: 6
            }
            {
                cmd: "ghostty --gtk-single-instance=false"
                workspace: 1
                float: true
            }
            {
                cmd: "Telegram -startintray"
            }
            {
                cmd: "element-desktop --hidden --password-store=gnome-libsecret"
            }
            {
                cmd: "zapzap --hideStart"
            }
            {
                cmd: "$DOTFILES/configs/gaming/steam/scripts/steam-launch.nu -silent"
            }
        ]
        monitor_speaker_volume: 0
        pointer_sensitivity: 0.1
        natural_scroll: true
    }
    "base/networkmanager": {
        wake_on_lan: true
        untrusted_policy: lockdown-tor
    }
    "base/nftables": {
        pentest_listeners: true
    }
    "base/fail2ban": {
        enable: false
    }
    "base/boot/sata": {
        probe: false
    }
    "creating/v4l2loopback": {
        video_nr: 2
    }
    "base/ssh": {
        wake_host: "192.168.178.138"
    }
    "programming/hermes": {
        system_agent: true
    }
    "programming/cargo": {
        sccache_redis: true
    }
    "programming/claude": {
        remote_control: true
    }
    "llm/vllm": {
        context: 40960
    }
}
