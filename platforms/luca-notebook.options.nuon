{
    "core/locale": {
        lang: en_US.UTF-8
        formats: de_DE.UTF-8
        keyboard_layout: de
        keyboard_variant: nodeadkeys
        keyboard_options: ["ctrl:nocaps" "terminate:ctrl_alt_bksp"]
        wifi_country: DE
    }
    "desktop/pipewire": {
        eq_target: alsa_output.usb-Logitech_PRO_X_2_LIGHTSPEED_0000000000000000-00.analog-stereo
    }
    "programming/task": {
        sync_url: "https://tasks.lsck0.dev"
        recurrence: false
    }
    "base/boot/hardening": {
        allow_smt: true
    }
    "base/boot/remote-unlock": {
        ssh_unlock: true
        wifi: true
    }
    "creating/obs": {
        vaapi_render_node: "/dev/dri/by-path/pci-0000:00:02.0-render"
    }
    "desktop/hyprland": {
        monitors: [
            {
                output: eDP-1
                mode: "1920x1080"
                position: auto
                scale: 1.0
            }
        ]
        pointer_sensitivity: 0.1
        natural_scroll: true
    }
    "base/networkmanager": {
        untrusted_policy: lockdown-tor
        homelab_dns: "192.168.178.29"
        homelab_domain: lsck0.dev
        homelab_subnets: ["10.100.0.0/16" "10.200.0.0/16"]
    }
    "base/ghostmirror": {
        homelab_mirror: "http://10.100.0.100:8090/archlinux/$repo/os/$arch"
    }
    "base/pam": {
        fido_origin: "pam://lsck0"
    }
    "base/ssh": {
        homelab_hosts: ["10.100.0.*" "10.200.0.*" "192.168.178.29" "192.168.178.200"]
        wake_router: "192.168.178.29"
        wake_host: "192.168.178.138"
    }
    "base/v4l2loopback": {
        video_nr: 2
    }
    "core/syncthing": {
        nas_address: "tcp://10.100.0.100:22000"
    }
}
