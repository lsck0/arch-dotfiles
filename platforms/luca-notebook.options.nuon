{
    "core/locale": {
        lang: en_US.UTF-8
        formats: de_DE.UTF-8
        keyboard_layout: de
        keyboard_variant: nodeadkeys
        keyboard_options: ["ctrl:nocaps" "terminate:ctrl_alt_bksp"]
        wifi_country: DE
    }
    "desktop/pipewire": {
        eq_target: alsa_output.usb-Logitech_PRO_X_2_LIGHTSPEED_0000000000000000-00.analog-stereo
    }
    "programming/task": {
        sync_url: "https://tasks.lsck0.dev"
        recurrence: false
    }
    "base/systemd": {
        # S3 (deep) hung on the first resume after the 2026-11 reinstall (X1 Carbon 6th, kernel 7.2.14)
        mem_sleep: s2idle
    }
    "base/boot/hardening": {
        allow_smt: true
        relax_mitigations: true
    }
    "base/boot/remote-unlock": {
        ssh_unlock: true
        wifi: true
    }
    "creating/obs": {
        vaapi_render_node: "/dev/dri/by-path/pci-0000:00:02.0-render"
    }
    "desktop/hyprland": {
        # quickshell 0.3.2 dies on Hyprland 0.57.1's session lock (2026-11-09): hyprlock until it is fixed
        lock_screen: hyprlock
        monitors: [
            {
                output: eDP-1
                mode: "1920x1080"
                position: auto
                scale: 1.0
            }
        ]
        pointer_sensitivity: 0.1
        natural_scroll: true
    }
    "base/networkmanager": {
        untrusted_policy: lockdown-tor
    }
    "base/pam": {
        fido_origin: "pam://lsck0"
    }
    "base/ssh": {
        wake_host: "192.168.178.138"
        wake_router_tunnel: "10.0.0.1"
    }
    "base/v4l2loopback": {
        video_nr: 2
    }
}
