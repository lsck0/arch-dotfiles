# laptop; bootstrap.sh offers it, every driver reads it when the hostname matches
{
    hostname: luca-notebook
    form_factor: laptop
    groups: [base core fonts desktop socials creating latex programming pentesting]
    # the synaptics 06cb:009a fingerprint reader; without vulkan-intel mpv's vo=gpu-next finds no device and crashes;
    # the last four are for remote unlock (configs/base/boot/remote-unlock)
    extra_packages: [python-validity-git vulkan-intel mkinitcpio-systemd-tool tinyssh tinyssh-convert busybox]
    facts: {
        homelab: true
        wireguard: wg0.laptop.conf
        secure_boot_own_keys: true
    }
}
