# desktop; bootstrap.sh offers it, every driver reads it when the hostname matches
{
    hostname: luca-pc
    form_factor: desktop
    groups: [base core fonts desktop socials gaming creating latex programming qemu llm rocm pentesting]
    # it87 for the x870e fan headers, amdgpu_top for the rx 7800 xt, vulkan-radeon for gpu-next without steam pulling
    # it in; the last four are for remote unlock (configs/base/boot/remote-unlock)
    extra_packages: [it87-dkms-git amdgpu_top vulkan-radeon mkinitcpio-systemd-tool tinyssh tinyssh-convert busybox]
    facts: {
        # the homelab: pacman mirror line, nas mount, home gateways and routes, searxng in the firefox policy
        homelab: true
        wireguard: wg0.pc.conf
        # sbctl enrolls own secure boot keys and the event log's option rom hashes, no microsoft ca
        secure_boot_own_keys: true
    }
}
