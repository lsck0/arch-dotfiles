[Desktop Entry]
Type=Application
Name=Capgemini
Comment=ARC portal, Teams and Outlook in the isolated work browser profile
Exec=@HOME@/.local/bin/capgemini
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
Actions=arc;teams;outlook;marcoms;

[Desktop Action arc]
Name=ARC
Exec=@HOME@/.local/bin/capgemini https://arc.capgemini.com/

[Desktop Action teams]
Name=Teams
Exec=@HOME@/.local/bin/capgemini https://teams.cloud.microsoft/

[Desktop Action outlook]
Name=Outlook
Exec=@HOME@/.local/bin/capgemini https://outlook.cloud.microsoft/mail/

[Desktop Action marcoms]
Name=MarComs
Exec=@HOME@/.local/bin/capgemini https://marcoms.capgemini.com/
