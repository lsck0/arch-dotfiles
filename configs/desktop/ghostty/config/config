config-file=?@CACHE@/wal/ghostty.conf
config-file=?@CONFIG@/dotfiles/ghostty-style.conf
config-file=?@CACHE@/ghostty-powersave.conf
config-file=?@CONFIG@/dotfiles/ghostty-env.conf
config-file=?@CONFIG@/dotfiles/ghostty-font.conf

app-notifications = false
confirm-close-surface = false
quit-after-last-window-closed = false

background-opacity-cells = false
# ghostty asks the compositor for its blur itself (ext-background-effect-v1); left off, Hyprland blurs every
# translucent window but this one
background-blur = true

cursor-style = @CURSOR_STYLE@
cursor-style-blink = @CURSOR_BLINK@
mouse-hide-while-typing = true

window-width = @WINDOW_COLUMNS@
window-height = @WINDOW_ROWS@

mouse-scroll-multiplier = precision:@SCROLL_MULTIPLIER@,discrete:@SCROLL_MULTIPLIER@

window-padding-y = 0,0
window-padding-balance = true

keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+t=unbind

clipboard-write = allow
clipboard-read = allow

# hosts without the xterm-ghostty terminfo (the NixOS homelab guests) break interactive tools; ssh gets xterm-256color
shell-integration-features = ssh-env
