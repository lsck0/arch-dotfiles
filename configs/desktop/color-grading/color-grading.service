[Unit]
Description=Color grading in the display CTM and gamma LUT
Documentation=file:%h/projects/arch-dotfiles/configs/desktop/color-grading/color-grading.py
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# wlr-gamma-control is hyprland-only; a plasma fallback login must not start it
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
Type=simple
ExecStart=%h/projects/arch-dotfiles/configs/desktop/color-grading/color-grading.py run
# color-grading.py set rewrites the state files, the daemon rereads them
ExecReload=kill -HUP $MAINPID
# the compositor drops the LUT with the connection, a restart regrades from scratch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
