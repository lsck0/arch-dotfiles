use module.nu *
use ../../core/wallust/palette.nu [RADIUS_PX OPACITY_BAR]
use ../../core/wallust/font.nu [font-load]

export const meta = {
    deps: [desktop/qutebrowser]
    packages: {pacman: [espeak-ng firefox plasma-browser-integration python-pywalfox speech-dispatcher]}
    inputs: ["~/.config/mozilla/firefox/profiles.ini"]
}

const HOME_DIR = ".config/mozilla/firefox"
const FIREFOX_DIR = "/usr/lib/firefox"
const POLICIES = "/etc/firefox/policies/policies.json"
const PYWALFOX_HOST = ".mozilla/native-messaging-hosts/pywalfox.json"
# the headless run is ended on purpose; profiles.ini is its result
const HEADLESS_TIMEOUT = "20"
const SEARCH_OFF_HOMELAB = {
    Add: [{Name: DuckDuckGo, URLTemplate: "https://duckduckgo.com/?q={searchTerms}", Method: GET, Alias: ddg}]
    Default: DuckDuckGo
}

def profiles [ini: path]: nothing -> list<path> {
    open --raw $ini | lines | parse "Path={path}" | get path | each {|p| $ini | path dirname | path join $p } | where ($it | path exists)
}

def chrome-style []: nothing -> string {
    $":root {\n    --rtk-radius: ($RADIUS_PX)px;\n    --appshell-opacity: ($OPACITY_BAR * 100 | math round)%;\n}\n"
}

# pywalfox install's manifest, pointed at pywalfox-host.sh instead of the package's main.sh
def pywalfox-host []: nothing -> list<record> {
    let main = glob /usr/lib/python3*/site-packages/pywalfox/bin/main.sh | sort | last
    if $main == null { return [] }
    let host = xdg data dotfiles pywalfox-host
    let manifest = {
        name: pywalfox, description: "Automatically theme your browser using the colors generated by Pywal"
        path: $host, type: stdio, allowed_extensions: [pywalfox@frewacom.org]
    }
    [
        (file-render pywalfox-host.sh $host {MAIN: $main} --mode 755)
        (file-text ($nu.home-dir | path join $PYWALFOX_HOST) $"($manifest | to json --indent 2)\n")
    ]
}

export def link [cfg: record] {
    let root = $nu.home-dir | path join $HOME_DIR
    let ini = $root | path join profiles.ini
    if not ($ini | path exists) {
        return [(step profile-create)]
    }
    let pywalfox = pywalfox-host
    let speech = if (which speech-dispatcher | is-empty) { [] } else {
        [
            (unit-enable speech-dispatcher.socket --now)
            (file-text (xdg config speech-dispatcher speechd.conf)
                "AddModule \"espeak-ng\" \"sd_espeak-ng\" \"espeak-ng.conf\"\nDefaultModule espeak-ng\n")
            (dropin speech-dispatcher.service speech-dispatcher-timeout.conf --then [systemctl --user daemon-reload])
        ]
    }
    # pywalfox looks in ~/.config/firefox
    [(file-link $root (xdg config firefox))]
    | append (profiles $ini | each {|dir|
        [
            (file-copy userChrome.css ($dir | path join chrome userChrome.css))
            (file-text ($dir | path join chrome dotfiles-style.css) (chrome-style) --generated)
            (file-render user.js ($dir | path join user.js) {HOME: $nu.home-dir})
        ]
    } | flatten)
    | append $pywalfox
    | append $speech
    | append (user-hook firefox-profiles hook/profile-link.nu --watch [$"%h/($HOME_DIR)/profiles.ini"])
}

export def profile-create [] {
    # the force-installed plasma extension starts its native host, a Qt app that aborts without a display
    with-env {QT_QPA_PLATFORM: offscreen} {
        ^timeout $HEADLESS_TIMEOUT firefox --headless about:blank | complete | ignore
    }
}

# The chrome's font, imported by userChrome.css; firefox reads it at its next start.
def chrome-font []: nothing -> string {
    let font = font-load
    $":root {\n    --rtk-chrome-font: \"($font.family)\", \"JetBrainsMono Nerd Font\", monospace, sans-serif;\n    --rtk-chrome-font-size: ($font.ui_size)pt;\n}\n"
}

export def theme [cfg: record, wallpaper: string] {
    let ini = $nu.home-dir | path join $HOME_DIR profiles.ini
    let fonts = if ($ini | path exists) {
        profiles $ini | each {|dir| file-text ($dir | path join chrome dotfiles-font.css) (chrome-font) --generated }
    } else { [] }
    let socket = $env.TMPDIR? | default /tmp | path join $"pywalfox_socket_(^id -u | str trim)"
    if (which pywalfox | is-empty) or not ($socket | path exists) { return $fonts }
    $fonts | append (exec pywalfox-update [pywalfox update])
}

export def system [cfg: record] {
    let policies = if (platform-has homelab) {
        file-copy policies.json $POLICIES
    } else {
        file-text $POLICIES $"(open policies.json | upsert policies.SearchEngines $SEARCH_OFF_HOMELAB | to json --indent 2)\n"
    }
    # the new tab url is settable only from autoconfig in the install dir; mozilla.cfg reads each user's home at runtime
    let autoconfig = if ($FIREFOX_DIR | path exists) {
        [
            (file-copy autoconfig.js ($FIREFOX_DIR | path join defaults pref autoconfig.js))
            (file-copy mozilla.cfg ($FIREFOX_DIR | path join mozilla.cfg))
        ]
    } else { [] }
    [$policies] | append $autoconfig
}
