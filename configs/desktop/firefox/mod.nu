use module.nu *
use ../../core/wallust/palette.nu [RADIUS_PX OPACITY_BAR TEXT_RATIO ACCENT2_RATIO hex-to-rgb rgb-to-hex is-light passes quantize readable-on wal-colors-file]
use ../../core/wallust/font.nu [font-load]

export const meta = {
    deps: [desktop/qutebrowser]
    packages: {pacman: [espeak-ng firefox plasma-browser-integration python-pywalfox speech-dispatcher]}
    inputs: [
        "~/.config/mozilla/firefox/profiles.ini"
        "~/.local/share/torbrowser/tbb/x86_64/tor-browser/Browser/TorBrowser/Data/Browser/profiles.ini"
    ]
}

const HOME_DIR = ".config/mozilla/firefox"
# torbrowser-launcher's install; the same firefox, themed by the same userChrome.css
const TOR_INI = ".local/share/torbrowser/tbb/x86_64/tor-browser/Browser/TorBrowser/Data/Browser/profiles.ini"
const FIREFOX_DIR = "/usr/lib/firefox"
const POLICIES = "/etc/firefox/policies/policies.json"
# a secrets module's firefox-policies.json (the owner's work sso sites), merged in where the root copy holds the
# secrets group; found by name, so the public tree names no module
const SECRETS_DIR = path self ../../secrets
const PYWALFOX_HOST = ".mozilla/native-messaging-hosts/pywalfox.json"
# the headless run is ended on purpose; profiles.ini is its result
export const HEADLESS_TIMEOUT = "20"
const SEARCH_OFF_HOMELAB = {
    Add: [{Name: DuckDuckGo, URLTemplate: "https://duckduckgo.com/?q={searchTerms}", Method: GET, Alias: ddg}]
    Default: DuckDuckGo
}

# The profile dirs a firefox or thunderbird profiles.ini lists; none before the app's first start.
export def mozilla-profiles [ini: path]: nothing -> list<path> {
    if not ($ini | path exists) { return [] }
    open --raw $ini | lines | parse "Path={path}" | get path | each {|p| $ini | path dirname | path join $p } | where ($it | path exists)
}

def tor-profiles []: nothing -> list<path> {
    mozilla-profiles ($nu.home-dir | path join $TOR_INI)
}

def chrome-style []: nothing -> string {
    $":root {\n    --rtk-radius: ($RADIUS_PX)px;\n    --appshell-opacity: ($OPACITY_BAR * 100 | math round)%;\n}\n"
}

# pywalfox install's manifest, pointed at pywalfox-host.sh instead of the package's main.sh
def pywalfox-host []: nothing -> list<record> {
    let main = glob /usr/lib/python3*/site-packages/pywalfox/bin/main.sh | sort | last
    if $main == null { return [] }
    let host = xdg data dotfiles pywalfox-host
    let manifest = {
        name: pywalfox, description: "Automatically theme your browser using the colors generated by Pywal"
        path: $host, type: stdio, allowed_extensions: [pywalfox@frewacom.org]
    }
    [
        (file-render pywalfox-host.sh $host {MAIN: $main, CACHE: (xdg cache wal pywalfox)} --mode 755)
        (file-text ($nu.home-dir | path join $PYWALFOX_HOST) $"($manifest | to json --indent 2)\n")
    ]
}

export def link [cfg: record] {
    let root = $nu.home-dir | path join $HOME_DIR
    let ini = $root | path join profiles.ini
    if not ($ini | path exists) {
        return [(step profile-create)]
    }
    [
        # pywalfox looks in ~/.config/firefox
        (file-link $root (xdg config firefox))
        (mozilla-profiles $ini | each {|dir|
            [
                (file-copy userChrome.css ($dir | path join chrome userChrome.css))
                (file-text ($dir | path join chrome dotfiles-style.css) (chrome-style) --generated)
                (file-render user.js ($dir | path join user.js) {HOME: $nu.home-dir})
            ]
        })
        (tor-profiles | each {|dir|
            # no pywalfox in tor browser (an extension marks its users): dotfiles-colors.css stands in for its theme
            let chrome = "@import url('dotfiles-colors.css');\n" + (open --raw userChrome.css)
            [
                (file-text ($dir | path join chrome userChrome.css) $chrome)
                (file-text ($dir | path join chrome dotfiles-style.css) (chrome-style) --generated)
                (file-copy user-tor.js ($dir | path join user.js))
            ]
        })
        (pywalfox-host)
        (if (which speech-dispatcher | is-not-empty) {
            [
                (unit-enable speech-dispatcher.socket --now)
                (file-text (xdg config speech-dispatcher speechd.conf)
                    "AddModule \"espeak-ng\" \"sd_espeak-ng\" \"espeak-ng.conf\"\nDefaultModule espeak-ng\n")
                (dropin speech-dispatcher.service speech-dispatcher-timeout.conf --then [systemctl --user daemon-reload])
            ]
        })
        (user-hook firefox-profiles hook/profile-link.nu --watch [$"%h/($HOME_DIR)/profiles.ini"])
    ]
}

export def profile-create [] {
    # the force-installed plasma extension starts its native host, a Qt app that aborts without a display
    with-env {QT_QPA_PLATFORM: offscreen} {
        ^timeout $HEADLESS_TIMEOUT firefox --headless about:blank | complete | ignore
    }
}

# The chrome's font, imported by userChrome.css; firefox and thunderbird read it at their next start.
export def mozilla-chrome-font []: nothing -> string {
    let font = font-load
    $":root {\n    --rtk-chrome-font: \"($font.family)\", \"JetBrainsMono Nerd Font\", monospace, sans-serif;\n    --rtk-chrome-font-size: ($font.ui_size)pt;\n}\n"
}

# pywalfox derives its chrome from fixed slots and multiplies (`v + v * f` per channel, clamped): dark takes color0 as
# the frame, color0 x2.25 for the toolbar and popups, x2.85 for the url bar, color15 as text, color10 as the highlight;
# light takes white for the toolbar, popups and url bar, color7 x1.1 held in 205..220 as the frame, color0 x2.25 as text
# and color3 as the highlight under white text. A theme's slots read none of that way (catppuccin's color0 is a surface,
# so its popups came out pale lavender under pale text, and every light theme's text came out white), so these slots
# are solved backwards from the theme's background, foreground and accents until each surface holds its contrast.
export const PYWALFOX_POPUP = 1.25
export const PYWALFOX_FIELD = 1.85
export const PYWALFOX_FRAME_LIGHT = [0.1 205 220]
const PYWALFOX_SCALE_STEP = 0.95
const PYWALFOX_SCALE_COUNT_MAX = 60

# pywalfox's brighten: each channel v + v * f, clamped to lo..hi out of 255.
export def pywalfox-brighten [f: float, lo: int = 0, hi: int = 255]: list<float> -> list<float> {
    $in | each {|v| ([($v * 255 * (1 + $f)) $lo] | math max | [$in $hi] | math min | math round) / 255 }
}

# The slots pywalfox reads, as hex, from a palette's background, foreground and two accents.
export def pywalfox-slots [bg: string, fg: string, accent: string, accent2: string]: nothing -> record {
    let bg = $bg | hex-to-rgb
    let fg = $fg | hex-to-rgb
    let white = [1.0 1.0 1.0]
    if ($bg | is-light) {
        # the frame is the darker of the text's two grounds, white the other
        let frame = $bg | pywalfox-brighten $PYWALFOX_FRAME_LIGHT.0 $PYWALFOX_FRAME_LIGHT.1 $PYWALFOX_FRAME_LIGHT.2
        let text = $fg | readable-on $frame
        # color0 x2.25 is the text; color0 itself, darker still, is the focused text
        let c0 = $text | each { $in / (1 + $PYWALFOX_POPUP) }
        {
            color0: ($c0 | rgb-to-hex --prefix "#"), color7: ($bg | rgb-to-hex --prefix "#")
            color3: ($accent | hex-to-rgb | readable-on $white --ratio $ACCENT2_RATIO | rgb-to-hex --prefix "#")
            color5: ($accent2 | hex-to-rgb | readable-on $white --ratio $ACCENT2_RATIO | rgb-to-hex --prefix "#")
        }
    } else {
        # darkened until the url bar, the brightest surface, still carries the text
        mut frame = $bg | quantize
        for _ in 1..$PYWALFOX_SCALE_COUNT_MAX {
            if (passes $fg ($frame | pywalfox-brighten $PYWALFOX_FIELD) $TEXT_RATIO) { break }
            $frame = $frame | each { $in * $PYWALFOX_SCALE_STEP } | quantize
        }
        let field = $frame | pywalfox-brighten $PYWALFOX_FIELD
        {
            color0: ($frame | rgb-to-hex --prefix "#"), color15: ($fg | readable-on $field | rgb-to-hex --prefix "#")
            color10: ($accent | hex-to-rgb | readable-on $frame --ratio $ACCENT2_RATIO | rgb-to-hex --prefix "#")
            color13: ($accent2 | hex-to-rgb | readable-on $frame --ratio $ACCENT2_RATIO | rgb-to-hex --prefix "#")
        }
    }
}

def pywalfox-colors []: nothing -> string {
    let colors = open (wal-colors-file)
    let slots = pywalfox-slots $colors.special.background $colors.special.foreground $colors.colors.color4 $colors.colors.color5
    $"($colors | upsert colors ($colors.colors | merge $slots) | to json --indent 2)\n"
}

# pywalfox's default dark and light templates as chrome variables, for a profile without the extension.
def chrome-colors [p: any]: nothing -> string {
    if $p == null { return "" }
    let s = if $p.light == "1" {
        {
            bg: $"color-mix\(in srgb, ($p.c7) 15%, #d4d4d4\)", light: "#ffffff", extra: $p.c7
            accent: $p.c3, accent2: $p.c5, text: $"color-mix\(in srgb, ($p.c0), white 20%\)", focus: $p.c0
        }
    } else {
        {
            bg: $p.bg, light: $"color-mix\(in srgb, ($p.bg), white 6%\)"
            extra: $"color-mix\(in srgb, ($p.bg), white 18%\)"
            accent: $p.c10, accent2: $p.c13, text: $p.c15, focus: "#ffffff"
        }
    }
    let vars = {
        lwt-accent-color: $s.bg, lwt-accent-color-inactive: $s.bg, lwt-text-color: $s.text
        toolbar-bgcolor: $s.light, toolbar-color: $s.focus
        toolbar-field-background-color: $s.extra, toolbar-field-color: $s.text
        toolbar-field-focus-background-color: $s.extra, toolbar-field-focus-color: $s.focus
        toolbar-field-border-color: $s.light, toolbar-field-focus-border-color: $s.light
        tab-selected-bgcolor: $s.light, tab-selected-textcolor: $s.focus, tab-loading-fill: $s.accent
        toolbarbutton-icon-fill: $s.accent, toolbarbutton-icon-fill-attention: $s.accent2
        lwt-tab-line-color: $s.light, lwt-toolbar-field-highlight: $s.accent, lwt-toolbar-field-highlight-text: $s.bg
        arrowpanel-background: $s.light, arrowpanel-color: $s.text, arrowpanel-border-color: $s.light
        sidebar-background-color: $s.light, sidebar-text-color: $s.text
    }
    let lines = $vars | items {|k, v| $"    --($k): ($v) !important;" } | str join "\n"
    $":root {\n($lines)\n}\n"
}

export def theme [cfg: record, wallpaper: string] {
    let font = mozilla-chrome-font
    let palette = palette-load
    let colors = chrome-colors $palette
    let files = [
        (mozilla-profiles ($nu.home-dir | path join $HOME_DIR profiles.ini)
            | each {|dir| file-text ($dir | path join chrome dotfiles-font.css) $font --generated })
        (tor-profiles | each {|dir|
            [
                (file-text ($dir | path join chrome dotfiles-font.css) $font --generated)
                (file-text ($dir | path join chrome dotfiles-colors.css) $colors --generated)
            ]
        })
        (if $palette != null { file-text (xdg cache wal pywalfox wal colors.json) (pywalfox-colors) --generated })
    ]
    let socket = $env.TMPDIR? | default /tmp | path join $"pywalfox_socket_(^id -u | str trim)"
    if (which pywalfox | is-empty) or not ($socket | path exists) { return $files }
    # the extension keeps its own dark/light mode apart from the colors: left on light, a dark palette paints a light
    # toolbar; set from the palette each switch
    let mode = if $palette != null and $palette.light == "1" { "light" } else { "dark" }
    $files | append (exec pywalfox-update [sh -c 'pywalfox "$0" && pywalfox update' $mode])
}

export def system [cfg: record] {
    let extra = glob ($SECRETS_DIR | path join * firefox-policies.json) | sort | each { open $in }
    let doc = $extra | reduce --fold (open policies.json) {|it, acc| $acc | merge deep --strategy append $it }
    let doc = if (platform-has homelab) { $doc } else { $doc | upsert policies.SearchEngines $SEARCH_OFF_HOMELAB }
    [
        (file-text $POLICIES $"($doc | to json --indent 2)\n")
        # the new tab url is settable only from autoconfig in the install dir; mozilla.cfg reads each user's home at runtime
        (if ($FIREFOX_DIR | path exists) {
            [
                (file-copy autoconfig.js ($FIREFOX_DIR | path join defaults pref autoconfig.js))
                (file-copy mozilla.cfg ($FIREFOX_DIR | path join mozilla.cfg))
            ]
        })
    ]
}
