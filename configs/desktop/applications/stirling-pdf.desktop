[Desktop Entry]
Type=Application
Name=Stirling PDF
Comment=Local PDF toolbox in the browser
TryExec=stirling-pdf
Exec=@HOME@/.local/bin/desktop-run --cd @HOME@/.local/share/stirling-pdf --open http://localhost:8080 -- stirling-pdf
Icon=application-pdf
Terminal=true
Categories=Office;Graphics;ConsoleOnly;
