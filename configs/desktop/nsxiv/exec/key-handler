#!/usr/bin/env -S nu --no-config-file --stdin
# nsxiv's key handler: the key, then the marked or current files one per line on stdin

def main [key: string]: string -> nothing {
    let files = $in | lines | where $it != ""
    match $key {
        "d" => { $files | each {|f| ^trash $f } | ignore }
        "w" => { ^($nu.home-dir | path join .local bin dot) theme ($files | first | path expand) }
        _ => {}
    }
}
