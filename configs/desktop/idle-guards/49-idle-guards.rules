// the guards' sleep inhibitors hold back only hypridle, whose suspend listeners check BlockInhibited themselves;
// a suspend asked for at the machine (the power menu) goes through them, unprompted
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.login1.suspend-ignore-inhibit" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
