// the guards' sleep inhibitors hold back only hypridle, whose suspend listeners check BlockInhibited themselves;
// a suspend asked for at the machine (the power menu) goes through them after a key touch, so no other process of the
// session can suspend past a running recording or download unasked. asked every time: polkit keeps an approval for
// the asking process alone, and each systemctl suspend is a new one
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.login1.suspend-ignore-inhibit" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.AUTH_ADMIN;
    }
});
