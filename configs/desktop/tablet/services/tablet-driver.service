[Unit]
Description=Userspace driver for the SZ PENG YI [T1161] graphics tablet
Documentation=file:/var/lib/dotfiles/repo/configs/desktop/tablet/scripts/tablet-driver.py

[Service]
Type=simple
ExecStart=/usr/local/bin/tablet-driver
Restart=on-failure
RestartSec=2

StateDirectory=tablet-driver

DeviceAllow=/dev/uinput rw
DeviceAllow=char-hidraw rw
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
# root owns the nodes it opens, so no capability is needed
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
