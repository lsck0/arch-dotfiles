use module.nu *

export const meta = {
    packages: {pacman: [headsetcontrol pipewire pipewire-alsa pipewire-pulse qpwgraph rtkit wiremix wireplumber]}
}

export const options = {
    app_loopbacks: {
        type: bool
        default: true
        doc: "Every app plays through a loopback of its own that carries its system volume, so a capture of the app (obs) stays at full level"
        label: "Per-app loopbacks"
        group: audio
        scope: user
    }
    eq_target: {
        type: string?
        default: null
        doc: "The node.name of the headset sink the eq attaches to as a smart filter; unset, no eq chain"
        label: "EQ headset"
        group: audio
        scope: user
    }
    eq_preset: {
        type: string
        default: "pro-x-2.txt"
        doc: "AutoEq ParametricEQ preset for that headset, a file in this module or an absolute path"
        label: "EQ preset"
        group: audio
        scope: user
    }
}

const CONF_DIR = ".config/pipewire"
const PRESET_FILE = "eq-preset.txt"
const SCRIPT_DIR = ".local/share/wireplumber/scripts"
const LOOPBACK_SCRIPT = "app-loopback.lua"
const LOOPBACK_UNIT = "app-loopback.service"
const EQ_UNIT = "pipewire-chain@eq.service"

# The eq as its own pipewire client: a filter-chain conf for pipewire-chain@eq.service.
def eq-render [preset: path, target: string]: nothing -> string {
    $"# generated by configs/desktop/pipewire/mod.nu, edit there
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt args = { } flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-parametric-equalizer
        args = {
            equalizer.filepath = \"($preset)\"
            equalizer.description = \"EQ\"
            audio.channels = 2
            audio.position = [ FL FR ]
            capture.props = {
                node.name = \"eq\"
                media.class = Audio/Sink
                filter.smart = true
                filter.smart.name = \"eq\"
                filter.smart.target = { node.name = \"($target)\" }
            }
            playback.props = { node.name = \"eq.out\" node.passive = true }
        }
    }
]
"
}

def eq-link [cfg: record]: nothing -> list<record> {
    let conf = $nu.home-dir | path join $CONF_DIR
    let preset = $conf | path join $PRESET_FILE
    # the chain reads the preset only at start, and its own conf does not change with the preset
    let restart = [systemctl --user try-restart $EQ_UNIT]
    [
        (unit-file pipewire-chain@.service)
        (file-copy $cfg.eq_preset $preset --then $restart)
        (file-text ($conf | path join eq.conf) (eq-render $preset $cfg.eq_target) --generated --then $restart)
        (unit-enable $EQ_UNIT --now)
    ]
}

def loopback-link [cfg: record]: nothing -> list<record> {
    let restart = unit-restart $LOOPBACK_UNIT
    [
        (file-copy $LOOPBACK_SCRIPT ($nu.home-dir | path join $SCRIPT_DIR $LOOPBACK_SCRIPT) --then $restart)
        (unit-file $LOOPBACK_UNIT --enable --now --then $restart)
    ]
}

export def link [cfg: record] {
    # pipewire also arrives under wsl, as a dependency of the portals, where wslg owns the audio
    if (which pipewire | is-empty) or $env.FORM_FACTOR? == "wsl" { return [] }
    [
        (unit-enable wireplumber.service)
        (if $cfg.eq_target != null { eq-link $cfg })
        (if $cfg.app_loopbacks { loopback-link $cfg })
    ]
}
