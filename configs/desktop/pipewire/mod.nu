use module.nu *

export const meta = {
    packages: {pacman: [headsetcontrol pipewire pipewire-alsa pipewire-pulse qpwgraph rtkit wiremix wireplumber]}
}

export const options = {
    eq_target: {
        type: string?
        default: null
        doc: "node.name of the headset sink the eq attaches to as a smart filter; unset, no eq chain"
        label: "EQ headset"
        group: audio
    }
    eq_preset: {
        type: string
        default: "pro-x-2.txt"
        doc: "AutoEq ParametricEQ preset for that headset, a file in this module or an absolute path"
        label: "EQ preset"
        group: audio
    }
}

# discord voice measured -18.4 lufs at unity: voice passes, normalized spotify (-14) drops 4 lu
const TARGET_LUFS = -18.0
# -12 db pulls a -6 lufs brickwalled master to target
const GAIN_MIN = 0.25
# +6 db lifts a -24 lufs whisper; no limiter in the builtin graph, more boost clips speech peaks
const GAIN_MAX = 2.0
# media's window is song length so verse and chorus keep their dynamics
const LANES = [
    [name description roles history_s];
    [media Media [Music Movie] 20.0]
    [voice Voice [Communication Phone] 10.0]
]
const CONF_DIR = ".config/pipewire"
const PRESET_FILE = "eq-preset.txt"

def lane-render [lane: record]: nothing -> string {
    let roles = $lane.roles | each { $'"($in)"' } | str join " "
    $"    { name = libpipewire-module-filter-chain
        args = {
            node.description = \"($lane.description)\"
            media.name = \"($lane.description)\"
            audio.position = [ FL FR ]
            filter.graph = {
                nodes = [
                    { type = ebur128 name = meter label = ebur128 config = { max-history = ($lane.history_s | into string --decimals 1) } }
                    { type = ebur128 name = target label = lufs2gain control = { \"Target LUFS\" = ($TARGET_LUFS | into string --decimals 1) } }
                    { type = builtin name = range label = clamp control = { \"Min\" = ($GAIN_MIN) \"Max\" = ($GAIN_MAX | into string --decimals 1) } }
                    { type = builtin name = amount label = linear control = { \"Mult\" = 1.0 \"Add\" = 0.0 } }
                    { type = builtin name = fader label = linear }
                    { type = builtin name = left label = linear }
                    { type = builtin name = right label = linear }
                ]
                links = [
                    { output = \"meter:Out FL\" input = \"left:In\" }
                    { output = \"meter:Out FR\" input = \"right:In\" }
                    { output = \"meter:Global LUFS\" input = \"target:LUFS\" }
                    { output = \"target:Gain\" input = \"range:Control\" }
                    { output = \"range:Notify\" input = \"amount:Control\" }
                    { output = \"amount:Notify\" input = \"fader:Control\" }
                    { output = \"fader:Notify\" input = \"left:Mult\" }
                    { output = \"fader:Notify\" input = \"right:Mult\" }
                ]
                inputs = [ \"meter:In FL\" \"meter:In FR\" ]
                outputs = [ \"left:Out\" \"right:Out\" ]
                capture.volumes = [ { control = \"fader:Mult\" } ]
            }
            capture.props = {
                node.name = \"lane.($lane.name)\"
                media.class = Audio/Sink
                device.intended-roles = [ ($roles) ]
                # never the default sink, its own output would follow it
                priority.session = 0
            }
            playback.props = {
                node.name = \"lane.($lane.name).out\"
                # the name obs's application audio capture matches
                application.name = \"lane.($lane.name)\"
                # an idle lane must not keep the hardware sink awake
                node.passive = true
            }
        }
    }"
}

def eq-render [preset: path, target: string]: nothing -> string {
    $"    { name = libpipewire-module-parametric-equalizer
        args = {
            equalizer.filepath = \"($preset)\"
            equalizer.description = \"EQ\"
            audio.channels = 2
            audio.position = [ FL FR ]
            capture.props = {
                node.name = \"eq\"
                media.class = Audio/Sink
                filter.smart = true
                filter.smart.name = \"eq\"
                filter.smart.target = { node.name = \"($target)\" }
            }
            playback.props = { node.name = \"eq.out\" node.passive = true }
        }
    }"
}

# each chain is its own client (pipewire-chain@<chain>.service), so stopping one leaves the server and the other alone
def chain-render [body: string]: nothing -> string {
    $"# generated by configs/desktop/pipewire/mod.nu, edit there
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt args = { } flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
($body)
]
"
}

def chain-file [conf: path, chain: string, body: string]: nothing -> record {
    # restarting drops the chain's streams for a moment, so only a changed config does
    file-text ($conf | path join $"($chain).conf") (chain-render $body) --generated --then [systemctl --user try-restart $"pipewire-chain@($chain).service"]
}

export def link [cfg: record] {
    # pipewire also arrives under wsl, as a dependency of the portals, where wslg owns the audio
    if (which pipewire | is-empty) or $env.FORM_FACTOR? == "wsl" { return [] }
    let conf = $nu.home-dir | path join $CONF_DIR
    let lanes = [
        # read at pipewire-pulse start only; restarting it here would drop a live call
        (files-into ($conf | path join pipewire-pulse.conf.d) roles.conf)
        (unit-file pipewire-chain@.service)
        (chain-file $conf lanes ($LANES | each { lane-render $in } | str join "\n"))
        (unit-enable pipewire-chain@lanes.service --now)
    ]
    if $cfg.eq_target == null { return $lanes }
    let preset = $conf | path join $PRESET_FILE
    $lanes ++ [
        # the eq starts on a fresh install; after that the audio panel's switch owns its enablement
        (exec eq-enable [systemctl --user enable --now pipewire-chain@eq.service] --creates ($conf | path join eq.conf))
        (file-copy $cfg.eq_preset $preset)
        (chain-file $conf eq (eq-render $preset $cfg.eq_target))
    ]
}
