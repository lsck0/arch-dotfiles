[Unit]
Description=Quickshell bar, launcher, clipboard and lock screen
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
Slice=session.slice
ExecStartPre=%h/.config/quickshell/restart.nu prepare
ExecStart=/usr/bin/quickshell -p %h/.config/quickshell
Restart=on-failure
RestartSec=2
