[Unit]
Description=Quickshell bar, launcher, clipboard and lock screen
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
Slice=session.slice
ExecStartPre=%h/.config/quickshell/restart.nu prepare
# a tray item that fails its IconName Get (Discord) is warned about on every icon change, thousands of lines a day
ExecStart=/usr/bin/quickshell --log-rules=quickshell.dbus.properties.warning=false -p %h/.config/quickshell
Restart=on-failure
RestartSec=2
