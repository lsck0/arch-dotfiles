[Unit]
Description=Quickshell bar, launcher, clipboard and lock screen
# started by hyprland_autostart.lua, not enabled: plasma reaches graphical-session.target too
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
# protected with the compositor (base/oomd), outside oomd's app.slice: the lock screen lives here
Slice=session.slice
ExecStartPre=%h/.config/quickshell/restart.sh prepare
ExecStart=/usr/bin/quickshell -p %h/.config/quickshell
Restart=on-failure
RestartSec=2
