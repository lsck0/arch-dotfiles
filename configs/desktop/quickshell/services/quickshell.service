[Unit]
Description=Quickshell bar, launcher, clipboard and lock screen
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
Slice=session.slice
ExecStartPre=%h/.config/quickshell/restart.nu prepare
# a tray item that fails its IconName Get (Discord) is warned about on every icon change, thousands of lines a day
# --no-detailed-logs: log.qslog keeps every debug line whatever the rules, and the desktop-entry monitor watches each
# applications dir's ancestors ($HOME, ~/.local/share, /), rescanning and logging every entry on any change there
ExecStart=/usr/bin/quickshell --no-detailed-logs --log-rules=quickshell.dbus.properties.warning=false -p %h/.config/quickshell
Restart=on-failure
RestartSec=2
