set selection-clipboard clipboard
set selection-notification true

set synctex true
set synctex-edit-modifier alt
set synctex-editor-command "synctex-edit %{input} %{line} %{column}"

set adjust-open width
set zoom-center true
set zoom-step 10
set zoom-min 10
set zoom-max 2000

set scroll-step 80
set scroll-hstep 80
set scroll-page-aware true
set scroll-full-overlap 0.05
set scroll-wrap false

set continuous-hist-save true
set window-title-basename true
set window-title-page true
set statusbar-basename true
set statusbar-home-tilde true
set statusbar-page-percent true
set guioptions "sv"
set font "@FONT@ @UI_SIZE@"

map <Button4> navigate previous
map <Button5> navigate next

map r reload
map R rotate
map <C-i> recolor
map i recolor
map p print

include @HOME@/.cache/wal/colors-zathura
