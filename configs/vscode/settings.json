{
  "editor.fontFamily": "'Kode Mono', 'monospace'",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Default Dark Modern",
  "vim.useSystemClipboard": true,
  "workbench.colorCustomizations": {
    "editor.background": "#0B0E14",
    "editor.foreground": "#BFBDB6",
    "sideBar.background": "#01060E",
    "activityBar.background": "#01060E",
    "statusBar.background": "#01060E",
    "titleBar.activeBackground": "#01060E",
    "tab.activeBackground": "#0B0E14",
    "tab.inactiveBackground": "#01060E",
    "focusBorder": "#39BAE6",
    "terminal.background": "#0B0E14",
    "terminal.foreground": "#BFBDB6"
  }
}
