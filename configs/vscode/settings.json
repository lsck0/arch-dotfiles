{
  "editor.fontFamily": "'Kode Mono', 'monospace'",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Default Dark Modern",
  "vim.useSystemClipboard": true,
  "workbench.colorCustomizations": {
    "editor.background": "#100F16",
    "editor.foreground": "#D7B6D0",
    "sideBar.background": "#090A23",
    "activityBar.background": "#090A23",
    "statusBar.background": "#090A23",
    "titleBar.activeBackground": "#090A23",
    "tab.activeBackground": "#100F16",
    "tab.inactiveBackground": "#090A23",
    "focusBorder": "#6EA0F7",
    "terminal.background": "#100F16",
    "terminal.foreground": "#D7B6D0"
  }
}
