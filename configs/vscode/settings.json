{
  "editor.fontFamily": "'Kode Mono', 'monospace'",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Default Dark Modern",
  "vim.useSystemClipboard": true,
  "workbench.colorCustomizations": {
    "editor.background": "#0E1016",
    "editor.foreground": "#CBC5FB",
    "sideBar.background": "#0C1222",
    "activityBar.background": "#0C1222",
    "statusBar.background": "#0C1222",
    "titleBar.activeBackground": "#0C1222",
    "tab.activeBackground": "#0E1016",
    "tab.inactiveBackground": "#0C1222",
    "focusBorder": "#BCACBE",
    "terminal.background": "#0E1016",
    "terminal.foreground": "#CBC5FB"
  }
}
