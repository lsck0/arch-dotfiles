{
  "editor.fontFamily": "'Kode Mono', 'monospace'",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Default Dark Modern",
  "vim.useSystemClipboard": true,
  "workbench.colorCustomizations": {
    "editor.background": "#111114",
    "editor.foreground": "#C5C8CF",
    "sideBar.background": "#16161D",
    "activityBar.background": "#16161D",
    "statusBar.background": "#16161D",
    "titleBar.activeBackground": "#16161D",
    "tab.activeBackground": "#111114",
    "tab.inactiveBackground": "#16161D",
    "focusBorder": "#7AA2F7",
    "terminal.background": "#111114",
    "terminal.foreground": "#C5C8CF"
  }
}
