{
  "editor.fontFamily": "'Kode Mono', 'monospace'",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Dark Modern",
  "vim.useSystemClipboard": true,
  "workbench.colorCustomizations": {
    "editor.background": "#1A1B26",
    "editor.foreground": "#C0CAF5",
    "sideBar.background": "#15161E",
    "activityBar.background": "#15161E",
    "statusBar.background": "#15161E",
    "titleBar.activeBackground": "#15161E",
    "tab.activeBackground": "#1A1B26",
    "tab.inactiveBackground": "#15161E",
    "focusBorder": "#7AA2F7",
    "terminal.background": "#1A1B26",
    "terminal.foreground": "#C0CAF5"
  }
}
