{
  "editor.fontFamily": "'Kode Mono', 'monospace'",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Default Dark Modern",
  "vim.useSystemClipboard": true,
  "workbench.colorCustomizations": {
    "editor.background": "#091114",
    "editor.foreground": "#C7C2D8",
    "sideBar.background": "#091621",
    "activityBar.background": "#091621",
    "statusBar.background": "#091621",
    "titleBar.activeBackground": "#091621",
    "tab.activeBackground": "#091114",
    "tab.inactiveBackground": "#091621",
    "focusBorder": "#8E7982",
    "terminal.background": "#091114",
    "terminal.foreground": "#C7C2D8"
  }
}
