$env.config.color_config = {{
    separator: "{color8}"
    leading_trailing_space_bg: {{ attr: "n" }}
    header: {{ fg: "{color4}" attr: "b" }}
    row_index: {{ fg: "{color8}" }}
    hints: "{color8}"
    search_result: {{ fg: "{background}" bg: "{color3}" }}

    empty: "{color4}"
    bool: "{color6}"
    int: "{foreground}"
    float: "{foreground}"
    filesize: "{color6}"
    duration: "{foreground}"
    date: "{color5}"
    range: "{foreground}"
    string: "{color2}"
    nothing: "{color8}"
    binary: "{color5}"
    cell-path: "{foreground}"
    record: "{foreground}"
    list: "{foreground}"
    block: "{foreground}"
    closure: "{color6}"
    glob: "{color6}"

    shape_and: {{ fg: "{color5}" attr: "b" }}
    shape_binary: {{ fg: "{color5}" attr: "b" }}
    shape_block: {{ fg: "{color4}" attr: "b" }}
    shape_bool: "{color6}"
    shape_closure: {{ fg: "{color6}" attr: "b" }}
    shape_custom: "{color2}"
    shape_datetime: {{ fg: "{color6}" attr: "b" }}
    shape_directory: "{color6}"
    shape_external: "{color6}"
    shape_external_resolved: "{color6}"
    shape_externalarg: {{ fg: "{color2}" attr: "b" }}
    shape_filepath: "{color6}"
    shape_flag: {{ fg: "{color4}" attr: "b" }}
    shape_float: {{ fg: "{color5}" attr: "b" }}
    shape_garbage: {{ fg: "{background}" bg: "{color1}" attr: "b" }}
    shape_glob_interpolation: {{ fg: "{color6}" attr: "b" }}
    shape_globpattern: {{ fg: "{color6}" attr: "b" }}
    shape_int: {{ fg: "{color5}" attr: "b" }}
    shape_internalcall: {{ fg: "{color6}" attr: "b" }}
    shape_keyword: {{ fg: "{color5}" attr: "b" }}
    shape_list: {{ fg: "{color6}" attr: "b" }}
    shape_literal: "{color4}"
    shape_match_pattern: "{color2}"
    shape_matching_brackets: {{ attr: "u" }}
    shape_nothing: "{color6}"
    shape_operator: "{color3}"
    shape_or: {{ fg: "{color5}" attr: "b" }}
    shape_pipe: {{ fg: "{color5}" attr: "b" }}
    shape_range: {{ fg: "{color3}" attr: "b" }}
    shape_record: {{ fg: "{color6}" attr: "b" }}
    shape_redirection: {{ fg: "{color5}" attr: "b" }}
    shape_signature: {{ fg: "{color2}" attr: "b" }}
    shape_string: "{color2}"
    shape_string_interpolation: {{ fg: "{color6}" attr: "b" }}
    shape_table: {{ fg: "{color4}" attr: "b" }}
    shape_variable: "{color5}"
    shape_vardecl: "{color5}"
}}
