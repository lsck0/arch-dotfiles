[Unit]
Description=offload: this login's idle gate (gamemode, obs output)
ConditionPathIsDirectory=/run/offload/gate
# the group reaches a login on its next start; until then the gate counts as down, so the worker waits
ConditionGroup=offload

[Service]
ExecStart=@DOTFILES@/configs/programming/offload/gate.nu
# a login gone takes its state along: no stale busy left behind
ExecStopPost=/usr/bin/rm -f /run/offload/gate/%U.json
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
