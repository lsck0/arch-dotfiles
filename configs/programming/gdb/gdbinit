set debuginfod enabled on

python
import os
import sys

import gdb.printing

ue_printers = os.path.expanduser("~/.config/Epic/GDBPrinters/")
if os.path.isdir(ue_printers):
    sys.path.append(ue_printers)
    from UEPrinters import register_ue_printers
    register_ue_printers(None)

_pwndbg = "/usr/share/pwndbg/gdbinit.py"
if os.path.exists(_pwndbg):
    gdb.execute("source " + _pwndbg)

_state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "gdb")
os.makedirs(_state, mode=0o700, exist_ok=True)
gdb.execute("set history filename " + os.path.join(_state, "history"))
end

set output-radix 10
