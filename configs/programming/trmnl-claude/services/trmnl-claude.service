[Unit]
Description=Post Claude Code usage to the TRMNL display
Documentation=https://github.com/emaspa/trmnl-claude

[Service]
Type=oneshot
# the script retries a post itself: systemd's Restart= on a oneshot still fires OnFailure for the first failure
ExecCondition=@DIR@/scripts/trmnl-claude.nu changed
ExecStart=@DIR@/scripts/trmnl-claude.nu
