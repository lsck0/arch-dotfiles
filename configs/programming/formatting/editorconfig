# global fallback, no root=true so project configs win
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.md]
# trailing two spaces are a hard line break in markdown
trim_trailing_whitespace = false

[*.sh]
# match nvim shfmt -ci -bn
switch_case_indent = true
binary_next_line = true

[{Makefile,GNUmakefile,*.mk,*.go}]
indent_style = tab
