{
  "editor.fontFamily": "'Kode Mono', 'monospace'",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Dark Modern",
  "vim.useSystemClipboard": true,
  "workbench.colorCustomizations": {
    "editor.background": "#0F0F16",
    "editor.foreground": "#F290CE",
    "sideBar.background": "#000A25",
    "activityBar.background": "#000A25",
    "statusBar.background": "#000A25",
    "titleBar.activeBackground": "#000A25",
    "tab.activeBackground": "#0F0F16",
    "tab.inactiveBackground": "#000A25",
    "focusBorder": "#AA6785",
    "terminal.background": "#0F0F16",
    "terminal.foreground": "#F290CE"
  }
}
