[Unit]
Description=Hermes system agent: one long session in tmux (socket system-agent), shown by the SUPER+grave dropdown
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# tmux forks its server; the session ends when hermes exits, the server with it, and systemd starts a fresh one that
# continues the profile's last session. The unit carries the session's wayland and hyprland environment, so the agent
# drives the desktop as Luca does.
Type=forking
# Luca's tmux.conf: his prefix and keys, and the wallust colours core/tmux re-sources into every server on a theme switch
ExecStart=/usr/bin/tmux -L system-agent new-session -d -s agent -x 160 -y 48 -c %h "%h/.local/bin/hermes-system-agent"
# voice mode is per session in hermes, not config: switched on once the prompt is up (at most a minute)
ExecStartPost=/bin/sh -c 'for i in $(seq 60); do /usr/bin/tmux -L system-agent capture-pane -p -t agent 2>/dev/null | grep -q "^ system [^ ]" && exec /usr/bin/tmux -L system-agent send-keys -t agent "/voice on" Enter; sleep 1; done'
ExecStop=/usr/bin/tmux -L system-agent kill-server
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=graphical-session.target
