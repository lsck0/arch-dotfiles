# Samsung phones in Download mode (685d, samloader flashes them) and booted (6860, adb and MTP): the seat user reaches
# them without root. Only these two ids, so a Samsung SSD, printer or webcam gets no raw usbfs access. 71- puts the
# uaccess tag in place before 73-seat-late.rules
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", ATTR{idProduct}=="685d|6860", TAG+="uaccess"
