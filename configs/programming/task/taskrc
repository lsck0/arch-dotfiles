data.location=~/.task
include ~/.config/bugwarrior/uda.taskrc
include ~/.config/task/sync.taskrc

default.command=next
report.next.columns=id,start.age,entry.age,depends.indicator,priority,project,tags,recur.indicator,scheduled.countdown,due.relative,until.remaining,description.count,urgency
report.next.labels=ID,Active,Age,D,P,Project,Tag,R,S,Due,Until,Description,Urg

dateformat=Y-M-D
dateformat.report=Y-M-D
dateformat.annotation=Y-M-D
date.iso=yes
weekstart=Monday
journal.info=off

report.dash.description=Human overview, urgency first
report.dash.columns=id,start.age,project,tags,scheduled.countdown,due.relative,urgency,description.count
report.dash.labels=ID,Active,Project,Tag,Sched,Due,Urg,Description
report.dash.filter=status:pending
report.dash.sort=urgency-

report.aging.description=Oldest pending tasks first
report.aging.columns=id,entry.age,project,tags,due.relative,description.count
report.aging.labels=ID,Age,Project,Tag,Due,Description
report.aging.filter=status:pending
report.aging.sort=entry+

urgency.user.tag.inbox.coefficient=-2.0
urgency.user.tag.github.coefficient=-1.0
urgency.user.tag.involved.coefficient=-1.5

color=on
rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.
include ~/.config/task/wal.theme
