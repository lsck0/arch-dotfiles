;;; doom-pywal-theme.el --- generated from the active wallust palette -*- lexical-binding: t; no-byte-compile: t; -*-
;;; Commentary:
;; rewritten by configs/programming/emacs (its theme verb) on every theme switch, do not edit
;;; Code:

(require 'doom-themes)

(def-doom-theme doom-pywal
  "A theme generated from the active wallust/pywal palette."
  :family 'doom-pywal
  :background-mode '@MODE@

  ((bg         '("@BG_CONDITIONED@"  "black"   "black"        ))
   (fg         '("@FG@"  "#bfbfbf"       "brightwhite"  ))
   (bg-alt     (doom-@DARKEN@ bg 0.10))
   (fg-alt     (doom-@LIGHTEN@ fg 0.20))

   (base0      (doom-@DARKEN@ bg 0.20))
   (base1      (doom-@DARKEN@ bg 0.10))
   (base2      bg)
   (base3      (doom-@LIGHTEN@ bg 0.10))
   (base4      (doom-blend bg fg 0.25))
   (base5      (doom-blend bg fg 0.45))
   (base6      (doom-blend bg fg 0.60))
   (base7      (doom-blend bg fg 0.75))
   (base8      (doom-@LIGHTEN@ fg 0.20))

   (grey       base4)
   (red        '("@C1@"  "@C1@"  "red"           ))
   (orange     (doom-blend '("@C1@" "@C1@" "brightred") '("@C3@" "@C3@" "yellow") 0.5))
   (green      '("@C2@"  "@C2@"  "green"         ))
   (teal       (doom-blend '("@C2@" "@C2@" "brightgreen") '("@C6@" "@C6@" "cyan") 0.5))
   (yellow     '("@C3@"  "@C3@"  "yellow"        ))
   (blue       '("@C4@"  "@C4@"  "brightblue"    ))
   (dark-blue  (doom-@DARKEN@ '("@C4@" "@C4@" "blue") 0.4))
   (magenta    '("@C5@"  "@C5@"  "brightmagenta" ))
   (violet     (doom-blend '("@C5@" "@C5@" "magenta") '("@C4@" "@C4@" "blue") 0.5))
   (cyan       '("@C6@"  "@C6@"  "brightcyan"    ))
   (dark-cyan  (doom-@DARKEN@ '("@C6@" "@C6@" "cyan") 0.4))

   ;; mandatory "universal syntax classes": doom-themes-base errors without them
   (highlight      blue)
   (vertical-bar   (doom-@DARKEN@ bg 0.15))
   (selection      '("@R_SELECTION@" "@R_SELECTION@" "blue"))
   (builtin        '("@R_BUILTIN@" "@R_BUILTIN@" "cyan"))
   (comments       '("@R_COMMENT@" "@R_COMMENT@" "brightblack"))
   (doc-comments   (doom-@LIGHTEN@ "@R_COMMENT@" 0.25))
   (constants      '("@R_CONSTANT@" "@R_CONSTANT@" "brightred"))
   (functions      '("@R_FUNCTION@" "@R_FUNCTION@" "brightblue"))
   (keywords       '("@R_KEYWORD@" "@R_KEYWORD@" "brightmagenta"))
   (methods        functions)
   (operators      '("@R_PUNCTUATION@" "@R_PUNCTUATION@" "white"))
   (type           '("@R_TYPE@" "@R_TYPE@" "yellow"))
   (strings        '("@R_STRING@" "@R_STRING@" "green"))
   (variables      fg)
   (numbers        constants)
   (region         selection)
   (error          '("@R_ERROR@" "@R_ERROR@" "red"))
   (warning        '("@R_WARN@" "@R_WARN@" "yellow"))
   (success        '("@R_OK@" "@R_OK@" "green"))
   (vc-modified    '("@R_CHANGED@" "@R_CHANGED@" "yellow"))
   (vc-added       '("@R_ADDED@" "@R_ADDED@" "green"))
   (vc-deleted     '("@R_REMOVED@" "@R_REMOVED@" "red"))))

(provide-theme 'doom-pywal)
;;; doom-pywal-theme.el ends here
