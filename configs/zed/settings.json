{
    "theme": "Pywal",
    "vim_mode": true,
    "format_on_save": "on",
    "buffer_font_family": "Kode Mono",
    "buffer_font_size": 16,
    "relative_line_numbers": true,
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "vim": {
        "use_system_clipboard": "always"
    }
}
