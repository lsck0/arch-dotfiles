[
    {
        "bindings": {
            "ctrl-s": "workspace::Save"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "alt-1": [
                "pane::ActivateItem",
                0
            ],
            "alt-2": [
                "pane::ActivateItem",
                1
            ],
            "alt-3": [
                "pane::ActivateItem",
                2
            ],
            "alt-4": [
                "pane::ActivateItem",
                3
            ],
            "alt-5": [
                "pane::ActivateItem",
                4
            ],
            "alt-c": "workspace::NewFile",
            "alt-x": "pane::CloseActiveItem",
            "alt-t": "terminal_panel::ToggleFocus",
            "alt-shift-h": [
                "workspace::ActivatePaneInDirection",
                "Left"
            ],
            "alt-shift-j": [
                "workspace::ActivatePaneInDirection",
                "Down"
            ],
            "alt-shift-k": [
                "workspace::ActivatePaneInDirection",
                "Up"
            ],
            "alt-shift-l": [
                "workspace::ActivatePaneInDirection",
                "Right"
            ]
        }
    },
    {
        "context": "VimControl && !menu",
        "bindings": {
            "space x": "editor::ToggleComments",
            "space e": "project_panel::ToggleFocus",
            "space o": "project_panel::ToggleFocus",
            "space g": "git_panel::ToggleFocus",
            "space t": "diagnostics::Deploy",
            "space i": "outline::Toggle",
            "space m": "task::Spawn",
            "space f f": "file_finder::Toggle",
            "space f w": "pane::DeploySearch",
            "space f b": "tab_switcher::Toggle",
            "space l d": "editor::GoToDefinition",
            "space l f": "editor::FindAllReferences",
            "space l i": "editor::Hover",
            "space l a": "editor::ToggleCodeActions",
            "space l r": "editor::Rename",
            "space l e": "diagnostics::Deploy",
            "space l n": "editor::GoToDiagnostic",
            "ctrl-n": "editor::GoToDiagnostic",
            "ctrl-shift-n": "editor::GoToPreviousDiagnostic"
        }
    }
]
