[Unit]
Description=Forward ntfy topic messages to desktop notifications
# no network-online: a user unit cannot wait on system targets, the script reconnects with backoff
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/projects/arch-dotfiles/configs/base/ntfy/ntfy-notify.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
