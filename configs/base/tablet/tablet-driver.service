[Unit]
Description=Userspace driver for the SZ PENG YI [T1161] graphics tablet
Documentation=file:/var/lib/dotfiles/repo/configs/base/tablet/tablet-driver.py

[Service]
Type=simple
ExecStart=/usr/local/bin/tablet-driver
# exits 0 when unplugged; udev starts it again on the next add
Restart=on-failure
RestartSec=2
TimeoutStartSec=30

# must match CALIB_PATH in tablet-driver.py
StateDirectory=tablet-driver

DeviceAllow=/dev/uinput rw
DeviceAllow=char-hidraw rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
