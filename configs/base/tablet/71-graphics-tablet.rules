# 71- sorts after 60-input-id.rules (sets ID_INPUT_*) and before 73-seat-late.rules (uaccess)

# clear ID_INPUT_* on both event and parent input node: libinput reads each and takes the union
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{bInterfaceNumber}=="01", \
  ENV{ID_VENDOR_ID}=="08f2", ENV{ID_MODEL_ID}=="6811", \
  ENV{LIBINPUT_IGNORE_DEVICE}="1", \
  ENV{ID_INPUT_TABLET}="", ENV{ID_INPUT_MOUSE}="", \
  ENV{ID_INPUT_TOUCHPAD}="", ENV{ID_INPUT_KEY}="", ENV{ID_INPUT_KEYBOARD}=""

SUBSYSTEM=="input", KERNEL=="input*", \
  ENV{ID_VENDOR_ID}=="08f2", ENV{ID_MODEL_ID}=="6811", \
  ENV{ID_USB_INTERFACE_NUM}=="01", \
  ENV{ID_INPUT_TABLET}="", ENV{ID_INPUT_MOUSE}="", \
  ENV{ID_INPUT_TOUCHPAD}="", ENV{ID_INPUT_KEY}="", ENV{ID_INPUT_KEYBOARD}=""

# suppress the post-unlock dead pen: a second same-name tablet makes Hyprland append "-1" to the wrong device
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{bInterfaceNumber}=="02", \
  ENV{ID_VENDOR_ID}=="08f2", ENV{ID_MODEL_ID}=="6811", \
  ENV{ID_INPUT_TABLET}=="1", \
  ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT_TABLET}=""

SUBSYSTEM=="input", KERNEL=="input*", \
  ENV{ID_VENDOR_ID}=="08f2", ENV{ID_MODEL_ID}=="6811", \
  ENV{ID_USB_INTERFACE_NUM}=="02", ENV{ID_INPUT_TABLET}=="1", \
  ENV{ID_INPUT_TABLET}=""

# express keys double-report canned keystrokes here (one mutes the machine)
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{bInterfaceNumber}=="02", \
  ENV{ID_VENDOR_ID}=="08f2", ENV{ID_MODEL_ID}=="6811", \
  ENV{LIBINPUT_IGNORE_DEVICE}="1", \
  ENV{ID_INPUT_KEY}="", ENV{ID_INPUT_KEYBOARD}=""

SUBSYSTEM=="input", KERNEL=="input*", \
  ENV{ID_VENDOR_ID}=="08f2", ENV{ID_MODEL_ID}=="6811", \
  ENV{ID_USB_INTERFACE_NUM}=="02", \
  ENV{ID_INPUT_KEY}="", ENV{ID_INPUT_KEYBOARD}=""

# the driver's uinput devices have no usb parent, so matched by name
SUBSYSTEM=="input", ATTRS{name}=="SDD Tablet T1161", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="SDD Tablet T1161 Keys", TAG+="uaccess"

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="08f2", ATTRS{idProduct}=="6811", TAG+="uaccess"

# SYSTEMD_WANTS, not RUN (must not block); bInterfaceNumber sits on another parent, so both hidraw nodes fire, harmlessly
SUBSYSTEM=="hidraw", ACTION=="add", ATTRS{idVendor}=="08f2", \
  ATTRS{idProduct}=="6811", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="tablet-driver.service"

# the fake cdrom carrying the windows driver
SUBSYSTEM=="block", ATTRS{idVendor}=="08f2", ATTRS{idProduct}=="6811", ENV{UDISKS_IGNORE}="1"
