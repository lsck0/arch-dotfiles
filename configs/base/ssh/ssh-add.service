[Unit]
Description=Load the secrets ssh key into ssh-agent
Requires=ssh-agent.service
After=ssh-agent.service graphical-session.target

[Service]
Type=oneshot
Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket
Environment=SSH_ASKPASS=@DOTFILES@/configs/base/ssh/ssh-askpass-keyring.nu
Environment=SSH_ASKPASS_REQUIRE=force
ExecStart=/usr/bin/ssh-add @DOTFILES@/configs/secrets/keys/ssh_privatekey.asc

[Install]
WantedBy=graphical-session.target
