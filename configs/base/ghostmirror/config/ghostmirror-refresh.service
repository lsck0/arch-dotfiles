[Unit]
Description=Rebuild ghostmirror mirror pool from upstream
# offline, the probe fails and the run is retried the same day instead of at the next period
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1d
StartLimitBurst=4

[Service]
Type=oneshot
Restart=on-failure
RestartSec=30min
ExecStartPre=/usr/bin/curl -sfI --max-time 10 -o /dev/null https://archlinux.org/mirrorlist/all/
ExecStart=/usr/local/bin/mirrorlist-update rebuild
ProtectSystem=strict
ReadWritePaths=/etc/pacman.d
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
