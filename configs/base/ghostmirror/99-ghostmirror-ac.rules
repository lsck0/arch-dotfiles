# the mirror timers run only on mains (ConditionACPower in each): a run missed on battery is caught up at the plug-in
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="0", RUN+="/usr/bin/systemctl --no-block stop ghostmirror.timer ghostmirror-refresh.timer"
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="1", RUN+="/usr/bin/systemctl --no-block start ghostmirror.timer ghostmirror-refresh.timer"
