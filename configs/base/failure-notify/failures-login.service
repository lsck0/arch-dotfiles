[Unit]
Description=Desktop notification while a dotfiles run left FAILURES.*
After=graphical-session.target
ConditionPathExistsGlob=@DOTFILES@/FAILURES.*

[Service]
Type=oneshot
ExecStartPre=/usr/bin/gdbus wait --session org.freedesktop.Notifications
ExecStart=/usr/bin/sh -c 'cd @DOTFILES@ && exec notify-send -u critical -a dotfiles "Dotfiles run failed" "$$(tail -vn +1 FAILURES.*)"'
TimeoutStartSec=1min

[Install]
WantedBy=graphical-session.target
