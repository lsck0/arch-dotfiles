[Unit]
Description=Desktop notification that %i failed
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
ExecStartPre=/usr/bin/gdbus wait --session org.freedesktop.Notifications
ExecStart=/usr/bin/notify-send -u critical -a systemd "%i failed" "journalctl --user -xeu %i"
TimeoutStartSec=1min
