// the VM test's network (vm-net, as group vmnet, which passes portmaster only for TCP 853 to quad9) for an admin at the
// machine, unprompted: agents run the VM test with nobody to touch a key, and vm-net starts only pasta and passt from
// checked values
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") === "/usr/local/bin/vm-net" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
