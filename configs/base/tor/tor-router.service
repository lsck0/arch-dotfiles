[Unit]
Description=Transparent tor routing
Wants=tor.service
After=tor.service
# tor runs only for the router: it stops with it, while a tor restart still leaves the table up
PropagatesStopTo=tor.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/tor-router start
ExecStop=/usr/local/bin/tor-router stop
