# managed by arch-dotfiles/apparmor
owner @{HOME}/{.claude,projects/*/.identity/claude}/chrome/chrome-native-host rPUx,
# Claude Desktop's native messaging host for the browser extension, the same as Claude Code's above
/usr/lib/claude-desktop/resources/chrome-native-host rPUx,
owner @{user_share_dirs}/work/ rw,
owner @{user_share_dirs}/work/chromium/ rw,
owner @{user_share_dirs}/work/chromium/** rwk,
owner @{user_projects_dirs}/*/.identity/chromium/ rw,
owner @{user_projects_dirs}/*/.identity/chromium/** rwk,
owner @{user_projects_dirs}/*/.identity/chromium/WidevineCdm/*/_platform_specific/linux_*/libwidevinecdm.so mrw,
owner @{user_share_dirs}/work/chromium/WidevineCdm/*/_platform_specific/linux_*/libwidevinecdm.so mrw,
@{run}/udev/data/+hid:* r,
include <abstractions/dotfiles/nssdb>
deny @{sys}/fs/cgroup/**/cpu.max r,
deny @{sys}/devices/virtual/dmi/id/{bios,board}_* r,
owner /tmp/puppeteer_dev_chrome_profile-*/ rw,
owner /tmp/puppeteer_dev_chrome_profile-*/** rwk,
owner /tmp/.org.chromium.Chromium.*/ rw,
owner /tmp/.org.chromium.Chromium.*/** rwk,
owner /tmp/playwright_chromiumdev_profile-*/ rw,
owner /tmp/playwright_chromiumdev_profile-*/** rwk,
owner @{user_cache_dirs}/chrome-devtools-mcp/ rw,
owner @{user_cache_dirs}/chrome-devtools-mcp/** rwk,
owner @{run}/user/@{uid}/speech-dispatcher/speechd.sock rw,
deny @{user_config_dirs}/mimeapps.list* w,
deny @{user_share_dirs}/applications/{,**} w,
# apparmor.d writes only the download dir: "Save as" elsewhere failed, as firefox's no longer does
include <abstractions/dotfiles/save-anywhere>
include <abstractions/dotfiles/claude-desktop-fontconfig>
# xdg-settings and xdg-mime probing the default browser on every start, which the policy turns off anyway
deny @{bin}/xprop rx,
deny @{bin}/dbus-send rx,
deny @{PROC}/version r,
