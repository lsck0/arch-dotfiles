# managed by arch-dotfiles/apparmor
owner @{user_cache_dirs}/wal/colors-thunderbird.css r,
owner @{user_config_dirs}/{,.}thunderbird/ rw,
owner @{user_config_dirs}/{,.}thunderbird/** rwk,
include <abstractions/dotfiles/viewer-read>

priority=1 @{bin}/gpg{,2} rCx -> gpg,
priority=1 @{bin}/gpgconf rCx -> gpg,
priority=1 @{bin}/gpgsm   rCx -> gpg,

profile gpg flags=(attach_disconnected) {
  include <abstractions/dotfiles/gpg-client>
}
