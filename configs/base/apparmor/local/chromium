# managed by arch-dotfiles/apparmor
# native messaging hosts: proton pass (root-owned), and claude code's browser bridge, a fixed script in a config dir
# the browser can read but never write
/opt/proton-pass/resources/assets/proton_pass_nm_host rPUx,
owner @{HOME}/{.claude,projects/*/.identity/claude}/chrome/chrome-native-host rPUx,
# the capgemini work profile (desktop/capgemini) is its own --user-data-dir, out of apparmor.d's @{config_dirs}
owner @{user_share_dirs}/capgemini/ rw,
owner @{user_share_dirs}/capgemini/chromium/ rw,
owner @{user_share_dirs}/capgemini/chromium/** rwk,
owner @{user_share_dirs}/capgemini/chromium/WidevineCdm/*/_platform_specific/linux_*/libwidevinecdm.so mrw,
# a handler the browser registers is what child-open-any runs unconfined; base/xdg owns these
deny @{user_config_dirs}/mimeapps.list* w,
deny @{user_share_dirs}/applications/{,**} w,
