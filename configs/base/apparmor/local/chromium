# managed by arch-dotfiles/apparmor
# native messaging hosts: proton pass (root-owned), and claude code's browser bridge, a fixed script in a config dir
# the browser can read but never write
/opt/proton-pass/resources/assets/proton_pass_nm_host rPUx,
owner @{HOME}/{.claude,projects/*/.identity/claude}/chrome/chrome-native-host rPUx,
# the capgemini work profile (desktop/capgemini) is its own --user-data-dir, out of apparmor.d's @{config_dirs}
owner @{user_share_dirs}/capgemini/ rw,
owner @{user_share_dirs}/capgemini/chromium/ rw,
owner @{user_share_dirs}/capgemini/chromium/** rwk,
owner @{user_share_dirs}/capgemini/chromium/WidevineCdm/*/_platform_specific/linux_*/libwidevinecdm.so mrw,
# security keys (webauthn, the capgemini pingid one): apparmor.d's devices-u2f opens /dev/hidraw*, but chromium's hid
# discovery first reads the hid parent's udev record and skips the key without it
@{run}/udev/data/+hid:* r,
# the nss cert store, moved to XDG state by base/xdg; apparmor.d's chromium abstraction only covers the ~/.pki default,
# so client certs and the cert db are unwritable at the new path without this
owner @{user_state_dirs}/pki/nssdb/ rw,
owner @{user_state_dirs}/pki/nssdb/** rwk,
# chromium probes its own cgroup cpu.max to size its thread pools and falls back to sysconf when it cannot; deny it
# quietly so the probe does not flood the audit log
deny @{sys}/fs/cgroup/**/cpu.max r,
# puppeteer's headless browser (mermaid-cli's mmdc, nvim's diagram previews) runs on a fresh --user-data-dir in temp
owner /tmp/puppeteer_dev_chrome_profile-*/ rw,
owner /tmp/puppeteer_dev_chrome_profile-*/** rwk,
# claude's browser mcp servers (programming/playwright): playwright-mcp's throwaway profile in temp, and
# chrome-devtools-mcp's lasting one in the cache
owner /tmp/playwright_chromiumdev_profile-*/ rw,
owner /tmp/playwright_chromiumdev_profile-*/** rwk,
owner @{user_cache_dirs}/chrome-devtools-mcp/ rw,
owner @{user_cache_dirs}/chrome-devtools-mcp/** rwk,
# a handler the browser registers is what child-open-any runs unconfined; base/xdg owns these
deny @{user_config_dirs}/mimeapps.list* w,
deny @{user_share_dirs}/applications/{,**} w,
