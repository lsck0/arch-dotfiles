# managed by arch-dotfiles/apparmor
include <abstractions/dotfiles/viewer-read>
owner @{run}/user/@{uid}/*mpv*.sock rw,
owner @{run}/user/@{uid}/mpv/{,**} rw,
owner /tmp/*mpv* rw,

priority=1 @{bin}/yt-dlp rCx -> yt-dlp,
signal (send) set=(term, kill) peer=mpv//yt-dlp,

profile yt-dlp flags=(attach_disconnected) {
  include <abstractions/base-strict>
  include <abstractions/nameservice-strict>
  include <abstractions/python>
  include <abstractions/ssl_certs>

  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  signal (receive) set=(term, kill) peer=mpv,
  deny /dev/tty rw,

  @{bin}/yt-dlp r,
  @{bin}/uname rix,
  @{bin}/{ffmpeg,ffprobe} rix,
  @{bin}/deno rix,

  owner @{user_cache_dirs}/yt-dlp/{,**} rwk,
  owner @{user_cache_dirs}/deno/{,**} r,
  owner @{tmp}/yt_dlp*/ rw,
  owner @{tmp}/yt_dlp*/** rwk,
  owner @{tmp}/[a-z0-9_]* rw,
  deny @{bin}/{file,ldconfig,gcc,cc,ld} x,

  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/{mounts,cgroup} r,
  @{sys}/fs/cgroup/{,**/}cpu.max r,
}
