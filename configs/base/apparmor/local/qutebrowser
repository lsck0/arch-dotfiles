# managed by arch-dotfiles/apparmor
owner @{HOME}/projects/arch-dotfiles/configs/desktop/qutebrowser/config.py r,
owner @{user_cache_dirs}/wal/{colors.json,colors-qutebrowser.css} r,
owner @{user_share_dirs}/weblinks/links.js r,
owner @{HOME}/projects/arch-dotfiles/{,configs/secrets/state/}wallpapers/** r,
deny @{user_config_dirs}/chromium/{,**} r,
@{open_path} rPx -> child-open-strict,
owner @{user_cache_dirs}/qutebrowser/{,**} l,
include <abstractions/dotfiles/viewer-read>
owner /tmp/[0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_] rw,
owner /tmp/qutebrowser-basedir-*/{,**} rwkl,
owner /tmp/qutebrowser-downloads-*/{,**} rw,
include <abstractions/devices-u2f>
@{run}/udev/data/+hid:* r,
@{sys}/bus/*/devices/ r,
@{sys}/class/*/ r,
@{sys}/devices/**/uevent r,
owner @{user_config_dirs}/dotfiles/style.json r,
include <abstractions/audio-client>
owner @{user_cache_dirs}/event-sound-cache.tdb.* rwk,
deny /dev/tty r,
