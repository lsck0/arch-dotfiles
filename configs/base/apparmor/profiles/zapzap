# managed by arch-dotfiles/apparmor

abi <abi/4.0>,

include <tunables/global>

@{att} = ""

@{domain} = org.chromium.Chromium

@{exec_path} = @{bin}/zapzap
profile zapzap @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base-strict>
  include <abstractions/audio-client>
  include <abstractions/common/chromium>
  include <abstractions/desktop>
  include <abstractions/graphics>
  include <abstractions/nameservice-strict>
  include <abstractions/python>
  include <abstractions/ssl_certs>
  include <abstractions/user-download-strict>
  include <abstractions/user-read-strict>

  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,
  network netlink raw,

  unix (bind, listen) type=stream,

  @{exec_path} mr,
  @{python_path} rix,
  @{lib}/qt6/{,libexec/}QtWebEngineProcess rix,

  @{open_path} rPx -> child-open-strict,

  owner @{user_config_dirs}/ZapZap/{,**} rwkl,
  owner @{user_share_dirs}/ZapZap/{,**} rwkl,
  owner @{user_cache_dirs}/ZapZap/{,**} rwkl,
  deny @{user_config_dirs}/chromium/{,**} r,

  owner /tmp/zapzap* rw,

  owner @{user_documents_dirs}/{,**} rwl,
  owner @{user_music_dirs}/{,**} rwl,
  owner @{user_pictures_dirs}/{,**} rwl,
  owner @{user_videos_dirs}/{,**} rwl,
  owner @{HOME}/sync/coms/{,**} rwl,
  include <abstractions/dotfiles/deny-sensitive-home>
  /usr/share/qt6/qtwebengine_dictionaries/{,**} r,
  include <abstractions/dotfiles/nssdb>

  deny /dev/tty r,

  include if exists <local/zapzap>
}
