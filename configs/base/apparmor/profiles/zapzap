# managed by arch-dotfiles/apparmor
# zapzap, the whatsapp client: python and qtwebengine, after apparmor.d's qutebrowser

abi <abi/4.0>,

include <tunables/global>

# apparmor.d's abstractions prefix some paths with it, its built profiles set it empty
@{att} = ""

@{domain} = org.chromium.Chromium

@{exec_path} = @{bin}/zapzap
profile zapzap @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base-strict>
  include <abstractions/audio-client>
  include <abstractions/common/chromium>
  include <abstractions/desktop>
  include <abstractions/graphics>
  include <abstractions/nameservice-strict>
  include <abstractions/python>
  include <abstractions/ssl_certs>
  include <abstractions/user-download-strict>
  include <abstractions/user-read-strict>

  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,
  network netlink raw,

  # the single-instance socket
  unix (bind, listen) type=stream,

  @{exec_path} mr,
  @{python_path} rix,
  @{lib}/qt6/{,libexec/}QtWebEngineProcess rix,

  @{open_path} rPx -> child-open-strict,

  # l: QSaveFile and qt's shader cache write an O_TMPFILE and link it into place (settings, dictionaries, shaders);
  # the tmpfile is a deleted entry, mediate_deleted lets these rules name it (#<inode>) instead of refusing the link
  owner @{user_config_dirs}/ZapZap/{,**} rwkl,
  owner @{user_share_dirs}/ZapZap/{,**} rwkl,
  owner @{user_cache_dirs}/ZapZap/{,**} rwkl,
  # QtWebEngine looks for chromium's widevine beside its own profile; zapzap plays no drm content
  deny @{user_config_dirs}/chromium/{,**} r,

  owner /tmp/zapzap* rw,

  # saving where the save dialog points, beside downloads
  owner @{user_documents_dirs}/{,**} rwl,
  owner @{user_music_dirs}/{,**} rwl,
  owner @{user_pictures_dirs}/{,**} rwl,
  owner @{user_videos_dirs}/{,**} rwl,
  owner @{user_sync_dirs}/{,**} rwl,
  # qtwebengine's spellcheck dictionaries
  /usr/share/qt6/qtwebengine_dictionaries/{,**} r,
  include <abstractions/dotfiles/nssdb>

  # qt opens the controlling terminal only to decide whether its log goes to stderr or the journal; a chat client of
  # other people's messages gets no read of the terminal's input, quietly, the journal it is
  deny /dev/tty r,

  include if exists <local/zapzap>
}
