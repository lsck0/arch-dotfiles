# managed by arch-dotfiles/apparmor

abi <abi/4.0>,

include <tunables/global>

@{att} = ""

@{exec_path} = @{bin}/bookokrat
profile bookokrat @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base-strict>
  include <abstractions/consoles>
  include <abstractions/dotfiles/viewer-read>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/nameservice-strict>
  include <abstractions/user-read-strict>
  include <abstractions/wayland-strict>

  @{exec_path} mr,

  @{open_path} rPx -> child-open-strict,
  @{bin}/wl-copy rix,
  deny @{bin}/tmux x,

  owner @{user_config_dirs}/bookokrat/{,**} rw,
  owner @{user_share_dirs}/bookokrat/{,**} rwk,
  owner @{user_cache_dirs}/bookokrat/{,**} rwk,
  owner @{user_state_dirs}/bookokrat/{,**} rwk,
  owner @{HOME}/.bookokrat_settings.yaml{,.bak} rw,

  owner /dev/shm/bookokrat_* rw,
  owner /dev/shm/probev2-* rw,
  owner /tmp/bookokrat-stx-*.sock rw,

  include if exists <local/bookokrat>
}
