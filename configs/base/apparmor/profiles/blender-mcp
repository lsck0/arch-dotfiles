# managed by arch-dotfiles/apparmor

abi <abi/4.0>,

include <tunables/global>

@{att} = ""

@{uv_tools} = @{HOME}/.local/share/uv/tools
@{uv_python} = @{HOME}/.local/share/uv/python/cpython-*

@{exec_path} = @{uv_tools}/blender-mcp/bin/blender-mcp
profile blender-mcp @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base-strict>
  include <abstractions/nameservice-strict>
  include <abstractions/dotfiles/deny-sensitive-home>

  network inet stream,
  network inet6 stream,
  network netlink raw,

  @{exec_path} r,
  @{uv_tools}/blender-mcp/bin/python{,@{int},@{int}.@{int}} mrix,
  @{uv_python}/bin/python@{int}.@{int} mrix,

  @{uv_tools}/blender-mcp/{,**} r,
  @{uv_tools}/blender-mcp/**.so{,.*} mr,
  @{uv_python}/{,**} r,
  @{uv_python}/**.so{,.*} mr,
  deny @{uv_tools}/blender-mcp/**/__pycache__/{,**} w,

  owner @{PROC}/@{pid}/cgroup r,
  @{sys}/fs/cgroup/**/cpu.max r,

  deny @{shells_path} x,
  deny @{bin}/{env,node,nodejs,deno,bun,perl,ruby,lua*,php*} x,

  include if exists <local/blender-mcp>
}
