# managed by arch-dotfiles/apparmor
# 7-Zip: every archive format yazi previews and file managers unpack

abi <abi/4.0>,

include <tunables/global>

# apparmor.d's abstractions prefix some paths with it, its built profiles set it empty
@{att} = ""

@{exec_path} = @{bin}/7z{,a,r} @{lib}/7zip/7z{,a,r}
profile 7z @{exec_path} flags=(attach_disconnected) {
  include <abstractions/dotfiles/file-tool>

  @{exec_path} mrix,
  @{sh_path} rix,
  @{lib}/7zip/{,**} mr,

  include if exists <local/7z>
}
