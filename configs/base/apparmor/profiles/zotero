# managed by arch-dotfiles/apparmor

abi <abi/4.0>,

include <tunables/global>

@{att} = ""

@{zotero_lib} = /usr/lib/zotero
@{exec_path} = @{zotero_lib}/{zotero,zotero-bin}
profile zotero @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base-strict>
  include <abstractions/audio-client>
  include <abstractions/desktop>
  include <abstractions/dconf-write>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/graphics>
  include <abstractions/mesa>
  include <abstractions/nameservice-strict>
  include <abstractions/opengl>
  include <abstractions/ssl_certs>
  include <abstractions/user-read-strict>
  include <abstractions/user-download-strict>
  include <abstractions/dotfiles/deny-sensitive-home>
  include <abstractions/dotfiles/viewer-read>

  userns,

  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,
  network netlink raw,

  @{exec_path} mr,
  @{sh_path} rix,
  @{bin}/{dirname,readlink,basename} rix,
  @{zotero_lib}/{,**} r,
  @{zotero_lib}/**.so{,.*} mr,
  @{zotero_lib}/{zotero-bin,crashhelper,glxtest,vaapitest,plugin-container,updater,minidump-analyzer} rix,

  @{open_path} rPx -> child-open,

  owner @{HOME}/.zotero/{,**} rwkl,
  owner @{user_share_dirs}/zotero/{,**} rwkl,
  owner @{HOME}/Zotero/{,**} rwkl,
  owner @{user_cache_dirs}/zotero/{,**} rwkl,

  owner /tmp/MozillaUpdateLock-* rwk,
  owner /tmp/zotero/{,**} rwk,

  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/fd/ r,
  @{sys}/devices/virtual/dmi/id/product_{name,sku,family,version,uuid} r,

  @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/**/{cpu.max,memory.max,memory.high} r,

  deny capability sys_admin,

  owner @{PROC}/@{pid}/stat r,
  owner @{PROC}/@{pid}/task/@{tid}/stat r,
  owner @{PROC}/@{pid}/oom_score_adj rw,

  owner /dev/shm/org.mozilla.* rw,
  owner /tmp/Zotero-* rwk,
  owner @{tmp}/@{hex}.mozrunner/{,**} rwk,

  deny /dev/tty rw,

  include if exists <local/zotero>
}
