# managed by arch-dotfiles/apparmor
# apparmor.d's qutebrowser profile, built, with one change: the mode. apparmor.d 0.4914.0-1.2 started shipping
# qutebrowser as an explicit `flags=(unconfined)` stub ("this profile allows everything and only exists to give
# the application a name instead of having the label unconfined") even though the real ruleset below is still
# in the package (usr/share/apparmor.d/profiles-m-r/qutebrowser, byte-identical to 1.1) — just no longer wired to
# enforce by apparmor.d's own build. aa-install skips its own copy (ignore.d, mod.nu); refresh this file from
# /usr/share/apparmor.d when apparmor.d changes the real ruleset

# apparmor.d - Full set of apparmor profiles
# Copyright (C) 2026 Alexandre Pujol <alexandre@pujol.io>
# SPDX-License-Identifier: GPL-2.0-only

abi <abi/4.0>,

include <tunables/global>

@{domain} = org.chromium.Chromium

@{exec_path} = @{bin}/qutebrowser
@{att} = ""
profile qutebrowser /{,usr/}bin/qutebrowser flags=(attach_disconnected) {
  include <abstractions/base-strict>
  include <abstractions/common/chromium>
  include <abstractions/desktop>
  include <abstractions/graphics>
  include <abstractions/nameservice-strict>
  include <abstractions/python>
  include <abstractions/ssl_certs>
  include <abstractions/user-download-strict>

  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,
  network netlink raw,

  unix (bind listen) type=stream,

  @{exec_path} mrix,

  @{python_path} rix,
  @{lib}/qt6/{,libexec/}QtWebEngineProcess ix,

  owner @{user_config_dirs}/chromium/WidevineCdm/** mr,
  owner @{user_config_dirs}/qutebrowser/ rw,
  owner @{user_config_dirs}/qutebrowser/** rwlk -> @{user_config_dirs}/qutebrowser/**,

  owner @{user_cache_dirs}/qutebrowser/ w,
  owner @{user_cache_dirs}/qutebrowser/** rw,

  owner @{user_share_dirs}/qutebrowser/ rw,
  owner @{user_share_dirs}/qutebrowser/** rwlk -> @{user_share_dirs}/qutebrowser/**,

  owner @{run}/user/@{uid}/qutebrowser/ w,
  owner @{run}/user/@{uid}/qutebrowser/ipc-* w,

  include if exists <local/qutebrowser>
}

# vim:syntax=apparmor
