# managed by arch-dotfiles/apparmor

abi <abi/4.0>,

include <tunables/global>

@{att} = ""

@{domain} = org.chromium.Chromium
@{lib_dirs} = /opt/onlyoffice/desktopeditors

@{exec_path} = @{bin}/{onlyoffice-desktopeditors,desktopeditors} @{lib_dirs}/DesktopEditors
profile onlyoffice @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base-strict>
  include <abstractions/audio-client>
  include <abstractions/common/chromium>
  include <abstractions/cups-client>
  include <abstractions/desktop>
  include <abstractions/dotfiles/viewer-read>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/graphics>
  include <abstractions/nameservice-strict>
  include <abstractions/user-download-strict>
  include <abstractions/user-read-strict>
  include <abstractions/user-write-strict>

  network netlink raw,
  network inet dgram,
  network inet6 dgram,

  @{exec_path} mrix,
  @{sh_path} rix,
  @{lib_dirs}/{,**} mr,
  @{lib_dirs}/{editors_helper,converter/x2t} rix,

  @{open_path} rPx -> child-open-strict,
  deny /dev/tty rw,

  owner @{user_config_dirs}/onlyoffice/{,**} rwk,
  owner @{user_share_dirs}/onlyoffice/{,**} rwk,
  owner @{user_cache_dirs}/onlyoffice/{,**} rwk,

  owner /tmp/** rwk,

  @{PROC}/ r,
  @{PROC}/@{pid}/{,stat,statm,status,cmdline} r,
  @{PROC}/@{pid}/fd/ r,
  @{PROC}/@{pid}/task/ r,
  @{PROC}/sys/fs/inotify/max_user_watches r,
  @{PROC}/sys/kernel/yama/ptrace_scope r,
  ptrace (read) peer=onlyoffice,

  include if exists <local/onlyoffice>
}
