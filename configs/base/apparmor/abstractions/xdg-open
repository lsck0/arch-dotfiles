# managed by arch-dotfiles/apparmor

  abi <abi/4.0>,

  @{bin}/xdg-mime rix,
  @{bin}/{awk,gawk,basename,cat,cut,dirname,grep,head,hostname,printf,readlink,realpath,sed,tr,uname} rix,
  @{bin}/file rix,
  /usr/share/file/{,**} r,
  include <abstractions/user-read-strict>
  include <abstractions/dotfiles/viewer-read>

  deny @{bin}/{dbus-send,xprop} rx,
  @{PROC}/version r,

  include if exists <abstractions/dotfiles/xdg-open.d>
