# managed by arch-dotfiles/apparmor

  abi <abi/4.0>,

  deny @{user_ssh_dirs}/{,**}             mrwkl,
  deny @{user_gpg_dirs}/{,**}             mrwkl,
  deny @{user_passwordstore_dirs}/{,**}   mrwkl,
  deny @{user_sync_dirs}/password-store/{,**}  mrwkl,
  deny @{user_sync_dirs}/monero/{,**}          mrwkl,
  deny @{user_sync_dirs}/vault.hc              mrwkl,
  deny @{user_sync_dirs}/scripts/{,**}         mrwkl,
  deny @{user_config_dirs}/age/{,**}      mrwkl,
  deny @{HOME}/.age{,/{,**}}              mrwkl,
  deny @{HOME}/.age-*{,/{,**}}            mrwkl,
  deny @{HOME}/.rage{,/{,**}}             mrwkl,
  deny @{HOME}/*.age                      mrwkl,
  deny @{HOME}/.*aws*{,/{,**}}            mrwkl,
  deny @{HOME}/.aws/{,**}                 mrwkl,
  deny @{HOME}/.*pki*{,/{,**}}            mrwkl,
  deny @{HOME}/.*cert*{,/{,**}}           mrwkl,
  deny @{HOME}/.claude/.credentials.json  mrwkl,

  deny @{run}/user/@{uid}/keyring**       mrwkl,
  deny @{HOME}/.gnome2/keyrings/{,**}     mrwkl,
  deny @{HOME}/.local/share/keyrings/{,**} mrwkl,
  deny @{user_share_dirs}/kwalletd/{,**}  mrwkl,
  deny @{HOME}/.kde{,4}/share/apps/kwallet/{,**} mrwkl,

  deny @{HOME}/projects/arch-dotfiles/.git/git-crypt/{,**} mrwkl,
  deny @{HOME}/projects/arch-dotfiles/.git/modules/configs/secrets/git-crypt/{,**} mrwkl,
  deny @{HOME}/projects/arch-dotfiles/configs/secrets/{,**} mrwkl,

  include if exists <abstractions/dotfiles/deny-sensitive-home.d>
