# managed by arch-dotfiles/apparmor

  abi <abi/4.0>,

  include <abstractions/base-strict>
  include <abstractions/nameservice-strict>

  unix (create, connect, send, receive, getattr, getopt, setopt, shutdown) type=stream,
  owner @{run}/user/@{uid}/gnupg/ r,
  owner @{run}/user/@{uid}/gnupg/{,d.*/}S.{gpg-agent,keyboxd,dirmngr} rw,

  @{bin}/gpg{,2} mrix,
  @{bin}/gpgconf mrix,
  @{bin}/gpgsm   mrix,

  /etc/gnupg/{,**} r,
  /usr/share/gnupg/{,**} r,

  owner @{HOME}/.gnupg/ r,
  owner @{HOME}/.gnupg/** rwkl -> @{HOME}/.gnupg/**,
  deny @{HOME}/.gnupg/{*.conf,sshcontrol} wl,

  include if exists <abstractions/dotfiles/gpg-client.d>
