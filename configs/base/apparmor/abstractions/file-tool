# managed by arch-dotfiles/apparmor

  abi <abi/4.0>,

  include <abstractions/base-strict>
  include <abstractions/consoles>
  include <abstractions/dotfiles/deny-sensitive-home>
  include <abstractions/nameservice-strict>

  / r,
  /** r,

  owner @{HOME}/** rwk,
  owner @{HOME}/** l -> @{HOME}/**,
  owner /tmp/** rwk,
  owner /tmp/** l -> /tmp/**,
  owner /var/tmp/** rwk,

  deny @{HOME}/.{profile,bash_profile,bash_login,bashrc,bash_logout,zshenv,zprofile,zshrc,zlogin,zlogout} w,
  deny @{HOME}/.{xprofile,xinitrc,xsession,pam_environment} w,
  deny @{user_config_dirs}/{autostart,systemd,environment.d,zsh,fish,nushell,hypr,uwsm,git,quickshell,tmux,ghostty}/{,**} w,
  deny @{user_config_dirs}/{mimeapps.list,user-dirs.dirs} w,
  deny @{user_bin_dirs}/{,**} w,
  deny @{user_share_dirs}/{opam/*,jai,cargo,go,ghcup,caveman,flatpak/exports,android-sdk/*}/bin/{,**} w,
  # the real dirs where base/xdg has not linked them into the share dir (cargo, ghcup, jai) or migration 0008 left ~/.go
  deny @{HOME}/.{cargo,go,ghcup,jai}/bin/{,**} w,
  deny @{user_share_dirs}/{applications,dbus-1,systemd}/{,**} w,
  # all of nvim's data dir but mason/staging, where mason runs unzip to unpack every LSP it installs
  deny @{user_share_dirs}/nvim/{,*} w,
  deny @{user_share_dirs}/nvim/{[^m]*,m,m[^a]*,ma,ma[^s]*,mas,mas[^o]*,maso,maso[^n]*,mason?*}/** w,
  deny @{user_share_dirs}/nvim/mason/{,*} w,
  deny @{user_share_dirs}/nvim/mason/{[^s]*,s,s[^t]*,st,st[^a]*,sta,sta[^g]*,stag,stag[^i]*,stagi,stagi[^n]*,stagin,stagin[^g]*,staging?*}/** w,
  deny @{HOME}/.claude/{,**} w,
  deny @{HOME}/projects/arch-dotfiles/{,**} w,
  deny @{user_projects_dirs}/*/.identity/{,**} w,
  # git runs hooks and config's core.* commands; ** reaches nested repos and .git/modules/* of submodules
  deny @{user_projects_dirs}/**/.git/{hooks/{,**},config} w,
  deny @{user_projects_dirs}/**/.git/modules/**/{hooks/{,**},config} w,
  deny @{user_state_dirs}/pki/{,**} mrwkl,

  include if exists <abstractions/dotfiles/file-tool.d>
