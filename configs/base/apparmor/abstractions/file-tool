# managed by arch-dotfiles/apparmor

  abi <abi/4.0>,

  include <abstractions/base-strict>
  include <abstractions/consoles>
  include <abstractions/dotfiles/deny-sensitive-home>
  include <abstractions/nameservice-strict>

  / r,
  /** r,

  owner @{HOME}/** rwk,
  owner @{HOME}/** l -> @{HOME}/**,
  owner /tmp/** rwk,
  owner /tmp/** l -> /tmp/**,
  owner /var/tmp/** rwk,
  # /dev/shm is scratch like /tmp: image and video work staged in RAM
  owner /dev/shm/** rwk,

  deny @{HOME}/.{profile,bash_profile,bash_login,bashrc,bash_logout,zshenv,zprofile,zshrc,zlogin,zlogout} w,
  deny @{HOME}/.{xprofile,xinitrc,xsession,pam_environment} w,
  deny @{user_config_dirs}/{autostart,systemd,environment.d,zsh,fish,nushell,hypr,uwsm,git,quickshell,tmux,ghostty}/{,**} w,
  deny @{user_config_dirs}/{mimeapps.list,user-dirs.dirs} w,
  deny @{user_bin_dirs}/{,**} w,
  deny @{user_share_dirs}/{opam/*,jai,cargo,go,ghcup,caveman,flatpak/exports,android-sdk/*}/bin/{,**} w,
  # the real dirs base/xdg has not linked into the share dir (cargo, ghcup, jai), and a ~/.go from before GOPATH moved
  deny @{HOME}/.{cargo,go,ghcup,jai}/bin/{,**} w,
  deny @{user_share_dirs}/{applications,dbus-1,systemd}/{,**} w,
  # all of nvim's data dir but mason/staging, where mason runs unzip to unpack every LSP it installs
  deny @{user_share_dirs}/nvim/{,*} w,
  deny @{user_share_dirs}/nvim/{[^m]*,m,m[^a]*,ma,ma[^s]*,mas,mas[^o]*,maso,maso[^n]*,mason?*}/** w,
  deny @{user_share_dirs}/nvim/mason/{,*} w,
  deny @{user_share_dirs}/nvim/mason/{[^s]*,s,s[^t]*,st,st[^a]*,sta,sta[^g]*,stag,stag[^i]*,stagi,stagi[^n]*,stagin,stagin[^g]*,staging?*}/** w,
  deny @{HOME}/.claude/{,**} w,
  # claude code starts the mcp servers and hooks these name, unconfined and without asking
  deny @{HOME}/.claude.json{,.backup*} w,
  deny @{user_projects_dirs}/**/.claude/{,**} w,
  deny @{user_projects_dirs}/**/.mcp.json w,
  # ~/.nix-profile/bin is on PATH ahead of /usr/bin; vscode-oss runs its extensions
  deny @{HOME}/.nix-profile w,
  deny @{user_state_dirs}/nix/{,**} w,
  deny @{user_share_dirs}/vscode-oss/{,**} w,
  deny @{user_projects_dirs}/*/.identity/{,**} w,
  include <abstractions/dotfiles/deny-exec-later>
  # agent hooks, direnv's own rc and the MCP servers' installs, all started unconfined
  deny @{user_config_dirs}/{idle-guards,direnv}/{,**} w,
  deny @{user_share_dirs}/{web-mcp,mcp-grafana,mcp-compat,obs-mcp,pgedge-postgres-mcp,uv}/{,**} w,
  deny @{user_cache_dirs}/uv/{,**} w,
  deny @{HOME}/.ZAP/plugin/{,**} w,
  deny @{user_state_dirs}/pki/{,**} mrwkl,
  # not in deny-sensitive-home: the browsers, mail and chat profiles include it and a deny would outrank their own rules
  deny @{user_config_dirs}/{mozilla,thunderbird,chromium,BraveSoftware,google-chrome,Element,Signal,discord,Proton}/{,**} mrwkl,
  deny @{user_share_dirs}/{mozilla,librewolf,zen,qutebrowser,TelegramDesktop}/{,**} mrwkl,
  deny @{user_config_dirs}/task/{sync.taskrc,calendar.env} mrwkl,
  deny @{user_config_dirs}/nushell/history.txt mrwkl,
  deny @{user_state_dirs}/zsh/{,**} mrwkl,

  include if exists <abstractions/dotfiles/file-tool.d>
