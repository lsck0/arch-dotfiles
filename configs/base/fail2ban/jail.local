[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime = 3600
findtime = 600
maxretry = 5
# own table inet f2b-table instead of chains inside the iptables-nft tables portmaster manages
banaction = nftables-multiport
banaction_allports = nftables-allports

[sshd]
enabled = true
# 22 is the endlessh decoy
port = 2222
backend = systemd
