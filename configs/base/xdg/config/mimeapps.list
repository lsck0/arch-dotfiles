# the default app per type: viewers over editors (krita, inkscape, gimp register for every image and csv),
# office formats in onlyoffice; types left out fall back to whichever app registered them

[Added Associations]
application/pdf=@PDF_VIEWER_FIRST@
inode/directory=@FILE_MANAGER_FIRST@
x-scheme-handler/curseforge=curseforge.desktop;

[Default Applications]
# office: onlyoffice, libreoffice as the fallback
text/csv=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
text/tab-separated-values=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
application/vnd.ms-excel=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
application/vnd.oasis.opendocument.spreadsheet=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
application/msword=onlyoffice-desktopeditors.desktop;libreoffice-writer.desktop;
application/vnd.openxmlformats-officedocument.wordprocessingml.document=onlyoffice-desktopeditors.desktop;libreoffice-writer.desktop;
application/vnd.oasis.opendocument.text=onlyoffice-desktopeditors.desktop;libreoffice-writer.desktop;
application/rtf=onlyoffice-desktopeditors.desktop;libreoffice-writer.desktop;
application/vnd.ms-powerpoint=onlyoffice-desktopeditors.desktop;libreoffice-impress.desktop;
application/vnd.openxmlformats-officedocument.presentationml.presentation=onlyoffice-desktopeditors.desktop;libreoffice-impress.desktop;
application/vnd.oasis.opendocument.presentation=onlyoffice-desktopeditors.desktop;libreoffice-impress.desktop;
# documents
application/pdf=@PDF_VIEWER@
x-scheme-handler/pdf=@PDF_VIEWER@
application/epub+zip=okularApplication_epub.desktop;
application/x-mobipocket-ebook=okularApplication_mobi.desktop;
image/vnd.djvu=okularApplication_djvu.desktop;
image/vnd.djvu+multipage=okularApplication_djvu.desktop;
# images: viewers, never the editors
image/jpeg=@IMAGE_VIEWER@
image/png=@IMAGE_VIEWER@
image/gif=@IMAGE_VIEWER@
image/webp=@IMAGE_VIEWER@
image/bmp=@IMAGE_VIEWER@
image/tiff=@IMAGE_VIEWER@
image/avif=@IMAGE_VIEWER@
image/heif=@IMAGE_VIEWER@
image/jxl=@IMAGE_VIEWER@
image/svg+xml=@IMAGE_VIEWER@
image/vnd.microsoft.icon=@IMAGE_VIEWER@
# camera raw: the raw developer
image/x-canon-cr2=rawtherapee.desktop;
image/x-canon-cr3=rawtherapee.desktop;
image/x-nikon-nef=rawtherapee.desktop;
image/x-sony-arw=rawtherapee.desktop;
image/x-adobe-dng=rawtherapee.desktop;
image/x-fuji-raf=rawtherapee.desktop;
image/x-olympus-orf=rawtherapee.desktop;
image/x-panasonic-rw2=rawtherapee.desktop;
# audio and video
video/mp4=@MEDIA_PLAYER@
video/x-matroska=@MEDIA_PLAYER@
video/webm=@MEDIA_PLAYER@
video/quicktime=@MEDIA_PLAYER@
video/vnd.avi=@MEDIA_PLAYER@
video/mpeg=@MEDIA_PLAYER@
video/ogg=@MEDIA_PLAYER@
video/x-flv=@MEDIA_PLAYER@
video/3gpp=@MEDIA_PLAYER@
audio/mpeg=@MEDIA_PLAYER@
audio/ogg=@MEDIA_PLAYER@
audio/flac=@MEDIA_PLAYER@
audio/vnd.wave=@MEDIA_PLAYER@
audio/x-opus+ogg=@MEDIA_PLAYER@
audio/aac=@MEDIA_PLAYER@
audio/mp4=@MEDIA_PLAYER@
audio/x-vorbis+ogg=@MEDIA_PLAYER@
# archives
application/zip=org.kde.ark.desktop;
application/x-7z-compressed=org.kde.ark.desktop;
application/x-tar=org.kde.ark.desktop;
application/x-compressed-tar=org.kde.ark.desktop;
application/x-bzip2-compressed-tar=org.kde.ark.desktop;
application/x-xz-compressed-tar=org.kde.ark.desktop;
application/x-zstd-compressed-tar=org.kde.ark.desktop;
application/vnd.rar=org.kde.ark.desktop;
application/gzip=org.kde.ark.desktop;
application/x-xz=org.kde.ark.desktop;
application/zstd=org.kde.ark.desktop;
# text, source and config
text/plain=@EDITOR@
text/markdown=@EDITOR@
text/x-log=@EDITOR@
text/x-readme=@EDITOR@
text/x-shellscript=@EDITOR@
application/x-shellscript=@EDITOR@
application/json=@EDITOR@
application/yaml=@EDITOR@
application/toml=@EDITOR@
application/xml=@EDITOR@
text/x-python=@EDITOR@
text/x-lua=@EDITOR@
text/x-tex=@EDITOR@
text/x-csrc=@EDITOR@
text/x-chdr=@EDITOR@
text/x-c++src=@EDITOR@
text/x-c++hdr=@EDITOR@
text/rust=@EDITOR@
text/x-go=@EDITOR@
text/x-nix=@EDITOR@
text/javascript=@EDITOR@
application/typescript=@EDITOR@
text/css=@EDITOR@
text/x-scss=@EDITOR@
text/x-java=@EDITOR@
text/x-csharp=@EDITOR@
text/x-haskell=@EDITOR@
text/x-ocaml=@EDITOR@
text/x-kotlin=@EDITOR@
application/x-perl=@EDITOR@
application/x-ruby=@EDITOR@
application/x-php=@EDITOR@
application/sql=@EDITOR@
text/x-patch=@EDITOR@
text/x-makefile=@EDITOR@
text/x-cmake=@EDITOR@
text/x-dockerfile=@EDITOR@
text/x-meson=@EDITOR@
text/x-systemd-unit=@EDITOR@
application/x-desktop=@EDITOR@
application/x-subrip=@EDITOR@
application/x-zerosize=@EDITOR@
# fonts
font/ttf=com.github.FontManager.FontViewer.desktop;
font/otf=com.github.FontManager.FontViewer.desktop;
font/woff=com.github.FontManager.FontViewer.desktop;
font/woff2=com.github.FontManager.FontViewer.desktop;
# torrents, mail, calendar, contacts
application/x-bittorrent=org.qbittorrent.qBittorrent.desktop;
x-scheme-handler/magnet=org.qbittorrent.qBittorrent.desktop;
x-scheme-handler/mailto=proton-mail.desktop;
message/rfc822=org.mozilla.Thunderbird.desktop;
text/vcard=org.mozilla.Thunderbird.desktop;
text/calendar=org.gnome.Calendar.desktop;
# web
text/html=@BROWSER@
application/xhtml+xml=@BROWSER@
application/x-www-form-urlencoded=@BROWSER@
x-scheme-handler/http=@BROWSER@
x-scheme-handler/https=@BROWSER@
x-scheme-handler/about=@BROWSER@
x-scheme-handler/unknown=@BROWSER@
# files
inode/directory=@FILE_MANAGER@
# apps that register their own links
x-scheme-handler/betterdiscord=discord.desktop;
x-scheme-handler/jetbrains=jetbrains-toolbox.desktop;
x-scheme-handler/ror2mm=r2modman.desktop;
x-scheme-handler/claude-cli=claude-code-url-handler.desktop
application/x-uproject=unreal-engine.desktop;
x-scheme-handler/proton-inbox=proton-mail.desktop;
x-scheme-handler/proton-meet=proton-meet.desktop;
x-scheme-handler/bruno=bruno.desktop;
x-scheme-handler/curseforge=curseforge.desktop;

