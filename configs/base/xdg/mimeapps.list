# the default app per type: viewers over editors (krita, inkscape, gimp register for every image and csv),
# office formats in onlyoffice; types left out fall back to whichever app registered them

[Added Associations]
application/pdf=org.kde.okular.desktop;
inode/directory=org.kde.dolphin.desktop;
x-scheme-handler/curseforge=curseforge.desktop;

[Default Applications]
# office: onlyoffice, libreoffice as the fallback
text/csv=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
text/tab-separated-values=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
application/vnd.ms-excel=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
application/vnd.oasis.opendocument.spreadsheet=onlyoffice-desktopeditors.desktop;libreoffice-calc.desktop;
application/msword=onlyoffice-desktopeditors.desktop;libreoffice-writer.desktop;
application/vnd.openxmlformats-officedocument.wordprocessingml.document=onlyoffice-desktopeditors.desktop;libreoffice-writer.desktop;
application/vnd.oasis.opendocument.text=onlyoffice-desktopeditors.desktop;libreoffice-writer.desktop;
application/rtf=onlyoffice-desktopeditors.desktop;libreoffice-writer.desktop;
application/vnd.ms-powerpoint=onlyoffice-desktopeditors.desktop;libreoffice-impress.desktop;
application/vnd.openxmlformats-officedocument.presentationml.presentation=onlyoffice-desktopeditors.desktop;libreoffice-impress.desktop;
application/vnd.oasis.opendocument.presentation=onlyoffice-desktopeditors.desktop;libreoffice-impress.desktop;
# documents
application/pdf=org.kde.okular.desktop;org.pwmt.zathura.desktop;
x-scheme-handler/pdf=org.kde.okular.desktop;org.pwmt.zathura.desktop;
application/epub+zip=okularApplication_epub.desktop;
application/x-mobipocket-ebook=okularApplication_mobi.desktop;
image/vnd.djvu=okularApplication_djvu.desktop;
image/vnd.djvu+multipage=okularApplication_djvu.desktop;
# images: viewers, never the editors
image/jpeg=feh.desktop;nsxiv.desktop;
image/png=feh.desktop;nsxiv.desktop;
image/gif=feh.desktop;nsxiv.desktop;
image/webp=feh.desktop;nsxiv.desktop;
image/bmp=feh.desktop;nsxiv.desktop;
image/tiff=feh.desktop;nsxiv.desktop;
image/avif=feh.desktop;nsxiv.desktop;
image/heif=feh.desktop;nsxiv.desktop;
image/jxl=feh.desktop;nsxiv.desktop;
image/svg+xml=feh.desktop;nsxiv.desktop;
image/vnd.microsoft.icon=feh.desktop;nsxiv.desktop;
# camera raw: the raw developer
image/x-canon-cr2=rawtherapee.desktop;
image/x-canon-cr3=rawtherapee.desktop;
image/x-nikon-nef=rawtherapee.desktop;
image/x-sony-arw=rawtherapee.desktop;
image/x-adobe-dng=rawtherapee.desktop;
image/x-fuji-raf=rawtherapee.desktop;
image/x-olympus-orf=rawtherapee.desktop;
image/x-panasonic-rw2=rawtherapee.desktop;
# audio and video
