[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = spotify

[Action]
Description = Re-patching Spotify with spicetify (a Spotify update replaces the patched client)
When = PostTransaction
# via link.sh so the class-name fixup runs too
Exec = /usr/bin/runuser -l @USER@ -c 'cd ~/projects/arch-dotfiles/configs/socials/spotify && DOTFILES=~/projects/arch-dotfiles bash ./link.sh'
