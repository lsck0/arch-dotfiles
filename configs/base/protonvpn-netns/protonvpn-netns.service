# managed by arch-dotfiles/protonvpn-netns
[Unit]
Description=ProtonVPN-only network namespace for single apps
After=fw-egress.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/protonvpn-netns/netns up
ExecStop=/usr/local/lib/protonvpn-netns/netns down

[Install]
WantedBy=multi-user.target
