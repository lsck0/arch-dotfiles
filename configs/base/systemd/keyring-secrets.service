[Unit]
Description=Start the secrets component of the pam-started keyring
# the pam daemon (--login) only claims org.freedesktop.secrets once told to --start; without this the first secret-tool
# call (ssh-add's askpass) dbus-activates a second daemon that hands over to it and then idles in --foreground forever
After=graphical-session-pre.target
Before=graphical-session.target ssh-add.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/gnome-keyring-daemon --start --components=secrets

[Install]
WantedBy=graphical-session-pre.target
