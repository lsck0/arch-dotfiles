[Unit]
Description=sched_ext scheduler (scx_lavd)
Documentation=https://github.com/sched-ext/scx
ConditionPathIsDirectory=/sys/kernel/sched_ext
# before the greeter, so a session never switches scheduler mid-login
Before=display-manager.service ly@tty1.service
# eevdf takes over on exit; stop retrying a scheduler that cannot attach
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# follows the epp tlp sets, no restarts needed
ExecStart=/usr/bin/scx_lavd --autopower
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
