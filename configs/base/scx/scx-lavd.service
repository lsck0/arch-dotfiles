[Unit]
Description=sched_ext scheduler (scx_lavd)
Documentation=https://github.com/sched-ext/scx
ConditionPathIsDirectory=/sys/kernel/sched_ext
# attached before the greeter, so a session never starts on eevdf and switches mid-login
Before=display-manager.service ly@tty2.service
# the kernel falls back to eevdf whenever it exits; a scheduler that cannot attach stops retrying
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# the power mode follows the epp tlp sets, no restarts: balanced on ac and battery (power-leaning), powersave in saver
ExecStart=/usr/bin/scx_lavd --autopower
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
