#!/usr/sbin/nft -f
define trusted_ifaces = { "docker*", "br-*", "veth*", "virbr*", "waydroid*", "lxc*", "wg0" }

add table inet fw
delete table inet fw
table inet fw {
    set knock1 { type ipv4_addr; flags timeout; timeout 10s; }
    set knock2 { type ipv4_addr; flags timeout; timeout 10s; }
    set ssh_allowed { type ipv4_addr; flags timeout; timeout @SSH_KNOCK_WINDOW@; }
    set home_ifaces { type ifname; }

    chain input {
        type filter hook input priority 0; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        meta l4proto ipv6-icmp icmpv6 type echo-request limit rate 10/second accept
        meta l4proto ipv6-icmp icmpv6 type != echo-request accept
        meta l4proto ipv6-icmp drop
        ip protocol icmp icmp type echo-request limit rate 5/second accept
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-reply } accept
        ip protocol icmp drop

        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept

        iifname $trusted_ifaces accept
        iifname "tun0" tcp dport { 4444-4454, 4456-4460, 8000-8099, 9001, 9443 } accept

        # the knock is in a public repo, so it only keeps scanners out of sshd's log; publickey-only auth guards sshd
        ip saddr @ssh_allowed tcp dport @SSH_PORT@ ct state new accept
        tcp dport @KNOCK_3@ ip saddr @knock2 update @ssh_allowed { ip saddr }
        tcp dport @KNOCK_2@ ip saddr @knock1 update @knock2 { ip saddr }
        tcp dport @KNOCK_1@ update @knock1 { ip saddr }

        iifname @home_ifaces tcp dport { 22, 9757, 22000, 53317 } accept
        iifname @home_ifaces udp dport { 5353, 9757, 22000, 53317 } accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop
        iifname $trusted_ifaces accept
        iifname @home_ifaces ct status dnat accept
        iifname "tun0" meta l4proto tcp ct original proto-dst { 4444-4454, 4456-4460, 8000-8099, 9001, 9443 } ct status dnat accept
    }
}
