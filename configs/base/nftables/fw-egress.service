[Unit]
Description=Untrusted-network kill switch, owns table inet fw_egress (always on, independent of the firewall toggle)
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '{ cat /etc/nftables.d/fw-egress.nft; [ ! -s /run/home-network ] || echo "add element inet fw_egress home_ifaces { $$(paste -sd, /run/home-network) }"; } | /usr/sbin/nft -f - || exec /usr/sbin/nft -f /etc/nftables.d/fw-egress.nft'
ExecReload=/bin/sh -c '{ cat /etc/nftables.d/fw-egress.nft; [ ! -s /run/home-network ] || echo "add element inet fw_egress home_ifaces { $$(paste -sd, /run/home-network) }"; } | /usr/sbin/nft -f - || exec /usr/sbin/nft -f /etc/nftables.d/fw-egress.nft'
ExecStop=/usr/sbin/nft destroy table inet fw_egress

[Install]
WantedBy=multi-user.target
