[Unit]
# owns table inet fw_egress, independent of the firewall toggle; the escape uids are looked up on every start and reload
Description=Untrusted-network kill switch (lockdown-tor)
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '{ cat /etc/nftables.d/fw-egress.nft; [ ! -s /run/home-network ] || echo "add element inet fw_egress home_ifaces { $$(paste -sd, /run/home-network) }"; u=$$(id -u tor) && echo "add element inet fw_egress tor_uid { $$u }"; u=$$(id -u alpm) && echo "add element inet fw_egress fetch_uid { $$u }"; u=$$(id -u systemd-resolve) && echo "add element inet fw_egress resolver_uid { $$u }"; } | /usr/sbin/nft -f - || exec /usr/sbin/nft -f /etc/nftables.d/fw-egress.nft'
ExecReload=/bin/sh -c '{ cat /etc/nftables.d/fw-egress.nft; [ ! -s /run/home-network ] || echo "add element inet fw_egress home_ifaces { $$(paste -sd, /run/home-network) }"; u=$$(id -u tor) && echo "add element inet fw_egress tor_uid { $$u }"; u=$$(id -u alpm) && echo "add element inet fw_egress fetch_uid { $$u }"; u=$$(id -u systemd-resolve) && echo "add element inet fw_egress resolver_uid { $$u }"; } | /usr/sbin/nft -f - || exec /usr/sbin/nft -f /etc/nftables.d/fw-egress.nft'
ExecStop=/usr/sbin/nft destroy table inet fw_egress

[Install]
WantedBy=multi-user.target
