[Unit]
Description=Inbound lockdown firewall, the resting state until a home network or toggle-firewall.sh lifts it
# shares table inet fw with fw-inbound; a stop is ordered before a start either way, so the old table goes before the new one loads
Conflicts=fw-inbound.service
After=fw-inbound.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/fw-lockdown.nft
# every lockdown starts as the persona dispatcher's, which a home up lifts; toggle-firewall.sh removes it to keep one
ExecStartPost=/usr/bin/touch /run/persona-lockdown
ExecReload=/usr/sbin/nft -f /etc/nftables.d/fw-lockdown.nft
ExecStop=/usr/sbin/nft destroy table inet fw

[Install]
WantedBy=multi-user.target
