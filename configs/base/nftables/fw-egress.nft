#!/usr/sbin/nft -f
# the untrusted-network kill switch, in its own table inet fw_egress so it holds across the fw-inbound/fw-lockdown swap
# and the firewall toggle. traffic leaves through a home link (home-network.sh fills home_ifaces), loopback, a tunnel or
# a local guest. every other link, which includes every link from boot until the home rule decided, carries only what
# gets an address and a tunnel up: dhcp, ndp, the kernel's wireguard packets, the tor daemon, and a portal window opened
# by hand. what leaves through a tunnel is filtered again here as its carrier on the real link

# tunnels, and the local vm/container/waydroid interfaces
define inner_ifaces = { "lo", "proton0", "wg*", "tun*", "docker*", "br-*", "veth*", "virbr*", "waydroid*", "lxc*" }
# the fwmark a tunnel puts on its own udp: protonvpn's (proton.vpn.connection.FWMARK_VALUE) and wg-quick's 51820.
# kept in sync with tor-router
define tunnel_marks = { 0x0ea13b2c, 0x0000ca6c }
# rendered by system.sh; (uid_t)-1 when tor is missing, which no process runs as
define tor_uid = @TOR_UID@

add table inet fw_egress
delete table inet fw_egress
table inet fw_egress {
    # the links on the home network: 70-home-network keeps it in sync, fw-egress.service refills it after a load
    set home_ifaces { type ifname; }
    # captive portal login, only ever by hand (the persona dispatcher's portal verb); an element expires on its own
    set portal { type ifname; flags timeout; }

    # after tor-router's redirect (dstnat), so what it carries is already on lo here
    chain output {
        type filter hook output priority 0; policy drop;
        oifname $inner_ifaces accept
        oifname @home_ifaces accept

        udp sport 68 udp dport 67 accept
        # hoplimit 255: on-link only
        icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 accept
        meta l4proto udp meta mark $tunnel_marks accept
        meta skuid $tor_uid accept
        oifname @portal tcp dport { 80, 443 } accept
        oifname @portal meta l4proto { tcp, udp } th dport 53 accept

        # fail fast instead of hanging; the reject only reaches the local socket
        meta l4proto tcp reject with tcp reset
        reject
    }

    # docker, libvirt and waydroid guests are held to the same rule
    chain forward {
        type filter hook forward priority 0; policy drop;
        oifname $inner_ifaces accept
        oifname @home_ifaces accept
        reject
    }
}
