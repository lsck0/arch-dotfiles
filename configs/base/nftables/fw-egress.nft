#!/usr/sbin/nft -f
define inner_ifaces = { "lo", "proton0", "wg*", "tun*", "docker*", "br-*", "veth*", "virbr*", "waydroid*", "lxc*" }
define tunnel_marks = { 0x0ea13b2c, 0x0000ca6c }
define game_mark = 0x6761

add table inet fw_egress
delete table inet fw_egress
table inet fw_egress {
    set trusted_links { type ifname; }
    set portal { type ifname; flags timeout; }
    # filled by fw-egress.service from id -u, so a user not there yet leaves its set empty instead of failing the load
    set tor_uid { type uid; }
    set fetch_uid { type uid; }
    set resolver_uid { type uid; }

    chain output {
        type filter hook output priority 0; policy drop;
        oifname $inner_ifaces accept
        oifname @trusted_links accept
        # tor-router's redirects into tor's DNSPort and TransPort: the address is rewritten to loopback, but oifname
        # still names the link routed to before the redirect, so lo above misses them. Loopback never leaves the host.
        ip daddr 127.0.0.0/8 accept
        ip6 daddr ::1 accept

        udp sport 68 udp dport 67 accept
        icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 accept
        meta l4proto udp meta mark $tunnel_marks accept
        meta skuid @tor_uid accept
        # Pacman's escape (DownloadUser = alpm): without it a machine missing tor could never install it, and off a
        # trusted network updates work without tor. A foreign network sees which mirror is fetched from and roughly
        # which packages; every package is signature-checked. Under tor-router these connections reach here redirected
        # into tor.
        meta skuid @fetch_uid tcp dport { 80, 443 } accept
        # Its lookups, through resolved, over strict DoT only: the network sees TLS to quad9, never the names. This
        # lets any local app's lookups reach quad9 while tor-router is not up; the apps' own traffic stays dropped.
        meta skuid @resolver_uid tcp dport 853 accept
        meta mark $game_mark accept
        oifname @portal tcp dport { 80, 443 } accept
        oifname @portal meta l4proto { tcp, udp } th dport 53 accept
        oifname @portal tcp dport 853 accept

        meta l4proto tcp reject with tcp reset
        reject
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        oifname $inner_ifaces accept
        oifname @trusted_links accept
        reject
    }
}
