[Unit]
Description=Host firewall, owns table inet fw (coexists with Portmaster)
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/fw-inbound.nft
ExecStartPost=-/bin/sh -c '[ -s /run/trusted-network ] || exit 0; exec /usr/sbin/nft add element inet fw trusted_links "{ $$(paste -sd, /run/trusted-network) }"'
ExecReload=/usr/sbin/nft -f /etc/nftables.d/fw-inbound.nft
ExecReload=-/bin/sh -c '[ -s /run/trusted-network ] || exit 0; exec /usr/sbin/nft add element inet fw trusted_links "{ $$(paste -sd, /run/trusted-network) }"'
ExecStop=/usr/sbin/nft destroy table inet fw

[Install]
WantedBy=multi-user.target
