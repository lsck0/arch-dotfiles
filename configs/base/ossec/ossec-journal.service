[Unit]
Description=Journal auth log for OSSEC logcollector
PartOf=ossec-server.target
Before=ossec-logcollector.service

[Service]
Type=exec
Environment=LC_ALL=C
StateDirectory=ossec-journal
ExecStartPre=-/usr/bin/mv -f /run/ossec-journal.log /run/ossec-journal.log.1
# the daily restart rotates the log; timeout's 124 marks it a success, where RuntimeMaxSec= would fail the unit
ExecStart=/usr/bin/timeout 1d /usr/bin/journalctl --follow --output=short --facility=auth,authpriv --cursor-file=${STATE_DIRECTORY}/cursor
SuccessExitStatus=124
StandardOutput=append:/run/ossec-journal.log
UMask=0077
Restart=always
RestartSec=1s
RestartMode=direct

[Install]
WantedBy=ossec-server.target
