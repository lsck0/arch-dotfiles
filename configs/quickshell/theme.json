{
  "_comment": [
    "Live-watched, save to re-theme. Values here override the code defaults.",
    "Defaults, ranges and meaning: Commons/Theme.qml.",
    "font.size scales the whole shell; icon font is fixed in code.",
    "palette.* conditions wallust colours, it does not replace them."
  ],
  "font": {
    "family": "Kode Mono",
    "size": 12
  },
  "palette": {
    "backgroundValueMin": 0.08,
    "backgroundValueMax": 0.26,
    "foregroundContrast": 7.0,
    "accentMinSaturation": 0.7,
    "accentMinValue": 0.62,
    "accentContrast": 3.0,
    "urgentMinSaturation": 0.55,
    "urgentMinValue": 0.55,
    "urgentContrast": 3.0,
    "mutedContrast": 1.9,
    "transitionMs": 600
  },
  "fx": {
    "glowStrength": 0.22,
    "scanlineOpacity": 0.06,
    "scanlineSpacing": 3,
    "phosphorBias": 0,
    "cornerBrackets": true,
    "crtFlicker": 0.02,
    "matrixRain": 0.5
  }
}
