#!/usr/sbin/nft -f
# owns only table inet fw: portmaster, docker, fail2ban, wg-quick and tor-router keep their own tables

# container, vm and tunnel interfaces trusted like the host itself; tun0 (pentest vpn) is deliberately not here
define trusted_ifaces = { "docker*", "br-*", "veth*", "virbr*", "waydroid*", "lxc*", "wg*" }

add table inet fw
delete table inet fw
table inet fw {
    # knock state resets on reload
    set knock1 { type ipv4_addr; flags timeout; timeout 10s; }
    set knock2 { type ipv4_addr; flags timeout; timeout 10s; }
    set ssh_allowed { type ipv4_addr; flags timeout; timeout 1h; }

    chain input {
        type filter hook input priority 0; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # ndp needs icmpv6; timestamp/address-mask leak host info
        ip6 nexthdr ipv6-icmp accept
        ip protocol icmp icmp type echo-request limit rate 5/second accept
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-reply } accept
        ip protocol icmp drop

        # no rst, so scans see filtered
        tcp dport { 80, 443 } drop

        iifname $trusted_ifaces accept
        # tun0 is the hostile pentest vpn: listener ports only
        iifname "tun0" tcp dport { 4444-4460, 8000-8099, 9001, 9443 } accept

        # sshd on 2222 opens only after knocking 7001, 8002, 9003
        ip saddr @ssh_allowed tcp dport 2222 ct state new accept
        # highest stage first so one packet advances one step
        tcp dport 9003 ip saddr @knock2 update @ssh_allowed { ip saddr }
        tcp dport 8002 ip saddr @knock1 update @knock2 { ip saddr }
        tcp dport 7001 update @knock1 { ip saddr }

        # endlessh 22, kde connect 1716; not all of 10/8, htb is 10.10.x
        ip  saddr { 192.168.178.0/24, 10.100.0.0/16 } tcp dport { 22, 1716 } accept
        ip  saddr { 192.168.178.0/24, 10.100.0.0/16 } udp dport 1716 accept
        ip6 saddr fe80::/10 tcp dport 1716 accept
    }

    # docker, libvirt and waydroid turn ip_forward on, so without this the lan and tun0 could route through this host
    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop
        iifname $trusted_ifaces accept
        # published docker/libvirt ports
        ct status dnat accept
    }
}
