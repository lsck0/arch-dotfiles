{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 4,
      "left": 2,
    },
  },
  "display": {
    "separator": " ",
    "brightColor": true,
    "key": {
      "width": 10,
    },
    "color": {
      "keys": "blue",
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
    },
    {
      "type": "custom",
      "format": "----------------------------------",
      "outputColor": "blue",
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{name} {version}",
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{1} {2} {4}",
    },
    {
      "type": "packages",
      "key": "PKGs",
      "format": "{pacman} packages",
    },
    {
      "type": "cpu",
      "key": "CPU",
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{2}",
      "hideType": "integrated",
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{mountpoint}: {size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "localip",
      "key": "IP",
    },
    {
      "type": "uptime",
      "key": "Uptime",
    },
    {
      "type": "command",
      "key": "Age",
      "text": "echo \"$(( ( $(date +%s) - $(date -d \"$(grep -oP '\\[\\K[^\\]]+' /var/log/pacman.log | head -1)\" +%s) ) / 86400 )) days\"",
    },
    {
      "type": "custom",
      "format": "----------------------------------",
      "outputColor": "blue",
    },
    "break",
  ],
}
