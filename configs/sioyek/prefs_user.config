# alt + left click jumps to that line in the nvim or emacs that has the source open (scripts/synctex-edit.sh)
alt_click_command synctex_under_cursor
inverse_search_command synctex-edit "%1" %2 %3

# one window per pdf: forward search reuses the window already showing it, another pdf opens beside it
should_launch_new_window 1

# visible gap between pages so page breaks are obvious, not one continuous scroll
page_separator_width 8

source ~/.cache/wal/colors-sioyek
