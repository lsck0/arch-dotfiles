config-file=~/.cache/wal/ghostty.conf

app-notifications = false
confirm-close-surface = false

background-opacity = 0.9
# By design, background-opacity alone only affects the WINDOW background —
# any cell with an explicit background color set (tmux's status bar
# repainting its own bg, Hermes' TUI painting its skin's status_bar_bg/
# completion_menu_bg panels) stays fully opaque regardless. nvim looked
# "correctly" transparent only because transparent.nvim clears its
# highlight groups' bg to NONE (no explicit color) rather than actually
# being handled specially. This applies the same opacity to every cell,
# so tmux and Hermes match nvim instead of reading as a solid darker box.
background-opacity-cells = true

font-family = 0xProto Nerd Font
font-size = 16
#delta
adjust-cell-height = -23%

# +100px width over ghostty's implicit default (80 cols): at font-size 16
# each cell is ~10px wide, so 10 extra columns ≈ +100px. Column-based, not
# literal pixels -- ghostty's window-width/window-height only accept grid
# cells (confirmed: "We don't currently support specifying a size in
# pixels" in the option reference), so this is an approximation that holds
# across both Hyprland and Plasma sessions rather than a KWin-only rule.
window-width = 90

mouse-scroll-multiplier = precision:1.5,discrete:1.5

# no dead space under the tmux status bar: drop the default 2pt top/bottom
# padding so one more row fits, and balance the sub-cell remainder
window-padding-y = 0
window-padding-balance = true

# this blocks tab switching in nvim
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+p=unbind
keybind = ctrl+shift+t=unbind

#https://github.com/hackr-sh/ghostty-shaders
#custom-shader=./ghostty-shaders/in-game-crt-cursor.glsl
#custom-shader-animation = false
