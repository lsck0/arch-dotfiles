config-file=~/.cache/wal/ghostty.conf

app-notifications = false
confirm-close-surface = false

background-opacity = 0.9
background-opacity-cells = true

# hackerman terminal: solid blinking block cursor
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

font-family = 0xProto Nerd Font Mono
font-family = Symbols Nerd Font Mono
font-size = 16
#delta
adjust-cell-height = -23%

window-width = 115
window-height = 35

mouse-scroll-multiplier = precision:1.5,discrete:1.5

# no dead space under the tmux status bar: drop the default 2pt top/bottom
# top 0, bottom 10 so the last row isn't clamped to the edge
window-padding-y = 0,10
window-padding-balance = true

# this blocks tab switching in nvim
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+p=unbind
keybind = ctrl+shift+t=unbind

# Accept OSC 52 clipboard writes (default is allow, set explicit) so a yank from
# a remote nvim/tmux/herdr over SSH lands in this laptop's clipboard.
clipboard-write = allow
clipboard-read = allow
