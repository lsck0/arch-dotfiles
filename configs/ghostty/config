config-file=~/.cache/wal/ghostty.conf
# toggle-powermode.sh fills it in power-saver, a dangling link otherwise
config-file=?~/.cache/ghostty-powersave.conf

app-notifications = false
confirm-close-surface = false
# resident systemd instance, +new-window skips the ~2s cold start
quit-after-last-window-closed = false

background-opacity = 1
background-opacity-cells = true

cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

font-family = Kode Mono
font-family = Symbols Nerd Font Mono
font-size = 16

window-width = 115
window-height = 35

mouse-scroll-multiplier = precision:1.5,discrete:1.5

# no gap under the tmux status bar
window-padding-y = 0,0
window-padding-balance = true

# frees these for nvim
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+t=unbind

# osc 52, so remote yanks over ssh reach the local clipboard
clipboard-write = allow
clipboard-read = allow
