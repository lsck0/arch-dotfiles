#!/bin/bash
# transparent tor routing for IPv4 and IPv6 (based on edu4rdshl/tor-router), in its own table inet tor_router
# so portmaster's, docker's and fail2ban's rules stay untouched and stop is a single table delete

set -euo pipefail

TRANS_PORT="9040"
DNS_PORT="6669"
TABLE="tor_router"

case "${1:-}" in
start)
	if ! systemctl is-active tor.service >/dev/null; then
		echo "The tor service is not active, please start the tor service before running the script."
		exit 1
	fi
	TOR_UID=$(id -u tor)

	nft -f - <<NFT
add table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
	# lan and homelab stay direct; 127.192.0.0/10 is tor's default VirtualAddrNetwork and must reach the TransPort
	set direct4 { type ipv4_addr; flags interval; elements = { 192.168.178.0/24, 10.100.0.0/16, 127.0.0.0/9, 127.128.0.0/10 } }
	# link-local and loopback only
	set direct6 { type ipv6_addr; flags interval; elements = { fe80::/10, ::1/128 } }

	# before portmaster's dns redirect at dstnat, so lookups reach tor's DNSPort
	chain nat_output {
		type nat hook output priority dstnat - 10; policy accept;
		meta skuid $TOR_UID return
		udp dport 53 redirect to :$DNS_PORT
		ip daddr @direct4 return
		ip6 daddr @direct6 return
		meta l4proto { tcp, udp } redirect to :$TRANS_PORT
	}

	chain filter_output {
		type filter hook output priority filter; policy accept;
		ct state established,related accept
		ip daddr { 192.168.178.0/24, 10.100.0.0/16, 127.0.0.0/8 } accept
		ip6 daddr @direct6 accept
		meta skuid $TOR_UID accept
		# catch-all so icmp and other protocols cannot leak
		reject
	}
}
NFT
	;;

stop)
	nft destroy table inet "$TABLE"
	;;

restart)
	"$0" stop
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	;;
esac
