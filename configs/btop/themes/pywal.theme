# pywal theme for btop -- GENERATED by generate-btop-theme.sh, edits are overwritten on wallpaper switch.
theme[main_bg]="#0E1016"
theme[main_fg]="#CBC5FB"
theme[title]="#BCACBE"
theme[hi_fg]="#BCACBE"
theme[selected_bg]="#BCACBE"
theme[selected_fg]="#0E1016"
theme[inactive_fg]="#7C77A8"
theme[graph_text]="#CBC5FB"
theme[meter_bg]="#7C77A8"
theme[proc_misc]="#8D88BA"

# one palette hue per box, dim divider
theme[cpu_box]="#BCACBE"
theme[mem_box]="#8D88BA"
theme[net_box]="#A3BBB8"
theme[proc_box]="#ABAE9C"
theme[div_line]="#7C77A8"

# temperature: green through amber to red
theme[temp_start]="#ABAE9C"
theme[temp_mid]="#966EB2"
theme[temp_end]="#7F90BA"

# cpu load: blue through magenta to red
theme[cpu_start]="#BCACBE"
theme[cpu_mid]="#A3BBB8"
theme[cpu_end]="#7F90BA"

# memory: free green, used amber to red, available and cached cool hues
theme[free_start]="#ABAE9C"
theme[free_mid]="#8D88BA"
theme[free_end]="#BCACBE"
theme[used_start]="#966EB2"
theme[used_mid]="#7F90BA"
theme[used_end]="#7F90BA"
theme[available_start]="#8D88BA"
theme[available_mid]="#BCACBE"
theme[available_end]="#A3BBB8"
theme[cached_start]="#A3BBB8"
theme[cached_mid]="#BCACBE"
theme[cached_end]="#8D88BA"

# network: download cyan to blue, upload magenta to red
theme[download_start]="#8D88BA"
theme[download_mid]="#BCACBE"
theme[download_end]="#A3BBB8"
theme[upload_start]="#A3BBB8"
theme[upload_mid]="#7F90BA"
theme[upload_end]="#966EB2"

# process list sweeps the accent hues
theme[process_start]="#BCACBE"
theme[process_mid]="#8D88BA"
theme[process_end]="#ABAE9C"
