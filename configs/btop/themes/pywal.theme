# pywal theme for btop -- GENERATED by generate-btop-theme.sh, edits are overwritten on wallpaper switch.
theme[main_bg]="#100F16"
theme[main_fg]="#D7B6D0"
theme[title]="#6EA0F7"
theme[hi_fg]="#6EA0F7"
theme[selected_bg]="#6EA0F7"
theme[selected_fg]="#100F16"
theme[inactive_fg]="#886B83"
theme[graph_text]="#D7B6D0"
theme[meter_bg]="#886B83"
theme[proc_misc]="#91758C"

# one palette hue per box, dim divider
theme[cpu_box]="#6EA0F7"
theme[mem_box]="#91758C"
theme[net_box]="#A56E95"
theme[proc_box]="#B667A2"
theme[div_line]="#886B83"

# temperature: green through amber to red
theme[temp_start]="#B667A2"
theme[temp_mid]="#677BB4"
theme[temp_end]="#FECCCF"

# cpu load: blue through magenta to red
theme[cpu_start]="#6EA0F7"
theme[cpu_mid]="#A56E95"
theme[cpu_end]="#FECCCF"

# memory: free green, used amber to red, available and cached cool hues
theme[free_start]="#B667A2"
theme[free_mid]="#91758C"
theme[free_end]="#6EA0F7"
theme[used_start]="#677BB4"
theme[used_mid]="#FECCCF"
theme[used_end]="#FECCCF"
theme[available_start]="#91758C"
theme[available_mid]="#6EA0F7"
theme[available_end]="#A56E95"
theme[cached_start]="#A56E95"
theme[cached_mid]="#6EA0F7"
theme[cached_end]="#91758C"

# network: download cyan to blue, upload magenta to red
theme[download_start]="#91758C"
theme[download_mid]="#6EA0F7"
theme[download_end]="#A56E95"
theme[upload_start]="#A56E95"
theme[upload_mid]="#FECCCF"
theme[upload_end]="#677BB4"

# process list sweeps the accent hues
theme[process_start]="#6EA0F7"
theme[process_mid]="#91758C"
theme[process_end]="#B667A2"
