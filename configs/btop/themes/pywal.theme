# pywal theme for btop -- GENERATED by generate-btop-theme.sh, edits are overwritten on wallpaper switch.
theme[main_bg]="#0F0F16"
theme[main_fg]="#F290CE"
theme[title]="#AA6785"
theme[hi_fg]="#AA6785"
theme[selected_bg]="#AA6785"
theme[selected_fg]="#0F0F16"
theme[inactive_fg]="#9E4882"
theme[graph_text]="#F290CE"
theme[meter_bg]="#9E4882"
theme[proc_misc]="#A96894"

# one palette hue per box, dim divider
theme[cpu_box]="#AA6785"
theme[mem_box]="#A96894"
theme[net_box]="#9672AA"
theme[proc_box]="#8678B3"
theme[div_line]="#9E4882"

# temperature: green through amber to red
theme[temp_start]="#8678B3"
theme[temp_mid]="#6A7ABE"
theme[temp_end]="#A16C97"

# cpu load: blue through magenta to red
theme[cpu_start]="#AA6785"
theme[cpu_mid]="#9672AA"
theme[cpu_end]="#A16C97"

# memory: free green, used amber to red, available and cached cool hues
theme[free_start]="#8678B3"
theme[free_mid]="#A96894"
theme[free_end]="#AA6785"
theme[used_start]="#6A7ABE"
theme[used_mid]="#A16C97"
theme[used_end]="#A16C97"
theme[available_start]="#A96894"
theme[available_mid]="#AA6785"
theme[available_end]="#9672AA"
theme[cached_start]="#9672AA"
theme[cached_mid]="#AA6785"
theme[cached_end]="#A96894"

# network: download cyan to blue, upload magenta to red
theme[download_start]="#A96894"
theme[download_mid]="#AA6785"
theme[download_end]="#9672AA"
theme[upload_start]="#9672AA"
theme[upload_mid]="#A16C97"
theme[upload_end]="#6A7ABE"

# process list sweeps the accent hues
theme[process_start]="#AA6785"
theme[process_mid]="#A96894"
theme[process_end]="#8678B3"
