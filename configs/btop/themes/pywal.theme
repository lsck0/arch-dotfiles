# pywal theme for btop -- GENERATED by generate-btop-theme.sh, edits are overwritten on wallpaper switch.
theme[main_bg]="#091114"
theme[main_fg]="#C7C2D8"
theme[title]="#8E7982"
theme[hi_fg]="#8E7982"
theme[selected_bg]="#8E7982"
theme[selected_fg]="#091114"
theme[inactive_fg]="#797689"
theme[graph_text]="#C7C2D8"
theme[meter_bg]="#797689"
theme[proc_misc]="#827E92"

# one palette hue per box, dim divider
theme[cpu_box]="#8E7982"
theme[mem_box]="#827E92"
theme[net_box]="#6D84A3"
theme[proc_box]="#5F8496"
theme[div_line]="#797689"

# temperature: green through amber to red
theme[temp_start]="#5F8496"
theme[temp_mid]="#9E7782"
theme[temp_end]="#847E89"

# cpu load: blue through magenta to red
theme[cpu_start]="#8E7982"
theme[cpu_mid]="#6D84A3"
theme[cpu_end]="#847E89"

# memory: free green, used amber to red, available and cached cool hues
theme[free_start]="#5F8496"
theme[free_mid]="#827E92"
theme[free_end]="#8E7982"
theme[used_start]="#9E7782"
theme[used_mid]="#847E89"
theme[used_end]="#847E89"
theme[available_start]="#827E92"
theme[available_mid]="#8E7982"
theme[available_end]="#6D84A3"
theme[cached_start]="#6D84A3"
theme[cached_mid]="#8E7982"
theme[cached_end]="#827E92"

# network: download cyan to blue, upload magenta to red
theme[download_start]="#827E92"
theme[download_mid]="#8E7982"
theme[download_end]="#6D84A3"
theme[upload_start]="#6D84A3"
theme[upload_mid]="#847E89"
theme[upload_end]="#9E7782"

# process list sweeps the accent hues
theme[process_start]="#8E7982"
theme[process_mid]="#827E92"
theme[process_end]="#5F8496"
