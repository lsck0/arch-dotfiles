# pywal theme for btop -- GENERATED by generate-btop-theme.sh, edits are overwritten on wallpaper switch.
theme[main_bg]="#0B0E14"
theme[main_fg]="#BFBDB6"
theme[title]="#39BAE6"
theme[hi_fg]="#39BAE6"
theme[selected_bg]="#39BAE6"
theme[selected_fg]="#0B0E14"
theme[inactive_fg]="#565B66"
theme[graph_text]="#BFBDB6"
theme[meter_bg]="#565B66"
theme[proc_misc]="#95E6CB"

# Sharp neon frame: one palette hue per box, dim divider.
theme[cpu_box]="#39BAE6"
theme[mem_box]="#95E6CB"
theme[net_box]="#D2A6FF"
theme[proc_box]="#AAD94C"
theme[div_line]="#565B66"

# Temperature: cool green through amber to hot red.
theme[temp_start]="#AAD94C"
theme[temp_mid]="#E6B450"
theme[temp_end]="#F07178"

# CPU load: blue through magenta to red as it climbs.
theme[cpu_start]="#39BAE6"
theme[cpu_mid]="#D2A6FF"
theme[cpu_end]="#F07178"

# Memory: free is green, used is amber-to-red, available/cached are the cool hues.
theme[free_start]="#AAD94C"
theme[free_mid]="#95E6CB"
theme[free_end]="#39BAE6"
theme[used_start]="#E6B450"
theme[used_mid]="#F07178"
theme[used_end]="#F07178"
theme[available_start]="#95E6CB"
theme[available_mid]="#39BAE6"
theme[available_end]="#D2A6FF"
theme[cached_start]="#D2A6FF"
theme[cached_mid]="#39BAE6"
theme[cached_end]="#95E6CB"

# Network: download in cyan-blue, upload in magenta-red.
theme[download_start]="#95E6CB"
theme[download_mid]="#39BAE6"
theme[download_end]="#D2A6FF"
theme[upload_start]="#D2A6FF"
theme[upload_mid]="#F07178"
theme[upload_end]="#E6B450"

# Process list gradient sweeps the accent hues.
theme[process_start]="#39BAE6"
theme[process_mid]="#95E6CB"
theme[process_end]="#AAD94C"
