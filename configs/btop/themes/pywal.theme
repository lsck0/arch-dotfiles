# pywal theme for btop -- GENERATED by generate-btop-theme.sh, edits are overwritten on wallpaper switch.
theme[main_bg]="#1A1B26"
theme[main_fg]="#C0CAF5"
theme[title]="#7AA2F7"
theme[hi_fg]="#7AA2F7"
theme[selected_bg]="#7AA2F7"
theme[selected_fg]="#1A1B26"
theme[inactive_fg]="#414868"
theme[graph_text]="#C0CAF5"
theme[meter_bg]="#414868"
theme[proc_misc]="#7DCFFF"

# one palette hue per box, dim divider
theme[cpu_box]="#7AA2F7"
theme[mem_box]="#7DCFFF"
theme[net_box]="#BB9AF7"
theme[proc_box]="#9ECE6A"
theme[div_line]="#414868"

# temperature: green through amber to red
theme[temp_start]="#9ECE6A"
theme[temp_mid]="#E0AF68"
theme[temp_end]="#F7768E"

# cpu load: blue through magenta to red
theme[cpu_start]="#7AA2F7"
theme[cpu_mid]="#BB9AF7"
theme[cpu_end]="#F7768E"

# memory: free green, used amber to red, available and cached cool hues
theme[free_start]="#9ECE6A"
theme[free_mid]="#7DCFFF"
theme[free_end]="#7AA2F7"
theme[used_start]="#E0AF68"
theme[used_mid]="#F7768E"
theme[used_end]="#F7768E"
theme[available_start]="#7DCFFF"
theme[available_mid]="#7AA2F7"
theme[available_end]="#BB9AF7"
theme[cached_start]="#BB9AF7"
theme[cached_mid]="#7AA2F7"
theme[cached_end]="#7DCFFF"

# network: download cyan to blue, upload magenta to red
theme[download_start]="#7DCFFF"
theme[download_mid]="#7AA2F7"
theme[download_end]="#BB9AF7"
theme[upload_start]="#BB9AF7"
theme[upload_mid]="#F7768E"
theme[upload_end]="#E0AF68"

# process list sweeps the accent hues
theme[process_start]="#7AA2F7"
theme[process_mid]="#7DCFFF"
theme[process_end]="#9ECE6A"
