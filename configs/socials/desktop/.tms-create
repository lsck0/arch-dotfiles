#!/usr/bin/env -S nu --no-config-file
const SEARCH = "https://lite.duckduckgo.com/lite/"

def main []: nothing -> nothing {
    let home = $nu.home-dir
    let browser = $env.TMUX_PANE
    let window = ^tmux display-message -p -t $browser '#{window_id}'
    ^tmux rename-window -t $browser social
    let discord = ^tmux split-window -h -l 40% -c $home -t $browser -P -F '#{pane_id}' 'discordo; exec zsh'
    ^tmux split-window -v -l 50% -c $home -t $discord 'spotify_player; exec zsh'
    let dev = ^tmux new-window -a -d -n dev -c $home -t $window -P -F '#{window_id}' 'nvim; exec zsh'
    ^tmux new-window -a -d -n shell -c $home -t $dev
    ^tmux select-pane -t $browser
    ^tmux respawn-pane -k -c $home -t $browser $"cha ($SEARCH); exec zsh"
}
