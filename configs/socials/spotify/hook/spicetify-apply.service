[Unit]
Description=Apply spicetify to spotify
# brake for a runaway trigger
StartLimitIntervalSec=1min
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart=%h/projects/arch-dotfiles/configs/socials/spotify/hook/spicetify-apply.sh

[Install]
# an upgrade while this user was logged out fires no path unit
WantedBy=default.target
