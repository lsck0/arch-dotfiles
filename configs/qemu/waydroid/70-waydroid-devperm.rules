# before 73-seat-late, which turns the uaccess tag into an ACL for the seat's user: render nodes and cameras stay
# closed to others, the logged-in user keeps them without the render or video group
SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="render", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="video4linux", KERNEL=="video*", GROUP="video", MODE="0660", TAG+="uaccess"
