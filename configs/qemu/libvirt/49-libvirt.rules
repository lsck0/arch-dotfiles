// qemu:///system hands its client root (a domain on /dev/nvme0n1, a pool over /etc), so an admin at the machine
// authenticates per connecting client instead of the libvirt group's silent yes. polkit keeps the approval for that
// client process alone: one `virsh -c qemu:///system` shell asks once for all its commands, each separate virsh call
// asks again. boxes' qemu:///session needs only kvm
polkit.addRule(function (action, subject) {
    if (action.id === "org.libvirt.unix.manage" && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
});
