# grub upgrades re-enable 10_linux and 15_uki, which 09_arch replaces
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = grub

[Action]
Description = Disabling GRUB's 10_linux and 15_uki (replaced by 09_arch)...
When = PostTransaction
Exec = /bin/sh -c 'chmod -x /etc/grub.d/10_linux /etc/grub.d/15_uki 2>/dev/null || true'
