#!/usr/bin/env python3
"""Boot menu entries for the installed Arch kernels and timeshift snapshots.

usage: boot-menu grub-kernels     print one GRUB entry per kernel (for /etc/grub.d/09_arch)
       boot-menu grub-snapshots   write /boot/grub/timeshift.cfg (sourced by 41_timeshift)
       boot-menu limine           write limine.conf with kernel and snapshot entries
       boot-menu limine-efi       print the limine EFI binary on the ESP, if any

Entries are named after the kernel package and boot with the arguments from
/etc/kernel/cmdline.

Kernels and initramfs live on the ESP, outside every snapshot, so a snapshot
always boots a kernel that is installed *now*. That only works while the
snapshot still holds that kernel's modules. Per snapshot this lists every
installed kernel whose modules are in it, `linux` first. When `linux` does not
match (it was upgraded since), `linux-lts` moves to the top: LTS versions change
rarely, so it is the kernel most likely to still fit an older snapshot.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections import namedtuple
from contextlib import contextmanager
from pathlib import Path

ESP = Path("/boot")
GRUB_SNAPSHOT_CFG = ESP / "grub/timeshift.cfg"
LIMINE_CONFS = [ESP / "limine/limine.conf", ESP / "limine.conf", ESP / "EFI/limine/limine.conf", ESP / "EFI/BOOT/limine.conf"]
LIMINE_EFIS = [ESP / "EFI/BOOT/BOOTX64.EFI", ESP / "EFI/limine/BOOTX64.EFI", ESP / "EFI/Limine/limine_x64.efi", ESP / "limine/limine_x64.efi"]
LIMINE_MARKER = "# managed by arch-dotfiles/boot/limine: regenerated by boot-menu, edits are overwritten"
PRIMARY = "linux"
FALLBACK = "linux-lts"
TAGS = {"O": "ondemand", "B": "boot", "H": "hourly", "D": "daily", "W": "weekly", "M": "monthly"}
MODES = ("grub-kernels", "grub-snapshots", "limine", "limine-efi")

Kernel = namedtuple("Kernel", "version vmlinuz initramfs uki")


def mount_of(path):
    out = subprocess.run(
        ["findmnt", "-J", "-o", "SOURCE,TARGET,FSTYPE,FSROOT,UUID", "-T", str(path)],
        capture_output=True, text=True, check=True,
    ).stdout
    return json.loads(out)["filesystems"][0]


def esp_path(path, esp):
    rel = Path(path).relative_to(esp["target"])
    return str(Path("/") / esp["fsroot"].lstrip("/") / rel)


def installed_kernels():
    """pkgbase -> Kernel, for kernels with vmlinuz and initramfs on the ESP."""
    kernels = {}
    for pkgbase in Path("/usr/lib/modules").glob("*/pkgbase"):
        name = pkgbase.read_text().strip()
        vmlinuz = ESP / f"vmlinuz-{name}"
        initramfs = ESP / f"initramfs-{name}.img"
        if not (vmlinuz.is_file() and initramfs.is_file()):
            continue
        uki = None
        preset = Path(f"/etc/mkinitcpio.d/{name}.preset")
        if preset.is_file():
            m = re.search(r'^default_uki="?([^"\n]+)"?', preset.read_text(), re.M)
            if m and Path(m.group(1)).is_file():
                uki = Path(m.group(1))
        kernels[name] = Kernel(pkgbase.parent.name, vmlinuz, initramfs, uki)
    return kernels


def rank(name):
    return (name != PRIMARY, name == FALLBACK, name)


def base_cmdline(root_uuid):
    """Kernel arguments without rw/ro and subvol, plus the leftover rootflags."""
    tokens = []
    for src in (Path("/etc/kernel/cmdline"), Path("/proc/cmdline")):
        if src.is_file() and src.read_text().strip():
            tokens = src.read_text().split()
            break
    keep, flags = [], []
    for token in tokens:
        key, _, val = token.partition("=")
        if key in ("BOOT_IMAGE", "initrd", "ro", "rw"):
            continue
        if key == "rootflags":
            flags += [f for f in val.split(",") if f and not f.startswith(("subvol=", "subvolid="))]
            continue
        keep.append(token)
    if not any(t.startswith("root=") for t in keep):
        keep.insert(0, f"root=UUID={root_uuid}")
    return keep, flags


def boot_args(cmdline, flags, subvol):
    rootflags = ([f"subvol={subvol}"] if subvol else []) + flags
    return " ".join(cmdline + ["rw"] + (["rootflags=" + ",".join(rootflags)] if rootflags else []))


def boot_order(kernels, snapshot_root):
    """Kernels whose modules the snapshot has, best first."""
    matching = sorted(
        (name for name, k in kernels.items() if (snapshot_root / "usr/lib/modules" / k.version).is_dir()),
        key=rank,
    )
    if PRIMARY not in matching and FALLBACK in matching:
        matching.remove(FALLBACK)
        matching.insert(0, FALLBACK)
    return matching


def snapshot_menus(top, kernels):
    """[(snapshot name, title, [(label, kernel name)])], newest first."""
    snapshots_dir = top / "timeshift-btrfs" / "snapshots"
    if not snapshots_dir.is_dir():
        return []
    menus = []
    for snap in sorted((d for d in snapshots_dir.iterdir() if (d / "@").is_dir()), reverse=True):
        try:
            info = json.loads((snap / "info.json").read_text())
        except (OSError, ValueError):
            info = {}
        date, _, clock = snap.name.partition("_")
        tags = " ".join(TAGS.get(t, t) for t in info.get("tags", "").split())
        title = "  ".join(p for p in (f"{date} {clock.replace('-', ':')}", tags, info.get("comments", "")) if p)

        order = boot_order(kernels, snap / "@")
        if not order:
            # Nothing matches; offer LTS anyway, it may still get far enough to restore.
            name = FALLBACK if FALLBACK in kernels else sorted(kernels, key=rank)[0]
            entries = [(f"{name} (no matching modules)", name)]
        else:
            entries = [
                (f"{name} (fallback, {PRIMARY} modules missing)"
                 if name == FALLBACK and i == 0 and PRIMARY in kernels else name, name)
                for i, name in enumerate(order)
            ]
        menus.append((snap.name, title, entries))
    return menus


@contextmanager
def top_level(root):
    top = Path(tempfile.mkdtemp(prefix="boot-menu-", dir="/run"))
    subprocess.run(["mount", "-o", "ro,subvolid=5", root["source"].split("[", 1)[0], str(top)], check=True)
    try:
        yield top
    finally:
        subprocess.run(["umount", str(top)], check=True)
        top.rmdir()


def snapshots(root, kernels):
    if root["fstype"] != "btrfs" or not kernels:
        return []
    with top_level(root) as top:
        return snapshot_menus(top, kernels)


def snapshot_subvol(name):
    return f"/timeshift-btrfs/snapshots/{name}/@"


def current_subvol(root):
    return root["fsroot"] if root["fstype"] == "btrfs" and root["fsroot"] != "/" else None


# GRUB

def grub_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"


def grub_entry(indent, label, message, kernel, args, esp):
    pad = " " * indent
    return [
        f"{pad}menuentry {grub_quote(label)} --class arch --class gnu-linux {{",
        f"{pad}    search --no-floppy --fs-uuid --set=root {esp['uuid']}",
        f"{pad}    echo {grub_quote(message)}",
        f"{pad}    linux {esp_path(kernel.vmlinuz, esp)} {args}",
        f"{pad}    initrd {esp_path(kernel.initramfs, esp)}",
        f"{pad}}}",
    ]


def render_grub_kernels(kernels, cmdline, flags, root, esp):
    args = boot_args(cmdline, flags, current_subvol(root))
    lines = []
    for name in sorted(kernels, key=rank):
        lines += grub_entry(0, f"Arch Linux ({name})", f"booting {name}", kernels[name], args, esp)
    return "\n".join(lines) + "\n" if lines else ""


def render_grub_snapshots(menus, kernels, cmdline, flags, esp):
    if not menus:
        return ""
    lines = ["submenu 'Timeshift snapshots' --class timeshift {"]
    for snap, title, entries in menus:
        args = boot_args(cmdline, flags, snapshot_subvol(snap))
        lines.append(f"    submenu {grub_quote(title)} {{")
        for label, name in entries:
            lines += grub_entry(8, label, f"booting snapshot {snap} with {name}", kernels[name], args, esp)
        lines.append("    }")
    lines.append("}")
    return "\n".join(lines) + "\n"


# limine

def limine_entry(depth, label, kernel, args, esp, uki):
    pad = "    " * (depth - 1)
    body = pad + "    "
    lines = [f"{pad}{'/' * depth}{label}"]
    if uki and kernel.uki:
        lines += [f"{body}protocol: efi", f"{body}path: boot():{esp_path(kernel.uki, esp)}"]
    else:
        lines += [
            f"{body}protocol: linux",
            f"{body}path: boot():{esp_path(kernel.vmlinuz, esp)}",
            f"{body}module_path: boot():{esp_path(kernel.initramfs, esp)}",
        ]
    lines.append(f"{body}cmdline: {args}")
    return lines


def render_limine(menus, kernels, cmdline, flags, root, esp):
    lines = [LIMINE_MARKER, "timeout: 5", ""]
    args = boot_args(cmdline, flags, current_subvol(root))
    for name in sorted(kernels, key=rank):
        # Signed UKIs for the normal entries; snapshots need a different root, so plain kernels.
        lines += limine_entry(1, f"Arch Linux ({name})", kernels[name], args, esp, uki=True) + [""]
    if menus:
        lines.append("/Timeshift snapshots")
        for snap, title, entries in menus:
            lines.append(f"    //{title}")
            args = boot_args(cmdline, flags, snapshot_subvol(snap))
            for label, name in entries:
                lines += limine_entry(3, label, kernels[name], args, esp, uki=False)
        lines.append("")
    return "\n".join(lines)


def find_limine_efi():
    for efi in LIMINE_EFIS:
        if efi.is_file() and b"limine" in efi.read_bytes().lower():
            return efi
    return None


def sbctl_sign(path):
    """Sign with sbctl if its keys exist and the file is not signed yet."""
    if not shutil.which("sbctl"):
        return
    if "Owner GUID" not in subprocess.run(["sbctl", "status"], capture_output=True, text=True).stdout:
        return
    if "is signed" in subprocess.run(["sbctl", "verify", str(path)], capture_output=True, text=True).stdout:
        return
    subprocess.run(["sbctl", "sign", "-s", str(path)], check=True)


def write_if_changed(path, text):
    if path.is_file() and path.read_text() == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".new")
    tmp.write_text(text)
    os.replace(tmp, path)
    return True


def write_limine(text):
    conf = next((c for c in LIMINE_CONFS if c.is_file()), LIMINE_CONFS[0])
    if conf.is_file() and LIMINE_MARKER not in conf.read_text():
        backup = conf.with_name(conf.name + ".arch-dotfiles-backup")
        if not backup.exists():
            shutil.copyfile(conf, backup)
    changed = write_if_changed(conf, text)

    efi = find_limine_efi()
    if efi is None:
        print("boot-menu: no limine EFI binary on the ESP", file=sys.stderr)
        return
    enrolled = re.search(rb"\+\+CONFIG_B2SUM_SIGNATURE\+\+([0-9a-f]{128})", efi.read_bytes())
    if changed and enrolled and enrolled.group(1) != b"0" * 128:
        # limine refuses a config whose checksum does not match the enrolled one.
        subprocess.run(["limine", "enroll-config", str(efi), hashlib.blake2b(text.encode()).hexdigest()], check=True)
    sbctl_sign(efi)


def main():
    mode = sys.argv[1] if len(sys.argv) == 2 else ""
    if mode not in MODES:
        sys.exit(__doc__.split("\n\n")[1])
    if mode == "limine-efi":
        efi = find_limine_efi()
        if efi:
            print(efi)
        return
    if os.geteuid() != 0:
        sys.exit("boot-menu: must run as root")

    root = mount_of("/")
    if root["fsroot"].startswith("/timeshift-btrfs/"):
        message = "boot-menu: running from a timeshift snapshot, not touching the boot menu"
        if mode == "grub-kernels":
            # Fail so grub-mkconfig aborts and keeps the grub.cfg that still has kernels.
            sys.exit(message)
        print(message, file=sys.stderr)
        return
    kernels = installed_kernels()
    if not kernels:
        # Never write a menu without kernels; the existing one still boots.
        sys.exit("boot-menu: no kernel with vmlinuz + initramfs in /boot")
    cmdline, flags = base_cmdline(root["uuid"])
    esp = mount_of(ESP)

    if mode == "grub-kernels":
        sys.stdout.write(render_grub_kernels(kernels, cmdline, flags, root, esp))
    elif mode == "grub-snapshots":
        if GRUB_SNAPSHOT_CFG.parent.is_dir():
            write_if_changed(GRUB_SNAPSHOT_CFG, render_grub_snapshots(snapshots(root, kernels), kernels, cmdline, flags, esp))
    else:
        write_limine(render_limine(snapshots(root, kernels), kernels, cmdline, flags, root, esp))


if __name__ == "__main__":
    main()
