[Unit]
Description=Laya non-autoregressive typed-decision server (ROCm GPU)
# first run fetches checkpoints from huggingface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/laya
# venv bin, not uv run: uv run re-syncs from uv.lock and would reinstall cuda torch
ExecStart=%h/projects/laya/.venv/bin/laya-serve
Environment=LAYA_PORT=8100
Environment=LAYA_LOG_LEVEL=info
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
