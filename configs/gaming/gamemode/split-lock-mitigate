#!/usr/bin/env bash
# the gamemode hook runs this through pkexec: split lock mitigation sleeps the offending thread,
# games and anticheat under proton trip it constantly
set -euo pipefail

SPLIT_LOCK_MITIGATE=/proc/sys/kernel/split_lock_mitigate
MITIGATE_ON=1
MITIGATE_OFF=0

case "$#:${1:-}" in
1:on) value=$MITIGATE_ON ;;
1:off) value=$MITIGATE_OFF ;;
*)
    echo "usage: $(basename "$0") {on|off}" >&2
    exit 1
    ;;
esac

# only cpus with split lock detection have the knob
[[ -e "$SPLIT_LOCK_MITIGATE" ]] || exit 0
echo "$value" >"$SPLIT_LOCK_MITIGATE"
