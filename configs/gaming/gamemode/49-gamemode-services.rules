// let the gamemode hook free gpu vram by stopping the local inference services and their sockets, and restore them
var GAMEMODE_UNITS = [
    "ollama.service",
    "ollama.socket",
    "vllm-proxy.service",
    "vllm.socket"
];

polkit.addRule(function (action, subject) {
    var verb = action.lookup("verb");
    if (action.id === "org.freedesktop.systemd1.manage-units" && (verb === "start" || verb === "stop") &&
        subject.local && subject.active && subject.isInGroup("wheel") &&
        GAMEMODE_UNITS.indexOf(action.lookup("unit")) >= 0) {
        return polkit.Result.YES;
    }
});

// let the gamemode hook relax split lock mitigation while a game runs
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") === "/usr/local/bin/split-lock-mitigate" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
