# managed by arch-dotfiles/gaming/vpn-bypass
[Unit]
Description=Mark vpn-bypass group sockets so they egress on the real link, owns table inet games_bypass
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/games-bypass.nft
ExecStartPost=-/bin/sh -c 'gid=$$(getent group vpn-bypass | cut -d: -f3) && [ -n "$$gid" ] && /usr/sbin/nft add element inet games_bypass gids "{ $$gid }"'
ExecReload=/usr/sbin/nft -f /etc/nftables.d/games-bypass.nft
ExecReload=-/bin/sh -c 'gid=$$(getent group vpn-bypass | cut -d: -f3) && [ -n "$$gid" ] && /usr/sbin/nft add element inet games_bypass gids "{ $$gid }"'
ExecStop=/usr/sbin/nft destroy table inet games_bypass

[Install]
WantedBy=multi-user.target
