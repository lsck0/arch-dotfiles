[Unit]
Description=NAS homelab share (vm-109)
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
After=network-online.target
Wants=network-online.target

[Mount]
# by IP: *.lsck0.dev resolves to Cloudflare, which cannot carry SMB
What=//10.100.0.109/homelab
Where=/mnt/homelab
Type=cifs
Options=guest,uid=@UID@,gid=@GID@,vers=3.0,_netdev,nofail,file_mode=0664,dir_mode=0775

[Install]
WantedBy=multi-user.target
