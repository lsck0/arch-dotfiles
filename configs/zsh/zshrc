# no git config covers submodules on the initial clone
git() {
  if [[ "$1" == clone ]]; then
    command git clone --recurse-submodules "${@:2}"
  else
    command git "$@"
  fi
}

# remote control needs feature flags, which DO_NOT_TRACK disables
claude() {
  env -u DO_NOT_TRACK claude "$@"
}

# computed once: the non v-cache cores (empty on single-ccd) and whether a user scope is usable
typeset -g _FENCE_CPUS _FENCE_SCOPE
() {
  emulate -L zsh
  local c sz max=0 id
  typeset -A size_of
  for c in /sys/devices/system/cpu/cpu<->/cache/index3/size(N); do
    sz=$(<$c); sz=${sz%%[^0-9]*}
    [[ -n $sz ]] || continue
    id=${c#/sys/devices/system/cpu/cpu}; id=${id%%/*}
    size_of[$id]=$sz
    (( sz > max )) && max=$sz
  done
  local -a build
  for id in ${(k)size_of}; do
    (( size_of[$id] < max )) && build+=$id
  done
  (( ${#build} )) && _FENCE_CPUS=${(j.,.)build}
  # the cgroup scope needs a reachable user manager, which a bare wsl root shell lacks
  systemctl --user show-environment >/dev/null 2>&1 && _FENCE_SCOPE=1
}

# run a heavy build off the v-cache ccd, low priority, and oom-first; the scope lets
# systemd-oomd evict the build before desktop apps under memory pressure
# builtin bg resumes jobs, so this is fence: fence ./gradlew ... / fence make -j / fence cargo build
fence() {
  local -a pre=(choom -n 1000 --)
  [[ -n $_FENCE_CPUS ]] && pre+=(taskset -c "$_FENCE_CPUS")
  pre+=(nice -n19)
  if [[ -n $_FENCE_SCOPE ]]; then
    systemd-run --user --scope --quiet -p CPUWeight=10 "${pre[@]}" "$@"
  else
    "${pre[@]}" "$@"
  fi
}

# greet on every interactive terminal
[[ -t 1 && $TERM != dumb ]] && fastfetch

zsh_init_cache starship init zsh --print-full-init && source $REPLY
# no right_format in starship.toml, so the right prompt would fork starship per prompt for nothing
RPROMPT=
zsh_init_cache direnv hook zsh && source $REPLY

history_file_push() {
  fc -p "$1" $HISTSIZE $SAVEHIST
  history_file_pushed=$1
}

history_file_pop() {
  [[ -n ${history_file_pushed-} ]] || return 0
  fc -P
  history_file_pushed=
}

# sharehistory ignores a changed HISTFILE; must run after direnv's hook
history_file_follow_direnv() {
  [[ ${DIRENV_HISTFILE-} == ${history_file_pushed-} ]] && return
  history_file_pop
  [[ -z ${DIRENV_HISTFILE-} ]] || history_file_push "$DIRENV_HISTFILE"
}
precmd_functions+=(history_file_follow_direnv)
zsh_init_cache zoxide init zsh && source $REPLY
