export DO_NOT_TRACK=1

source ~/.cache/wal/colors.sh

fpath=(~/.zsh/completions $fpath)
export ZSH_DISABLE_COMPFIX=true
export ZSH_COMPDUMP="$HOME/.zcompdump"

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname "$ZINIT_HOME")"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "${ZINIT_HOME}/zinit.zsh"

# omz plugins write generated completions here
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
[[ -d "$ZSH_CACHE_DIR/completions" ]] || mkdir -p "$ZSH_CACHE_DIR/completions"
fpath=("$ZSH_CACHE_DIR/completions" $fpath)

# omz lib, not lazy so its keybindings exist at the first prompt
for lib in functions key-bindings completion misc directories grep git clipboard; do
  zinit snippet "OMZL::$lib.zsh"
done
unset lib

for plugin in aws docker docker-compose git jj mise nmap node npm rust sudo terraform; do
  zinit ice wait lucid
  zinit snippet "OMZP::$plugin"
done
unset plugin

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
# native fzf keybinds, needs fzf 0.48+
zinit ice wait lucid atload'source <(fzf --zsh)'
zinit light zdharma-continuum/null

zinit ice wait lucid
zinit light Aloxaf/fzf-tab

zinit ice wait lucid atload'_zsh_autosuggest_start'
zinit light zsh-users/zsh-autosuggestions

zinit ice wait lucid blockf
zinit light zsh-users/zsh-completions

zinit ice wait lucid
zinit light zsh-users/zsh-syntax-highlighting

# compinit must run before cdreplay/compdef
autoload -Uz compinit
() {
  setopt local_options extended_glob
  # full check at most daily; touch since compinit keeps an unchanged dump's mtime
  if [[ -n $HOME/.zcompdump(#qN.mh+24) ]]; then
    compinit -d "$HOME/.zcompdump"
    touch "$HOME/.zcompdump"
  else
    compinit -C -d "$HOME/.zcompdump"
  fi
}
zinit cdreplay -q
compdef kubecolor=kubectl

autoload zmv
autoload -Uz edit-command-line
zle -N edit-command-line
# konsole only runs as dolphin's terminal panel, which clears the line with ^E^U before each cd;
# ^E opening the editor there would swallow the cd
[[ -n $KONSOLE_VERSION ]] || bindkey '^e' edit-command-line
bindkey ' ' magic-space

HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt appendhistory
setopt extended_history
setopt hist_expire_dups_first
setopt hist_verify
setopt hist_find_no_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_save_no_dups
setopt sharehistory

typeset -U path
path+=("$HOME/.cargo/bin")
path+=("$HOME/.ghcup/bin")
path+=("$HOME/.go/bin")
path+=("$HOME/.jai/bin")
path+=("$HOME/.local/bin")

export PATH
export GOPATH="$HOME/.go"
export EDITOR=nvim
export SHELL=zsh

# needs `anonymous-socks.sh up` first
alias anonymous-socks-proxychains='proxychains4 -q -f "${ANONYMOUS_SOCKS_PROXYCHAINS_CONF:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/anonymous-socks-proxychains.conf}"'
alias cat="bat"
# not in konsole: dolphin's panel follows the view with a cd, and zoxide would treat the path as keywords
[[ -n $KONSOLE_VERSION ]] || alias cd="z"
alias convert="magick"
alias cp="cp -v"
alias downgrade="sudo downgrade"
alias kubectl="kubecolor"
alias l="eza -lh"
alias la="eza -lah"
alias ldocker="lazydocker"
alias ll="eza -lh"
alias lgit="lazygit"
alias lgithub="gh-dash"
alias ljj="lazyjj"
alias ljournal='lazyjournal -T "$(date +%:z)"'
alias ls="eza"
alias lsql="lazysql"
alias lt="eza -lah --tree"
alias mkdir="mkdir -pv"
alias mv="mv -v"
alias pacman="sudo pacman"
alias rm="trash -v"
alias sshnb="~/projects/arch-dotfiles/scripts/sshk.sh luca@192.168.178.73"
alias sshpc="~/projects/arch-dotfiles/scripts/sshk.sh luca@192.168.178.138"
alias toroff="sudo systemctl stop tor-router.service"
alias toron="sudo systemctl start tor-router.service"

# no git config covers submodules on the initial clone
git() {
  if [[ "$1" == clone ]]; then
    command git clone --recurse-submodules "${@:2}"
  else
    command git "$@"
  fi
}

# remote control needs feature flags, which DO_NOT_TRACK disables
claude() {
  env -u DO_NOT_TRACK claude "$@"
}

# greet only at a real tty, once per session: subshells inherit the marker and skip
if [[ -o interactive && -t 1 && "$TERM" != dumb && -z "$FASTFETCH_SHOWN" ]]; then
  export FASTFETCH_SHOWN=1
  fastfetch
fi

eval "$(mise activate zsh)"
eval "$(starship init zsh)"
eval "$(direnv hook zsh)"

history_file_push() {
  fc -p "$1" $HISTSIZE $SAVEHIST
  history_file_pushed=$1
}

history_file_pop() {
  [[ -n ${history_file_pushed-} ]] || return 0
  fc -P
  history_file_pushed=
}

# sharehistory ignores a changed HISTFILE; must run after direnv's hook
history_file_follow_direnv() {
  [[ ${DIRENV_HISTFILE-} == ${history_file_pushed-} ]] && return
  history_file_pop
  [[ -z ${DIRENV_HISTFILE-} ]] || history_file_push "$DIRENV_HISTFILE"
}
precmd_functions+=(history_file_follow_direnv)
eval "$(zoxide init zsh)"
