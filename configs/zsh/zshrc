export DO_NOT_TRACK=1

source ~/.cache/wal/colors.sh

fpath=(~/.zsh/completions $fpath)
export ZSH_DISABLE_COMPFIX=true
export ZSH_COMPDUMP="$HOME/.zcompdump"

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "${ZINIT_HOME}/zinit.zsh"

# OMZ plugins that ship aliases/keybinds/functions, lazy via zinit snippets.
zinit ice wait lucid
zinit snippet OMZP::sudo
zinit ice wait lucid
zinit snippet OMZP::git

# fzf keybinds+completion natively (replaces OMZ fzf plugin); fzf 0.48+.
zinit ice wait lucid atload'source <(fzf --zsh)'
zinit light zdharma-continuum/null

zinit ice wait lucid
zinit light Aloxaf/fzf-tab

zinit ice wait lucid atload'_zsh_autosuggest_start'
zinit light zsh-users/zsh-autosuggestions

zinit ice wait lucid blockf
zinit light zsh-users/zsh-completions

zinit ice wait lucid
zinit light zsh-users/zsh-syntax-highlighting

# compinit MUST load before cdreplay/compdef (OMZ used to do this; it is gone now).
autoload -Uz compinit
if [[ -n "$HOME/.zcompdump"(#qNmh-24) ]]; then
  compinit -C -d "$HOME/.zcompdump"
else
  compinit -d "$HOME/.zcompdump"
fi
zinit cdreplay -q
compdef kubecolor=kubectl

autoload zmv
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^e' edit-command-line
bindkey ' ' magic-space

HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt hist_find_no_dups
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_save_no_dups
setopt sharehistory

typeset -U path
path+=("$HOME/.cargo/bin")
path+=("$HOME/.ghcup/bin")
path+=("$HOME/.go/bin")
path+=("$HOME/.jai/bin")
path+=("$HOME/.local/bin")

export PATH
export GOPATH="$HOME/.go"
export EDITOR=nvim
export SHELL=zsh

