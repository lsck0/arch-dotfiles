# git clone always pulls submodules (no native config covers the initial clone)
git() {
  if [[ "$1" == clone ]]; then
    command git clone --recurse-submodules "${@:2}"
  else
    command git "$@"
  fi
}

# Remote Control needs feature-flag eval, which DO_NOT_TRACK disables. Drop it
# for claude only, so RC works while DO_NOT_TRACK still covers everything else.
claude() {
  env -u DO_NOT_TRACK claude "$@"
}

# only greet on login shells at a real tty; skip dumb terminals and subshells.
[[ -o interactive && -t 1 && "$TERM" != dumb ]] && fastfetch

eval "$(mise activate zsh)"
eval "$(starship init zsh)"
eval "$(direnv hook zsh)"

history_file_push() {
  fc -p "$1" $HISTSIZE $SAVEHIST
  history_file_pushed=$1
}

history_file_pop() {
  [[ -n ${history_file_pushed-} ]] || return 0
  fc -P
  history_file_pushed=
}

# direnv can't own HISTFILE: sharehistory writes the in-memory list on every command, so the list itself is swapped.
# registered after direnv's precmd hook so DIRENV_HISTFILE is already current.
history_file_follow_direnv() {
  [[ ${DIRENV_HISTFILE-} == ${history_file_pushed-} ]] && return
  history_file_pop
  [[ -z ${DIRENV_HISTFILE-} ]] || history_file_push "$DIRENV_HISTFILE"
}
precmd_functions+=(history_file_follow_direnv)
eval "$(zoxide init zsh)"

# tms marks the session so tmux session-init lays out the nvim/claude/zsh stack.
tms() {
  tmux set-environment -g TMS_LAUNCH 1 2>/dev/null
  command tms "$@"
  # Clear the marker afterwards: if tms only switched to an existing session the
  # session-created hook never fired to consume it, and a stale marker would make
  # the next bare `tmux` build the IDE stack. session-init already unset it on a
  # real new session, so this is a harmless no-op there.
  tmux set-environment -gu TMS_LAUNCH 2>/dev/null
}
