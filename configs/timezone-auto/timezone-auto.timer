[Unit]
Description=Periodically re-check the system timezone

[Timer]
# Shortly after login/boot, so a laptop opened in a new country corrects
# itself before you look at the clock.
OnStartupSec=2min
# Then hourly. Changing timezone is a travel-frequency event, not a
# second-by-second one, and every run is a network request to a third party —
# there is no reason to make more of them than that.
OnUnitActiveSec=1h
# Catch up after the machine was asleep, which is exactly when it is most
# likely to have moved.
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
