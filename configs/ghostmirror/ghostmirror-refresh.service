[Unit]
Description=Rebuild ghostmirror mirror pool from upstream

[Service]
Type=oneshot
ExecStartPre=/usr/bin/timeout 300 /bin/sh -c 'until /usr/bin/curl -sfI --max-time 10 https://archlinux.org/mirrorlist/all/ >/dev/null; do sleep 15; done'
ExecStart=%h/projects/arch-dotfiles/configs/ghostmirror/refresh-pool.sh
