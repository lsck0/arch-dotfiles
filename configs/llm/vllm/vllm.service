[Unit]
Description=vLLM server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=render video
StateDirectory=vllm
CacheDirectory=vllm
Environment=HOME=%S/vllm
Environment=XDG_CACHE_HOME=%C/vllm
ExecPaths=%S/private/vllm %C/private/vllm
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
Nice=10
CPUWeight=20
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=DO_NOT_TRACK=1
Environment=FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
Environment=TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
Environment=VLLM_TARGET_DEVICE=rocm
Environment=VLLM_USE_TRITON_AWQ=1
Environment=VLLM_MODEL_REVISION=@MODEL_REVISION@
ExecStartPre=+/usr/bin/sh -c 'test -e @PERF_LEVEL_PATH@ && echo high > @PERF_LEVEL_PATH@ || true'
ExecStopPost=+/usr/bin/sh -c 'test -e @PERF_LEVEL_PATH@ && echo auto > @PERF_LEVEL_PATH@ || true'
ExecStart=/opt/vllm/venv/bin/vllm serve @MODEL@ \
    --revision ${VLLM_MODEL_REVISION} \
    --tokenizer-revision ${VLLM_MODEL_REVISION} \
    --host 127.0.0.1 \
    --port 8001 \
    --max-model-len auto \
    --gpu-memory-utilization @GPU_MEMORY_UTILIZATION@ \
    --language-model-only \
    --compilation-config '{"cudagraph_capture_sizes": [1, 2, 4, 8]}' \
    --kv-cache-dtype @KV_CACHE_DTYPE@ \
    --max-num-seqs 8 \
    --enable-auto-tool-choice \
    --tool-call-parser @TOOL_CALL_PARSER@ \
    --reasoning-parser @REASONING_PARSER@
Restart=on-failure
RestartSec=5
