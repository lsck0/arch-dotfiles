[Unit]
Description=vLLM server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=render video
StateDirectory=vllm
CacheDirectory=vllm
Environment=HOME=%S/vllm
Environment=XDG_CACHE_HOME=%C/vllm
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# extra sandboxing (safe for ROCm compute: no syscall/addr-family filter, no MemoryDenyWriteExecute — JIT needs W^X)
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# privacy: no model-hub / usage phone-home
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=DO_NOT_TRACK=1
Environment=FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
Environment=TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
Environment=VLLM_TARGET_DEVICE=rocm
Environment=VLLM_USE_TRITON_AWQ=1
ExecStart=/opt/vllm/venv/bin/vllm serve mattbucci/gemma-4-12B-AWQ \
    --host 127.0.0.1 \
    --port 8001 \
    --max-model-len auto \
    --language-model-only \
    --compilation-config '{"cudagraph_capture_sizes": [1, 2, 4, 8]}' \
    --enable-auto-tool-choice \
    --tool-call-parser gemma4
Restart=on-failure
RestartSec=5
