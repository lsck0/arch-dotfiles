[Unit]
Description=vLLM server
After=network-online.target
Wants=network-online.target
# a start that cannot succeed (a broken venv, a bad model) stops after three tries instead of reloading the weights
# every minute; vllm-wait-ready then gives up at once
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=render video
StateDirectory=vllm
CacheDirectory=vllm
Environment=HOME=%S/vllm
Environment=XDG_CACHE_HOME=%C/vllm
# systemd id-maps a dynamic user's state and cache dirs noexec; triton and inductor dlopen the launchers they build there
ExecPaths=%S/private/vllm %C/private/vllm
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# no syscall or address-family filter, no MemoryDenyWriteExecute: rocm's jit maps writable code
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# idle, the engine core still spins a cpu (cause open, py-spy dump as root); it yields until the proxy stops it
Nice=10
CPUWeight=20
# privacy: no model-hub / usage phone-home
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=DO_NOT_TRACK=1
Environment=FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
Environment=TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
Environment=VLLM_TARGET_DEVICE=rocm
Environment=VLLM_USE_TRITON_AWQ=1
# the hub repo at a fixed commit, weights and tokenizer alike: a push to it never reaches this root-started service
Environment=VLLM_MODEL_REVISION=@MODEL_REVISION@
# the share of vram left over leaves room for the desktop that renders on the card, else ttm evicts its buffers; the kv
# cache shrinks to fit (max-model-len auto)
ExecStart=/opt/vllm/venv/bin/vllm serve @MODEL@ \
    --revision ${VLLM_MODEL_REVISION} \
    --tokenizer-revision ${VLLM_MODEL_REVISION} \
    --host 127.0.0.1 \
    --port 8001 \
    --max-model-len auto \
    --gpu-memory-utilization @GPU_MEMORY_UTILIZATION@ \
    --language-model-only \
    --compilation-config '{"cudagraph_capture_sizes": [1, 2, 4, 8]}' \
    --enable-auto-tool-choice \
    --tool-call-parser gemma4
Restart=on-failure
RestartSec=5
