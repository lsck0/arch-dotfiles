[Unit]
Description=On-demand vllm starter
Requires=vllm.socket
After=vllm.socket

[Service]
Type=simple
Sockets=vllm.socket
TimeoutStartSec=10min
# "-": a backend that never comes up still starts the proxy, which takes the queued connection and closes it on the
# refused backend; failing here would leave it queued and the socket would start this unit again and again
ExecStartPre=-/usr/local/bin/vllm-wait-ready
# idle vllm holds 11 gb of vram and spins a core, so it goes after 5 minutes without a connection
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=5min 127.0.0.1:8001
ExecStopPost=/usr/bin/systemctl stop vllm.service
