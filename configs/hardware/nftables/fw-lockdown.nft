#!/usr/sbin/nft -f
# maximum lockdown: nothing new gets in from the network or is routed from it, only loopback, ndp, local vm/container interfaces and already-established flows

define trusted_ifaces = { "docker*", "br-*", "veth*", "virbr*", "waydroid*", "lxc*" }

add table inet fw
delete table inet fw
table inet fw {
    chain input {
        type filter hook input priority 0; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        # hoplimit 255: on-link only, so ndp cannot come from beyond the router
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } ip6 hoplimit 255 accept
        iifname $trusted_ifaces accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
        iifname $trusted_ifaces accept
    }
}
