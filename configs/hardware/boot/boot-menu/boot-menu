#!/usr/bin/env python3
"""Boot menu entries for the installed Arch kernels, each chainloading its signed UKI.

usage: boot-menu grub-kernels     print one GRUB entry per kernel (for /etc/grub.d/09_arch)

A UKI embeds its initramfs and /etc/kernel/cmdline, so grub.cfg on the unverified ESP picks nothing but the file.
"""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

ESP = Path("/boot")
PRIMARY = "linux"
FALLBACK = "linux-lts"
MODES = ("grub-kernels",)


def mount_of(path):
    out = subprocess.run(
        ["findmnt", "-J", "-o", "SOURCE,TARGET,FSTYPE,FSROOT,UUID", "-T", str(path)],
        capture_output=True, text=True, check=True,
    ).stdout
    return json.loads(out)["filesystems"][0]


def esp_path(path, esp):
    rel = Path(path).relative_to(esp["target"])
    return str(Path("/") / esp["fsroot"].lstrip("/") / rel)


def installed_kernels():
    """pkgbase -> UKI path, for kernels whose preset builds a UKI that is on the ESP."""
    kernels = {}
    for pkgbase in Path("/usr/lib/modules").glob("*/pkgbase"):
        name = pkgbase.read_text().strip()
        preset = Path(f"/etc/mkinitcpio.d/{name}.preset")
        if not preset.is_file():
            continue
        m = re.search(r'^default_uki="?([^"\n]+)"?', preset.read_text(), re.M)
        if m and Path(m.group(1)).is_file():
            kernels[name] = Path(m.group(1))
    return kernels


def rank(name):
    return (name != PRIMARY, name == FALLBACK, name)


# grub

def grub_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"


def render_grub_kernels(kernels, esp):
    lines = []
    for name in sorted(kernels, key=rank):
        lines += [
            f"menuentry {grub_quote(f'Arch Linux ({name})')} --class arch --class gnu-linux {{",
            f"    search --no-floppy --fs-uuid --set=root {esp['uuid']}",
            f"    echo {grub_quote(f'booting {name}')}",
            f"    chainloader {esp_path(kernels[name], esp)}",
            "}",
        ]
    return "\n".join(lines) + "\n"


def main():
    mode = sys.argv[1] if len(sys.argv) == 2 else ""
    if mode not in MODES:
        sys.exit(__doc__.split("\n\n")[1])
    if os.geteuid() != 0:
        sys.exit("boot-menu: must run as root")

    kernels = installed_kernels()
    if not kernels:
        # fail so grub-mkconfig keeps the old grub.cfg instead of writing a menu without kernels
        sys.exit("boot-menu: no kernel with its uki in /boot")
    sys.stdout.write(render_grub_kernels(kernels, mount_of(ESP)))


if __name__ == "__main__":
    main()
