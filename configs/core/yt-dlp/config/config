-o "@DOWNLOAD_DIR@/%(uploader)s/%(title)s [%(id)s].%(ext)s"
--restrict-filenames
--continue
--no-mtime
--no-overwrites
--concurrent-fragments 4
--retries 10
--fragment-retries 10

-f bv*+ba/b
--merge-output-format @CONTAINER@

--embed-metadata
--embed-thumbnail
--embed-chapters
--embed-subs
--sub-langs @SUB_LANGS@

--sponsorblock-mark all

--download-archive @DOWNLOAD_DIR@/.archive
