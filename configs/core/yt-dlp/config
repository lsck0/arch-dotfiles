# arch-dotfiles yt-dlp defaults. yt-dlp always runs inside the protonvpn network namespace, whose only route is a
# proton wireguard tunnel (base/protonvpn-netns, /usr/local/bin/yt-dlp; yt-dlp.nu refuses where it is missing), so a
# dead tunnel means no download. Its 127.0.0.1 is the namespace's own, so the host's tor and socks proxies are out of
# reach from here.

# quoted: yt-dlp splits config lines shell-style, so the space would turn the tail into a stray url
-o "~/downloads/yt-dlp/%(uploader)s/%(title)s [%(id)s].%(ext)s"
--restrict-filenames
--continue
--no-mtime
--no-overwrites
--concurrent-fragments 4
--retries 10
--fragment-retries 10

# best video+audio, remuxed to a widely-playable container
-f bv*+ba/b
--merge-output-format mp4

--embed-metadata
--embed-thumbnail
--embed-chapters
--embed-subs
--sub-langs en.*,de.*

# skip sponsor/intro segments on youtube
--sponsorblock-mark all

# keep a per-user archive so re-runs don't re-download
--download-archive ~/downloads/yt-dlp/.archive
