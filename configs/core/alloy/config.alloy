// generated by configs/core/alloy: this desktop's node metrics and journal to the homelab's push doors
// (platforms/homelab.nu push); the lab sets host and job on metrics itself, loki keeps the labels sent here

local.file "push" {
  filename  = sys.env("CREDENTIALS_DIRECTORY") + "/push"
  is_secret = true
}

// systemd: unit states over d-bus, so the lab's dashboard counts failed units
prometheus.exporter.unix "node" {
  enable_collectors = ["systemd"]
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  forward_to      = [prometheus.remote_write.lab.receiver]
  scrape_interval = "30s"
}

prometheus.remote_write "lab" {
  endpoint {
    url = "@PROMETHEUS@"

    basic_auth {
      username = "@HOST@"
      password = local.file.push.content
    }
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "journal" {
  forward_to    = [loki.write.lab.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = {host = "@HOST@", job = "journal"}
}

loki.write "lab" {
  endpoint {
    url = "@LOKI@"

    basic_auth {
      username = "@HOST@"
      password = local.file.push.content
    }
  }
}
