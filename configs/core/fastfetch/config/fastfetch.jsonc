{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 4,
      "left": 2,
    },
  },
  "display": {
    "separator": " ",
    "brightColor": true,
    "key": {
      "width": 10,
    },
    "color": {
      "keys": "blue",
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
    },
    {
      "type": "custom",
      "format": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "90",
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{name} {version}",
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      "format": "{1} {2} {4}",
    },
    {
      "type": "packages",
      "key": "PKGS",
      "format": "{pacman} packages",
    },
    {
      "type": "cpu",
      "key": "CPU",
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{2}",
      "hideType": "integrated",
    },
    {
      "type": "memory",
      "key": "MEMORY",
      "format": "{used} / {total} :: {percentage}",
    },
    {
      "type": "disk",
      "key": "DISK",
      "format": "{mountpoint} :: {size-used} / {size-total} :: {size-percentage}",
    },
    {
      "type": "localip",
      "key": "IP",
    },
    {
      "type": "uptime",
      "key": "UPTIME",
    },
    {
      "type": "command",
      "key": "AGE",
      "text": "echo \"$(( ( $(date +%s) - $(date -d \"$(grep -m1 -oP '^\\[\\K[^\\]]+' /var/log/pacman.log)\" +%s) ) / 86400 )) days\"",
    },
    {
      "type": "custom",
      "format": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "90",
    },
    "break",
  ],
}
