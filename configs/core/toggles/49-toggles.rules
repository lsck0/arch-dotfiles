// the bar and the toggle menu switch these for an admin at the machine; a remote (ssh) or inactive session still has to
// authenticate. any process of the session passes this check, not only the bar, so only what tightens is unprompted:
// lowering the firewall or leaving tor asks for the admin password (kept a few minutes), never silently
function atTheMachine(subject) {
    return subject.local && subject.active && subject.isInGroup("wheel");
}

// start/stop, unprompted: nothing here guards the network
var TOGGLE_UNITS = [
    "docker.service",
    "ollama.service",
    "systemd-oomd.service"
];

// starting these tightens; stopping one drops the firewall or sends traffic around tor
var GUARD_UNITS = [
    "fw-lockdown.service",
    "portmaster.service",
    "tor-router.service"
];

polkit.addRule(function (action, subject) {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (action.id !== "org.freedesktop.systemd1.manage-units" || (verb !== "start" && verb !== "stop") ||
        !atTheMachine(subject)) {
        return;
    }
    if (TOGGLE_UNITS.indexOf(unit) >= 0 || (GUARD_UNITS.indexOf(unit) >= 0 && verb === "start")) {
        return polkit.Result.YES;
    }
    // fw-lockdown's Conflicts= makes fw-inbound's start stop it, so from restrictive it lowers like every stop here.
    // kept a few minutes: the approval holds for the whole manage-units action, so it also covers other guard stops
    // in that window, right after one was approved at the machine
    if (GUARD_UNITS.indexOf(unit) >= 0 || unit === "fw-inbound.service") {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
});

// the root helper has its own action (dev.lsck0.toggles.policy), so a kept approval covers it alone. it checks its
// own arguments; the firewall switch is one call: restrictive tightens, unprompted; default and permissive can lower
// it, so they ask once (kept a few minutes) instead of once per unit, and that approval also covers a portal for those
// minutes. none of its other verbs opens the firewall or tor (anonsocks nft-off deletes the whole anonymous_socks
// table, dropping the egress guard and rate cap for every uid's anonsocks slice; these machines are single-user, so
// that slice is the caller's own)
polkit.addRule(function (action, subject) {
    if (action.id !== "@ACTION@" || !atTheMachine(subject)) {
        return;
    }
    var argv = String(action.lookup("command_line") || "").split(" ");
    if (argv[1] === "firewall" && argv[2] !== "restrictive") {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
    // a captive portal stops tor and portmaster and opens fw_egress on the foreign link; ending it early tightens
    if (argv[1] === "portal" && argv[2] !== "off") {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
    return polkit.Result.YES;
});
