#!/usr/bin/env -S nu --no-config-file
# palette conditioning for every theme generator; quickshell's Commons/Palette.js is a port kept in step by `js --write`

const WAL_COLORS_JSON = ".cache/wal/colors.json"
const PALETTE_JS = path self ../../desktop/quickshell/Commons/Palette.js

export const TEXT_RATIO = 4.5
export const BG_VALUE_MIN = 0.08
export const BG_VALUE_MAX = 0.26
# light themes span 0.76 to 0.97; any dark theme's conditioned bg is below 0.06
export const LIGHT_LUMINANCE = 0.4
export const WHITE_TEXT_LUMINANCE_MAX = 0.18
# 24 steps of 0.12 reach 95% of the target
export const WALK_STEP = 0.12
export const WALK_COUNT_MAX = 24
export const SURFACE_SATURATION = 0.9
export const RADIUS_PX = 2
export const BORDER_PX = 1
export const OPACITY_WINDOW = 0.95
export const OPACITY_SURFACE = 0.85
export const OPACITY_BAR = 0.78
const DIM_RATIO = 2.6
const DIM_STEP = 0.08
const DIM_COUNT_MAX = 40
const SELECTION_COUNT_MAX = 30
const SELECTION_DARKEN = 0.92
const SEMANTIC_HUES = {error: 0.0, warn: 0.11, ok: 0.33}
const WHITE = [1.0 1.0 1.0]
const BLACK = [0.0 0.0 0.0]

const JS_CONSTANTS = {
    TEXT_RATIO: $TEXT_RATIO
    BG_VALUE_MIN: $BG_VALUE_MIN
    BG_VALUE_MAX: $BG_VALUE_MAX
    LIGHT_LUMINANCE: $LIGHT_LUMINANCE
    WHITE_TEXT_LUMINANCE_MAX: $WHITE_TEXT_LUMINANCE_MAX
    WALK_STEP: $WALK_STEP
    WALK_COUNT_MAX: $WALK_COUNT_MAX
    SURFACE_SATURATION: $SURFACE_SATURATION
    RADIUS_PX: $RADIUS_PX
    BORDER_PX: $BORDER_PX
    OPACITY_SURFACE: $OPACITY_SURFACE
    OPACITY_BAR: $OPACITY_BAR
}
const JS_BEGIN = "// BEGIN generated by configs/core/wallust/palette.nu (palette.nu js --write), do not edit"
const JS_END = "// END generated"
const JS_BLOCK = '(?s)// BEGIN generated by .*?// END generated'

# nu compares floats within an epsilon (min/max too); scaling keeps the exact sign Palette.js has
const EXACT_SCALE = 2.0 ** 100
def cmp [a: number, b: number]: nothing -> int {
    let d = ($a - $b) * $EXACT_SCALE
    if $d > 0 { 1 } else if $d < 0 { -1 } else { 0 }
}
def max2 [a: number, b: number]: nothing -> number { if (cmp $b $a) > 0 { $b } else { $a } }
def min2 [a: number, b: number]: nothing -> number { if (cmp $b $a) < 0 { $b } else { $a } }
def clamp [lo: float, hi: float]: float -> float { max2 $lo (min2 $hi $in) }

# Python's round, half to even, which Palette.js mirrors.
def round-even []: float -> int {
    let x = $in
    if (cmp ($x mod 1) 0.5) == 0 { 2 * ($x / 2 | math round) } else { $x | math round }
}

export def hex-to-rgb []: string -> list<float> {
    let v = $in | str trim --left --char "#"
    [0 2 4] | each {|i| ($"0x($v | str substring $i..($i + 1))" | into int) / 255 }
}

export def rgb-to-hex [--prefix: string = ""]: list<float> -> string {
    $prefix + ($in | each { $in * 255 | round-even | max2 0 (min2 255 $in) | format number | get upperhex | str substring 2.. | fill --alignment right --character "0" --width 2 } | str join)
}

export def rgb-to-hsv []: list<float> -> list<float> {
    let r = $in.0
    let g = $in.1
    let b = $in.2
    let hi = max2 (max2 $r $g) $b
    let d = $hi - (min2 (min2 $r $g) $b)
    let h = if (cmp $d 0) == 0 { 0.0 } else if (cmp $hi $r) == 0 { (($g - $b) / $d) mod 6 } else if (cmp $hi $g) == 0 { ($b - $r) / $d + 2 } else { ($r - $g) / $d + 4 }
    [($h / 6) (if (cmp $hi 0) == 0 { 0.0 } else { $d / $hi }) $hi]
}

export def hsv-to-rgb [h: float, s: float, v: float]: nothing -> list<float> {
    let whole = $h * 6 | into int
    let f = $h * 6 - $whole
    let p = $v * (1 - $s)
    let q = $v * (1 - $f * $s)
    let t = $v * (1 - (1 - $f) * $s)
    [[$v $t $p] [$q $v $p] [$p $v $t] [$p $q $v] [$t $p $v] [$v $p $q]] | get ($whole mod 6)
}

def hsv-apply [rgb: list<float>, change: closure]: nothing -> list<float> {
    let hsv = $rgb | rgb-to-hsv
    let out = do $change $hsv.0 $hsv.1 $hsv.2
    hsv-to-rgb $out.0 $out.1 $out.2
}

export def luminance []: list<float> -> float {
    let c = $in | each { if (cmp $in 0.03928) <= 0 { $in / 12.92 } else { (($in + 0.055) / 1.055) ** 2.4 } }
    0.2126 * $c.0 + 0.7152 * $c.1 + 0.0722 * $c.2
}

export def contrast [a: list<float>, b: list<float>]: nothing -> float {
    let la = $a | luminance
    let lb = $b | luminance
    ((max2 $la $lb) + 0.05) / ((min2 $la $lb) + 0.05)
}

export def quantize []: list<float> -> list<float> { rgb-to-hex | hex-to-rgb }

# Whether fg on bg reaches ratio, compared after quantizing: a float that clears it can round below.
export def passes [fg: list<float>, bg: list<float>, ratio: float]: nothing -> bool {
    (cmp (contrast ($fg | quantize) ($bg | quantize)) $ratio) >= 0
}

export def tone-map [--lo: float = $BG_VALUE_MIN, --hi: float = $BG_VALUE_MAX]: list<float> -> list<float> {
    hsv-apply $in {|h, s, v| [$h $s ($v | clamp $lo $hi)] }
}

export def is-light []: list<float> -> bool { (cmp ($in | luminance) $LIGHT_LUMINANCE) >= 0 }

# A dark background tone-mapped into the band; a light one as is.
export def condition-bg []: list<float> -> list<float> {
    if ($in | is-light) { $in } else { $in | tone-map }
}

export def vivify [min_s: float, min_v: float]: list<float> -> list<float> {
    hsv-apply $in {|h, s, v| [$h (max2 $min_s $s) (max2 $min_v $v)] }
}

# A surface color: value raised by amount, saturation damped.
export def lift [amount: float]: list<float> -> list<float> {
    hsv-apply $in {|h, s, v| [$h ($s * $SURFACE_SATURATION) (min2 1.0 ($v + $amount))] }
}

# A surface color one step away from the background: darker on a light one, lighter on a dark one.
export def shade [amount: float]: list<float> -> list<float> {
    let light = $in | is-light
    hsv-apply $in {|h, s, v| [$h ($s * $SURFACE_SATURATION) (if $light { $v - $amount } else { $v + $amount } | clamp 0.0 1.0)] }
}

export def mix [a: list<float>, b: list<float>, t: float]: nothing -> list<float> {
    [0 1 2] | each {|i| ($a | get $i) * (1 - $t) + ($b | get $i) * $t }
}

def walk [bg: list<float>, start: list<float>, target: list<float>, ratio: float]: nothing -> record {
    mut out = $start
    for _ in 1..$WALK_COUNT_MAX {
        if (passes $out $bg $ratio) { return {ok: true, out: $out} }
        $out = mix $out $target $WALK_STEP
    }
    {ok: false, out: $out}
}

# The input walked toward white or black until it reaches ratio on bg, or the better of walk and target.
export def readable-on [bg: list<float>, --ratio: float = $TEXT_RATIO]: list<float> -> list<float> {
    let target = if (cmp ($bg | luminance) $WHITE_TEXT_LUMINANCE_MAX) < 0 { $WHITE } else { $BLACK }
    let walked = walk $bg $in $target $ratio
    if $walked.ok or (cmp (contrast $target $bg) (contrast $walked.out $bg)) < 0 { $walked.out } else { $target }
}

export def readable-light-on [bg: list<float>, --ratio: float = $TEXT_RATIO]: list<float> -> list<float> {
    (walk $bg $in $WHITE $ratio).out
}

# The input mixed into bg until its contrast drops to ratio.
export def dim-toward [bg: list<float>, --ratio: float = $DIM_RATIO]: list<float> -> list<float> {
    mut out = $in
    for _ in 1..$DIM_COUNT_MAX {
        if (cmp (contrast $out $bg) $ratio) <= 0 { return $out }
        $out = mix $out $bg $DIM_STEP
    }
    $out
}

# The error, warn or ok hue at the input's saturation and value, readable on bg.
export def semantic [role: string, bg: list<float>, --ratio: float = $TEXT_RATIO]: list<float> -> list<float> {
    let hsv = $in | rgb-to-hsv
    let h = $SEMANTIC_HUES | get $role
    let light = $bg | is-light
    mut out = hsv-to-rgb $h ($hsv.1 | clamp 0.45 0.85) (max2 0.55 $hsv.2)
    for _ in 1..$WALK_COUNT_MAX {
        if (passes $out $bg $ratio) { return $out }
        let o = $out | rgb-to-hsv
        let v = if $light { $o.2 / 1.07 } else { min2 1.0 ($o.2 * 1.07) }
        $out = hsv-to-rgb $h (max2 0.35 ($o.1 * 0.96)) $v
    }
    $out
}

# A selection background darkened from the input and the light text readable on it.
export def selection-pair [fg: list<float>, --ratio: float = $TEXT_RATIO]: list<float> -> list<list<float>> {
    let hsv = $in | rgb-to-hsv
    mut v = $hsv.2
    for _ in 1..$SELECTION_COUNT_MAX {
        let cand = hsv-to-rgb $hsv.0 $hsv.1 $v
        if (passes $fg $cand $ratio) or (passes $WHITE $cand $ratio) {
            let light = $fg | readable-light-on $cand --ratio $ratio
            if (passes $light $cand $ratio) { return [$cand $light] }
        }
        $v = $v * $SELECTION_DARKEN
    }
    [(hsv-to-rgb $hsv.0 $hsv.1 $v) $WHITE]
}

# A closure reading a wal slot as rgb (with a fallback hex), or null when colors.json is unreadable.
export def wal-load [program: string]: nothing -> any {
    let file = $nu.home-dir | path join $WAL_COLORS_JSON
    let wal = try { open $file } catch {|e| print --stderr $"($program): cannot read ($file): ($e.msg)"; null }
    if $wal == null { return null }
    let slots = ($wal.special? | default {}) | merge ($wal.colors? | default {})
    {|name: string, fallback: string|
        let value = $slots | get --optional $name | default $fallback
        try { $value | hex-to-rgb } catch { $fallback | hex-to-rgb }
    }
}

# The wal palette as hex: bg fg c0..c15, then light (1/0) and the conditioned bg.
export def palette-slots []: nothing -> list<string> {
    let wal = open ($nu.home-dir | path join $WAL_COLORS_JSON)
    let slots = [$wal.special.background $wal.special.foreground] ++ (0..15 | each {|i| $wal.colors | get $"color($i)" })
    let bad = $slots | where not ($it =~ '^#[0-9A-Fa-f]{6}$')
    if ($bad | is-not-empty) { error make {msg: $"not a #rrggbb colour: ($bad | str join ', ')"} }
    let bg = $slots.0 | hex-to-rgb
    $slots ++ [(if ($bg | is-light) { "1" } else { "0" }) ($bg | condition-bg | rgb-to-hex --prefix "#")]
}

export def style-json []: nothing -> string {
    {
        radius_px: $RADIUS_PX border_px: $BORDER_PX opacity_window: $OPACITY_WINDOW opacity_surface: $OPACITY_SURFACE
        opacity_bar: $OPACITY_BAR text_ratio: $TEXT_RATIO light_luminance: $LIGHT_LUMINANCE
        white_text_luminance_max: $WHITE_TEXT_LUMINANCE_MAX
    } | to json --indent 2 | $"($in)\n"
}

def js-constants []: nothing -> string {
    [$JS_BEGIN ...($JS_CONSTANTS | items {|k, v| $"var ($k) = ($v);" }) $JS_END] | str join "\n"
}

# Whether Palette.js's generated constants block is current; --write regenerates it.
export def palette-js-sync [--write]: nothing -> bool {
    let text = open --raw $PALETTE_JS
    let fresh = $text | str replace --regex $JS_BLOCK (js-constants)
    if $write and $fresh != $text { $fresh | save --force ($PALETTE_JS | path expand) }
    $write or $fresh == $text
}

# Print the slot line: bg fg c0..c15 light bg_conditioned.
def "main shell" []: nothing -> nothing { print (palette-slots | str join " ") }

# Check (or with --write regenerate) Palette.js's constants block.
def "main js" [--write]: nothing -> nothing {
    if not (palette-js-sync --write=$write) {
        print --stderr $"palette.nu: ($PALETTE_JS) is stale, run palette.nu js --write"
        exit 1
    }
}

def main []: nothing -> nothing {
    print --stderr "usage: palette.nu shell | js [--write]"
    exit 2
}
