[ -f ${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.sh ] && source ${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.sh

fpath=(${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions $fpath)
export ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
[[ -d ${ZSH_COMPDUMP:h} ]] || mkdir -p "${ZSH_COMPDUMP:h}"

zmodload -F zsh/stat b:zstat
zsh_init_cache() {
  (( $+commands[$1] )) || return 1
  REPLY=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init-$1.zsh
  local -a ctime_s
  zstat -A ctime_s +ctime -- $commands[$1] $REPLY 2>/dev/null && (( ctime_s[2] > ctime_s[1] )) && return 0
  [[ -d ${REPLY:h} ]] || mkdir -p ${REPLY:h}
  "$@" >| $REPLY.$$ && mv -f $REPLY.$$ $REPLY || { rm -f $REPLY.$$; return 1 }
}

ZSH=/usr/share/oh-my-zsh
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"

autoload -Uz compinit
() {
  setopt local_options extended_glob
  if [[ -n $ZSH_COMPDUMP(#qN.mh+24) ]]; then
    compinit -d "$ZSH_COMPDUMP"
    touch "$ZSH_COMPDUMP"
  else
    compinit -C -d "$ZSH_COMPDUMP"
  fi
  [[ $ZSH_COMPDUMP.zwc -nt $ZSH_COMPDUMP ]] || zcompile "$ZSH_COMPDUMP"
}

zstyle ':omz:alpha:lib:git' async-prompt no
SHOW_AWS_PROMPT=false
for file in $ZSH/lib/{functions,key-bindings,completion,misc,directories,grep,git,clipboard}.zsh \
  $ZSH/plugins/{git,sudo}/*.plugin.zsh; do
  source $file
done
# a tool's plugin only where the tool is
for file in aws docker-compose nmap node npm terraform; do
  (( $+commands[$file] )) && source $ZSH/plugins/$file/$file.plugin.zsh
done
unset file

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
zsh_init_cache fzf --zsh && source $REPLY
source /usr/share/zsh/plugins/fzf-tab-git/fzf-tab.plugin.zsh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

autoload zmv
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^e' edit-command-line

HISTSIZE=5000
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
[[ -d ${HISTFILE:h} ]] || mkdir -p "${HISTFILE:h}"
SAVEHIST=$HISTSIZE
setopt extended_history
setopt hist_verify
setopt hist_find_no_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_save_no_dups
setopt sharehistory

path+=("$HOME/.cargo/bin")
path+=("$HOME/.ghcup/bin")
path+=("${GOPATH:-$HOME/.local/share/go}/bin")
path+=("$HOME/.jai/bin")
# again after /etc/profile.d (nix) prepended its own dirs past zshenv
path=("$HOME/.local/bin" $path)
[[ -r ~/.opam/opam-init/variables.sh ]] && source ~/.opam/opam-init/variables.sh

export DOTFILES="${DOTFILES:-$HOME/projects/arch-dotfiles}"
export EDITOR=nvim
export SHELL=/usr/bin/zsh
export GPG_TTY=$TTY
[[ -n $SSH_CONNECTION ]] && gpg-connect-agent updatestartuptty /bye >/dev/null

alias cp="cp -v"
alias mkdir="mkdir -pv"
alias mv="mv -v"

# an agent harness's shell, by the marker variables cli.nu's AGENT_MARKERS names
agent-session() { [[ -n ${CLAUDECODE-}${AI_AGENT-}${GEMINI_CLI-}${COPILOT_CLI_BINARY_VERSION-} ]] }

# Root for this shell's functions and aliases, only at a person's terminal: an agent or a process without one is
# refused instead of raising a YubiKey request nobody sees. Lint keeps every rc escalation behind it.
sudo-at-terminal() {
  if [[ ! -t 0 || ! -t 2 ]] || agent-session; then
    print -u2 "$1: needs root, run it at your own terminal"
    return 1
  fi
  command sudo "$@"
}

# not in every tmux pane or nvim terminal
[[ -t 1 && $TERM != dumb && -z $TMUX$NVIM ]] && fastfetch

zsh_init_cache starship init zsh --print-full-init && source $REPLY
RPROMPT=
zsh_init_cache direnv hook zsh && source $REPLY

history_file_push() {
  fc -p "$1" $HISTSIZE $SAVEHIST
  history_file_pushed=$1
}

history_file_pop() {
  [[ -n ${history_file_pushed-} ]] || return 0
  fc -P
  history_file_pushed=
}

history_file_follow_direnv() {
  [[ ${DIRENV_HISTFILE-} == ${history_file_pushed-} ]] && return
  history_file_pop
  [[ -z ${DIRENV_HISTFILE-} ]] || history_file_push "$DIRENV_HISTFILE"
}
precmd_functions+=(history_file_follow_direnv)
zsh_init_cache zoxide init zsh && source $REPLY

# drop-ins other modules own: their tools' aliases and functions (shell-aliases), the owner's private ones
for file in ${XDG_CONFIG_HOME:-$HOME/.config}/zsh/conf.d/*.zsh(N); do source $file; done
unset file
