# REPLY = cached output of `<tool> <args>`, rerun only when the tool was installed after the cache was written
zsh_init_cache() {
  (( $+commands[$1] )) || return 1
  REPLY=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init-$1.zsh
  local -a ctime_s
  # ctime, since pacman keeps the package build time as the binary's mtime
  zstat -A ctime_s +ctime -- $commands[$1] $REPLY 2>/dev/null && (( ctime_s[2] > ctime_s[1] )) && return 0
  [[ -d ${REPLY:h} ]] || mkdir -p ${REPLY:h}
  "$@" >| $REPLY.$$ && mv -f $REPLY.$$ $REPLY
}

# plain sourcing from packages (oh-my-zsh-git, fzf-tab-git, zsh-autosuggestions, zsh-syntax-highlighting): no plugin manager
ZSH=/usr/share/oh-my-zsh
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"

autoload -Uz compinit
() {
  setopt local_options extended_glob
  # full check at most daily; touch since compinit keeps an unchanged dump's mtime
  if [[ -n $HOME/.zcompdump(#qN.mh+24) ]]; then
    compinit -d "$HOME/.zcompdump"
    touch "$HOME/.zcompdump"
  else
    compinit -C -d "$HOME/.zcompdump"
  fi
  # source picks up a newer .zwc on its own, bytecode loads faster than parsing the dump
  [[ $HOME/.zcompdump.zwc -nt $HOME/.zcompdump ]] || zcompile "$HOME/.zcompdump"
}

