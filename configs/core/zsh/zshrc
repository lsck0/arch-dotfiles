# sudo only for what changes the system: queries, searches, file lookups and -Sp stay unprivileged (no fido touch);
# `function` so an old shell's pacman alias is not expanded into the name on a re-source
function pacman {
  local arg ops=
  for arg; do
    case $arg in
      --) break ;;
      --query) ops+=Q ;; --deptest) ops+=T ;; --version) ops+=V ;; --help) ops+=h ;;
      --sync) ops+=S ;; --files) ops+=F ;; --search) ops+=s ;; --info) ops+=i ;; --groups) ops+=g ;; --list) ops+=l ;;
      --print) ops+=p ;; --refresh) ops+=y ;; --sysupgrade) ops+=u ;; --clean) ops+=c ;; --downloadonly) ops+=w ;;
      --*) ;;
      -?*) ops+=${arg#-} ;;
    esac
  done
  if [[ $ops == *[QTVh]* || ( $ops == *F* && $ops != *y* ) || ( $ops == *S* && $ops == *[siglp]* && $ops != *[yucw]* ) ]]; then
    command pacman "$@"
  else
    sudo pacman "$@"
  fi
}

# in anonsocks.slice, whose egress guard from `toggle-anonymous-socks.nu on` rejects what proxychains misses (static binaries, raw sockets, udp)
anonymous-socks-proxychains() {
  local rt=${XDG_RUNTIME_DIR:-/run/user/$UID}
  # status, not the marker alone: it also checks every pool port is still our tor's, not a listener another user put there
  [[ "$("$DOTFILES/scripts/toggles/toggle-anonymous-socks.nu" get 2>/dev/null)" == on ]] || { echo "anonymous-socks-proxychains: run scripts/toggles/toggle-anonymous-socks.nu on first" >&2; return 1; }
  systemd-run --user --scope --quiet --slice=anonsocks.slice -- proxychains4 -q -f "${ANONYMOUS_SOCKS_PROXYCHAINS_CONF:-$rt/anonymous-socks-proxychains.conf}" "$@"
}

# no git config covers submodules on the initial clone
git() {
  if [[ "$1" == clone ]]; then
    command git clone --recurse-submodules "${@:2}"
  else
    command git "$@"
  fi
}

# remote control needs feature flags, which DO_NOT_TRACK disables
claude() {
  env -u DO_NOT_TRACK claude "$@"
}

