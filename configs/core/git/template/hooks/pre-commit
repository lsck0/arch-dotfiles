#!/usr/bin/env -S nu --no-config-file
# block commits that introduce secrets; copied into new repos via git's init.templateDir (configs/core/git), and into an
# existing one by running `git init` in it once

def main []: nothing -> nothing {
    if (which gitleaks | is-empty) { return }
    exec gitleaks protect --staged --redact --no-banner
}
