+++ b/configs/hardware/boot/luks/system.sh
@@ -98,11 +98,17 @@ fi
 # sd-encrypt ships the fido2 token plugin; with no token enrolled systemd-cryptsetup falls through to the passphrase or stage.sh's keyfile
