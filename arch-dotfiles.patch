+#!/usr/bin/env bash
+# Block commits that introduce secrets. Installed into new repos via git's init.templateDir (configs/base/git).
+# For an existing repo, run `git init` in it once to copy this hook in.
+command -v gitleaks >/dev/null 2>&1 || exit 0
+exec gitleaks protect --staged --redact --no-banner
diff --git a/configs/base/hardening/modprobe-hardening.conf b/configs/base/hardening/modprobe-hardening.conf
new file mode 100644
index 0000000..fdac3b5
--- /dev/null
+++ b/configs/base/hardening/modprobe-hardening.conf
@@ -0,0 +1,20 @@
+# Disable rarely-used, attack-surface-heavy kernel modules. `install <mod> /bin/true` runs a no-op instead of
+# loading, blocking both autoload and manual modprobe; nothing here is used by this machine's normal operation.
+# (DMA-capable buses and uncommon protocols/filesystems are the classic local/USB attack surface.)
+
+# uncommon network protocols with a long CVE history, never used on a desktop/laptop
+install dccp /bin/true
+install sctp /bin/true
+install rds /bin/true
+install tipc /bin/true
+
+# legacy / rare filesystems (auto-mount attack surface from a malicious USB stick)
+install cramfs /bin/true
+install freevxfs /bin/true
+install jffs2 /bin/true
+install hfs /bin/true
+install hfsplus /bin/true
+
+# FireWire exposes DMA to the physical port; no FireWire devices here
+install firewire-core /bin/true
+install firewire-ohci /bin/true
