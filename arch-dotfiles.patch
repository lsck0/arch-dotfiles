diff --git a/configs/hardware/perf/60-ioschedulers.rules b/configs/hardware/perf/60-ioschedulers.rules
new file mode 100644
index 0000000..ff52ae5
--- /dev/null
+++ b/configs/hardware/perf/60-ioschedulers.rules
@@ -0,0 +1,6 @@
+# I/O scheduler by device class. NVMe has deep hardware queues, so no scheduler ("none") is lowest-overhead and
+# fastest; SATA/eMMC SSDs do best on mq-deadline; spinning disks on bfq for interactivity.
+ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="none"
+ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
+ACTION=="add|change", KERNEL=="mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
+ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
diff --git a/configs/hardware/perf/cpu-governor.service b/configs/hardware/perf/cpu-governor.service
new file mode 100644
index 0000000..d09490f
--- /dev/null
+++ b/configs/hardware/perf/cpu-governor.service
@@ -0,0 +1,12 @@
+[Unit]
+Description=Set CPU frequency governor to @GOVERNOR@
+ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
+
+[Service]
+Type=oneshot
+# writes are best-effort: if @GOVERNOR@ isn't offered by the active cpufreq driver (e.g. amd-pstate active mode
+# exposes only performance/powersave), the write fails and the driver's default stands.
+ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do echo @GOVERNOR@ > "$g" 2>/dev/null || true; done'
+
+[Install]
+WantedBy=multi-user.target
diff --git a/configs/hardware/perf/system.sh b/configs/hardware/perf/system.sh
new file mode 100755
index 0000000..c6aba3d
--- /dev/null
+++ b/configs/hardware/perf/system.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# I/O scheduler tuning (all machines) + a CPU governor policy per form-factor.
+[[ "$FORM_FACTOR" != wsl ]] || exit 0
+
+install -Dm644 60-ioschedulers.rules /etc/udev/rules.d/60-ioschedulers.rules
+udevadm control --reload 2>/dev/null || true
+udevadm trigger --subsystem-match=block 2>/dev/null || true
+
+# desktops: schedutil (balanced, scales with load); laptops are left to tlp's dynamic policy; vm/other: leave default
+case "$FORM_FACTOR" in
+    desktop)
+        file_render cpu-governor.service /etc/systemd/system/cpu-governor.service GOVERNOR=schedutil
+        systemctl daemon-reload
+        systemctl enable --now cpu-governor.service
+        ;;
+    *)
+        systemctl disable --now cpu-governor.service 2>/dev/null || true
+        rm -f /etc/systemd/system/cpu-governor.service
+        systemctl daemon-reload 2>/dev/null || true
+        ;;
+esac
