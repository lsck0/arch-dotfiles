diff --git a/configs/pentesting/metasploit/msfconsole.rc b/configs/pentesting/metasploit/msfconsole.rc
new file mode 100644
index 0000000..7867778
--- /dev/null
+++ b/configs/pentesting/metasploit/msfconsole.rc
@@ -0,0 +1,21 @@
+# ~/.msf4/msfconsole.rc -- runs on every msfconsole start (linked by configs/pentesting/metasploit/link.sh).
+# The database is initialised by configs/pentesting/armitage/link.sh (msfdb). Keep this idempotent and quiet.
+
+setg TimestampOutput true
+setg PromptTimeFormat %H:%M:%S
+setg ConsoleLogging true
+setg SessionLogging true
+setg LogLevel 1
+
+<ruby>
+require "fileutils"
+
+# a persistent default workspace keeps hosts/services/loot tidy; -a is harmless if it already exists
+run_single("workspace -a default") unless framework.db.workspaces.map(&:name).include?("default")
+run_single("workspace default")
+
+# spool a timestamped console log per session for later review
+dir = File.join(Msf::Config.config_directory, "logs")
+FileUtils.mkdir_p(dir)
+run_single("spool #{File.join(dir, "console-#{Time.now.strftime('%Y%m%d-%H%M%S')}.log")}")
+</ruby>
