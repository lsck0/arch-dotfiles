diff --git a/configs/pentesting/metasploit/autoscan.rc b/configs/pentesting/metasploit/autoscan.rc
new file mode 100644
index 0000000..2e3f635
--- /dev/null
+++ b/configs/pentesting/metasploit/autoscan.rc
@@ -0,0 +1,30 @@
+# Discovery + service scan into the metasploit db, then a quick vuln pass. Usage:
+#
+#   RHOSTS=10.0.0.0/24 msfconsole -r ~/.msf4/autoscan.rc
+#   RHOSTS="scanme.nmap.org 10.0.0.5" PORTS=1-1000 msfconsole -r ~/.msf4/autoscan.rc
+#
+# Results land in a per-run workspace (autoscan-<timestamp>); `hosts`, `services` and `vulns` show them.
+# nmap runs as your user here (-Pn -sT -sV), so no root is needed; for SYN/OS scans run msfconsole with sudo
+# and change the db_nmap flags below. Keep scanning authorised targets only.
+
+<ruby>
+targets = (ENV["RHOSTS"] || ENV["TARGETS"] || "").strip
+ports   = (ENV["PORTS"] || "").strip
+
+if targets.empty?
+  print_error("autoscan: set RHOSTS, e.g. RHOSTS=10.0.0.0/24 msfconsole -r ~/.msf4/autoscan.rc")
+else
+  ws = "autoscan-#{Time.now.strftime('%Y%m%d-%H%M%S')}"
+  run_single("workspace -a #{ws}")
+
+  nmap = "db_nmap -Pn -sT -sV --version-light -T4"
+  nmap += ports.empty? ? " --top-ports 1000" : " -p #{ports}"
+  run_single("#{nmap} #{targets}")
+
+  run_single("hosts")
+  run_single("services -u")          # only up services
+  run_single("analyze")              # tag hosts with applicable modules
+  run_single("vulns")
+  print_status("autoscan: done in workspace #{ws}. Next: `services -s http -o http.txt`, `analyze`, or hand a service to a module.")
+end
+</ruby>
