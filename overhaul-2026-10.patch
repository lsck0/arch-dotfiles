+#!/usr/bin/env bash
+
+NETSCANNER=/usr/bin/netscanner
+
+[[ -x "$NETSCANNER" ]] || exit 0
+
+# cap_net_raw for the wireshark group instead of setuid root, reapplied on upgrade by pacman/hooks/netscanner-setcap.hook
+chmod u-s "$NETSCANNER"
