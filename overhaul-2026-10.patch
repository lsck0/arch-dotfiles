+    chgrp wireshark "$NETSCANNER"
+    chmod 750 "$NETSCANNER"
+    setcap cap_net_raw+ep "$NETSCANNER"
+elif [[ -n "$(getcap "$NETSCANNER")" ]]; then
+    setcap -r "$NETSCANNER"
+fi
