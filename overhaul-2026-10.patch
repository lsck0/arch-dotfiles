+
+// frecency: launch count weighted by recency; buckets in ms
+var FRECENCY_BUCKETS = [[86400000, 4], [604800000, 2], [2592000000, 1]]
+var FRECENCY_STALE_WEIGHT = 0.5
+var FRECENCY_MAX_ENTRIES = 200
