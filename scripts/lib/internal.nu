#!/usr/bin/env -S nu --no-config-file
# `dot internal`: what scripts, units and completion run, kept out of dot --help.

const REPO = path self | path expand | path dirname | path dirname | path dirname
const LIB = $REPO | path join scripts lib
use ($LIB | path join log.nu) *
use ($LIB | path join cli.nu) [concat jobs guarded]
use ($LIB | path join complete.nu) [command-table complete-run completions-run module-ids]
use ($LIB | path join platform.nu) [platform-env]
use ($LIB | path join options.nu) [options-events-file]
use ($LIB | path join modules.nu) [modules-packages modules-eval SECRETS_GROUP VERB_WORK_TIMEOUT]
use ($LIB | path join online.nu) [network-online]
use ($LIB | path join pipeline.nu) [pipeline-load pipeline-plan pipeline-apply THEME_VERB_TIMEOUT]
use ($LIB | path join secrets.nu) [secret-is-plaintext secrets-wanted OWNER_WITNESS]
use ($LIB | path join preserve.nu) [preserve-prune]
use ($LIB | path join migrate.nu) [migrations-run]
use ($LIB | path join fetch.nu) [fetch-file-run fetch-git-run]
use ($LIB | path join state.nu) [EXIT_PENDING]
use ($LIB | path join bootstrap.nu) [bootstrap-run PACSTRAP]
use ($LIB | path join commands.nu) [commands-scan commands-used commands-map-load commands-map-render commands-map-resolve module-packages-every packages-every-context COMMANDS_FILE]
use ($LIB | path join stage.nu) [stage-run]
use ($REPO | path join configs base yubikey audit.nu) [audit-remind]
use ($REPO | path join configs core wallust wallpaper.nu) [theme-serve wallpaper-get wallpaper-list]
use ($LIB | path join iso.nu) [iso-build]
use ($LIB | path join iso-install.nu) [iso-install-run]
use ($LIB | path join homelab.nu) [homelab-lab-path homelab-stale homelab-write HOMELAB_FILE]

const DOT = $REPO | path join scripts dot.nu
const MIRROR_LIST = "mirror/packages.txt"
const FEATURES = "FEATURES.md"
const OPTIONS_BEGIN = "<!-- options: generated by dot internal gen from each module's options -->"
const OPTIONS_END = "<!-- options end -->"
const MODULES_BEGIN = "<!-- modules: generated by dot internal gen from configs/ -->"
const MODULES_END = "<!-- modules end -->"
# in order: discord recolours from spotify's palette
const THEME_ORDERED = [socials/spotify socials/discord]

# dot internal <command> --help for each
def main []: nothing -> nothing { help main }

def commands-all []: nothing -> table {
    let dot = $env.DOT_COMMANDS? | default "[]" | from nuon
    $dot ++ (command-table "internal " | where name != "internal complete")
}

# candidates for the last of <words> (the words after `dot`), one `value<tab>description` per line
def --wrapped "main complete" [...words: string]: nothing -> nothing {
    complete-run (commands-all) $words
}

# the shell side of `dot internal complete`: zsh's _dot, or nushell externs generated from the command table
def "main completions" [shell: string@[zsh nu]]: nothing -> nothing {
    completions-run (commands-all) $shell
}

# pinned downloads: a file by its sha256, a git checkout by its commit
def "main fetch" []: nothing -> nothing { help main fetch }

# download a pinned file, verify its sha256, put it in place; --extract <member> or .
def "main fetch file" [url: string, sha256: string, dest: path, --mode: string = "644", --extract: string, --in-place]: nothing -> nothing {
    guarded fetch --background { fetch-file-run $url $sha256 $dest --mode $mode --extract=$extract --in-place=$in_place }
}

# <dir> checked out at exactly <commit>, submodules too
def "main fetch git" [url: string, commit: string, dir: path]: nothing -> nothing {
    guarded fetch --background { fetch-git-run $url $commit $dir }
}

# install a machine from the Arch ISO or set up a fresh WSL distro
def "main bootstrap" [platform: string = ""]: nothing -> nothing {
    guarded bootstrap { bootstrap-run $REPO $platform }
}

# the lsck0 iso's second stage: its answer file and lsck0.* boot parameters as BOOTSTRAP_*, then the bootstrap
def "main iso-install" []: nothing -> nothing {
    guarded iso-install { iso-install-run }
}

# one stage of the unattended install chain (dotfiles-stage.service)
def "main stage" []: nothing -> nothing {
    guarded stage { stage-run $REPO }
}

def mirror-list [ctx: record]: nothing -> string {
    let all = $ctx.modules | where group != $SECRETS_GROUP | update selected true | update cfg { upsert enable true }
    let extras = glob ($REPO | path join platforms *.nuon) | where not ($it | str ends-with ".options.nuon") | each { open $in | get --optional extra_packages | default [] } | flatten
    let every = packages-every-context $REPO
    let candidates = $all | where {|m| "packages" in $m.native } | each { module-packages-every $in $every } | flatten
    let platform = $ctx.platform | update form_factor desktop | update extra_packages ($extras ++ $candidates)
    # the hooks ran above for every profile and option; run again here they would add only this caller's answer
    let fixed = $all | update native { where $it != "packages" }
    modules-packages $REPO $fixed $platform | get pacman | str join "\n" | $"($in)\n"
}

# One row per typed option but enable, public modules only; a null default a detect hook names reads "detected".
def options-table [ctx: record]: nothing -> string {
    let mods = $ctx.modules | where group != $SECRETS_GROUP | sort-by id
    let cell = {|v| $v | into string | str replace --all "|" '\|' }
    let rows = $mods | each {|m|
        let detects = if "detect" in $m.native {
            open --raw ($m.dir | path join mod.nu) | parse --regex '(?ms)(?<body>^export def detect \[.*?^\})' | get --optional 0.body | default ""
        } else { "" }
        $m.options | items {|name, spec|
            let default = if $spec.default != null { $"`($spec.default | to nuon)`" } else if ($detects =~ $"\\b($name):") { "detected" } else { "unset" }
            $"| `($m.id).($name)` | `($spec.type)` | (do $cell $default) | (do $cell ($spec.doc? | default '')) |"
        }
    } | flatten
    ["| option | type | default | what it does |" "|---|---|---|---|"] ++ $rows | str join "\n"
}

# One row per group, public modules only, each named by its path below the group.
def modules-table [ctx: record]: nothing -> string {
    let mods = $ctx.modules | where group != $SECRETS_GROUP and group != ""
    let rows = $mods | group-by group | items {|group, ms|
        let names = $ms | get id | each { str substring ($group | str length | $in + 1).. } | sort | each { $"`($in)`" }
        $"| `($group)` | ($names | str join ', ') |"
    } | sort
    ["| group | modules |" "|---|---|"] ++ $rows | str join "\n"
}

def section-replace [text: string, begin: string, end: string, body: string]: nothing -> string {
    let head = $text | split row $begin | first
    let tail = $text | split row $end | last
    $"($head)($begin)\n($body)\n($end)($tail)"
}

def features-render [ctx: record]: nothing -> string {
    let text = open --raw ($REPO | path join $FEATURES)
    let modules = section-replace $text $MODULES_BEGIN $MODULES_END (modules-table $ctx)
    section-replace $modules $OPTIONS_BEGIN $OPTIONS_END (options-table $ctx)
}

# Each command the modules run, resolved to its package in the repos' sync databases; check compares only the commands.
def commands-render [ctx: record, check: bool]: nothing -> string {
    let used = commands-used (commands-scan $REPO)
    let previous = commands-map-load ($REPO | path join $COMMANDS_FILE)
    if $check { return (if ($previous | columns | sort) == $used { open --raw ($REPO | path join $COMMANDS_FILE) } else { "" }) }
    let every = packages-every-context $REPO
    let declared = $ctx.modules | where group != $SECRETS_GROUP | each { module-packages-every $in $every } | flatten | uniq
    commands-map-render (commands-map-resolve $used $declared $PACSTRAP)
}

# regenerate platforms/homelab.nu (from a present homelab checkout), mirror/packages.txt, scripts/lib/commands.txt and
# FEATURES.md's module and options tables; --check fails when one is stale (for the commands, when the set of commands
# changed; for the homelab file, only against a present checkout)
def "main gen" [--check]: nothing -> nothing {
    guarded gen --background {
        let lab = homelab-lab-path
        if $check and (homelab-stale $REPO $lab) { error make {msg: $"($HOMELAB_FILE) stale against ($lab), run dot internal gen"} }
        # first: the modules' option defaults import it, so FEATURES.md below reads the new values
        if not $check { homelab-write $REPO $lab }
        let ctx = pipeline-load $REPO system
        let outputs = [[file text]; [$MIRROR_LIST (mirror-list $ctx)] [$COMMANDS_FILE (commands-render $ctx $check)] [$FEATURES (features-render $ctx)]]
        if $check {
            let stale = $outputs | where {|o| not ($REPO | path join $o.file | path exists) or (open --raw ($REPO | path join $o.file)) != $o.text } | get file
            if ($stale | is-not-empty) { error make {msg: $"($stale | str join ', ') stale, run dot internal gen"} }
            return
        }
        for o in $outputs { $o.text | save --force ($REPO | path join $o.file) }
    }
}

# build the lsck0 install iso (needs root for mkarchiso); --work or DOT_ISO_WORK, default $XDG_CACHE_HOME/dotfiles-iso
def "main iso" [--out: path, --work: path, --mirror: string, --sign: string, --keep: int = 3]: nothing -> nothing {
    guarded iso { iso-build $out $work $mirror $sign $keep }
}

# declared packages of a kind, one per line; --groups/--form-factor for another machine
def "main packages" [kind: string@[pacman flatpak nix] = "pacman", --groups: string, --form-factor: string]: nothing -> nothing {
    guarded packages --read-only {
        if $kind not-in [pacman flatpak nix] { error make {msg: $"packages: no kind ($kind), one of pacman flatpak nix"} }
        let ctx = pipeline-load $REPO system
        let chosen = $groups | default "" | split row --regex '[ ,]+' | where $it != ""
        let mods = if ($chosen | is-empty) { $ctx.modules } else { $ctx.modules | update selected {|m| $m.group in $chosen or $m.group == "" } }
        let platform = if ($chosen | is-empty) { $ctx.platform } else { $ctx.platform | update extra_packages [] }
        let platform = if $form_factor == null { $platform } else { $platform | update form_factor $form_factor }
        let out = modules-packages $REPO $mods $platform | get $kind
        print (if $kind == "flatpak" { $out | items {|app, commit| $"($app) ($commit)" } } else { $out } | str join "\n")
    }
}

# pending one-time migrations (--system: root's); --baseline marks them run on a fresh install
def "main migrate" [--baseline, --system]: nothing -> nothing {
    guarded migrate {
        let done = migrations-run $REPO (if $system { "system" } else { "user" }) --baseline=$baseline
        if ($done | is-not-empty) { log-info $"migrations (if $baseline { 'marked' } else { 'applied' }): ($done | str join ' ')" }
    }
}

# preserved copies older than <days>, after a yes
def "main prune" [days: int]: nothing -> nothing {
    guarded prune { preserve-prune $days }
}

# every option and live state change as json lines {key, value, source, runtime}
def "main watch" []: nothing -> nothing {
    let file = options-events-file
    mkdir ($file | path dirname)
    if not ($file | path exists) { "" | save $file }
    ^tail --follow=name --retry --lines=0 $file
}

# secret rotation and recovery drill reminders
def "main audit" []: nothing -> nothing { help main audit }

# a notification when the recovery drill is due
def "main audit remind" []: nothing -> nothing { guarded audit { audit-remind } }

# the wallpaper and the theme verbs
def "main theme" []: nothing -> nothing { help main theme }

# the current wallpaper
def "main theme get" []: nothing -> nothing { guarded theme --read-only { print (wallpaper-get) } }
# the wallpapers for the largest monitor
def "main theme list" []: nothing -> nothing { guarded theme --read-only { print (wallpaper-list | str join "\n") } }

# every module's theme verb for this wallpaper; THEME_ORDERED last and in order
def "main theme apply" [wallpaper: path, ...mods: string@module-ids]: nothing -> nothing {
    guarded theme {
        let ctx = pipeline-load $REPO user
        let planned = pipeline-plan $ctx theme $mods true [$wallpaper]
        let results = pipeline-apply $ctx ($planned | where id not-in $THEME_ORDERED) theme (jobs) [$wallpaper] --timeout $THEME_VERB_TIMEOUT
        let ordered_mods = $THEME_ORDERED | each {|id| $planned | where id == $id } | concat | update after []
        let ordered = pipeline-apply $ctx $ordered_mods theme 1 [$wallpaper] --timeout $THEME_VERB_TIMEOUT
        $results ++ $ordered | where not ok | each { log-err $"theme: ($in.id) failed" } | ignore
    }
}

# dot-theme.service's body: the newest requested switch, then any newer one that arrived meanwhile
def "main theme serve" []: nothing -> nothing { theme-serve }

def module-hash [dir: path]: nothing -> string {
    glob $"($dir)/**/*" --no-dir | where not ($it | str ends-with ".log") | sort | each {|f| $"($f) (open --raw $f | hash sha256)" } | str join "\n" | hash sha256
}

def backup-native [ctx: record, m: record]: nothing -> record {
    let r = modules-eval [$m] backup {$m.id: $m.cfg} [] --private=($m.meta.backup?.secrets? | default false) --timeout $VERB_WORK_TIMEOUT | first
    if not $r.ok { log-warn $"backup: ($m.id) failed, its state is from an older run: ($r.error)" }
    $r
}

# every enabled module's update verb: the upgrades of what floats outside pacman (toolchains, editor plugins)
def "main update" []: nothing -> nothing {
    guarded update --background {
        let ctx = pipeline-load $REPO user
        let mods = $ctx.modules | where {|m| "update" in $m.native and $m.cfg.enable }
        # every update downloads
        if not (network-online) { log-note "update: offline, the update verbs run with the next dot sync"; return }
        with-env (platform-env $ctx.platform) {
            # one child each: an update is work, and a batch past its bound would run them all again
            $mods | each {|m| modules-eval [$m] update {$m.id: $m.cfg} [] --timeout $VERB_WORK_TIMEOUT } | flatten
            | where not ok | each {|r| log-warn $"update: ($r.id) failed: ($r.error)" } | ignore
        }
    }
}

# copy live app state into the repo; --roundtrip backs up, restores, backs up and compares
def "main backup" [--roundtrip]: nothing -> nothing {
    guarded backup --background {
        let ctx = pipeline-load $REPO user
        let wanted = secrets-wanted
        let locked = not $wanted or not (secret-is-plaintext ($REPO | path join $OWNER_WITNESS))
        let mods = $ctx.modules | where {|m| "backup" in $m.native and $m.cfg.enable }
        let secret = {|m| $m.meta.backup?.secrets? | default false }
        if not $roundtrip {
            let skipped = $mods | where {|m| (do $secret $m) and $locked }
            with-env (platform-env $ctx.platform) { $mods | where id not-in $skipped.id | each {|m| backup-native $ctx $m } | ignore }
            if $wanted and ($skipped | is-not-empty) { log-warn $"backup: secrets is locked, skipped ($skipped.id | str join ' ')" }
            return
        }
        for m in ($mods | where {|m| not (do $secret $m) }) {
            backup-native $ctx $m | ignore
            let before = module-hash $m.dir
            let home = mktemp --directory
            # its failures stay in the scratch home, out of the checkout's FAILURES.config
            let env_home = {
                HOME: $home, XDG_CONFIG_HOME: $"($home)/.config", XDG_DATA_HOME: $"($home)/.local/share", XDG_STATE_HOME: $"($home)/.local/state"
                XDG_CACHE_HOME: $"($home)/.cache", FAILURES_FILE: $"($home)/failures"
            }
            let restored = with-env $env_home {
                let step = if "restore" in $m.native { [module restore $m.id] } else { [apply --user $m.id] }
                # pending (a download offline) is no part of the backed-up state
                (^nu --no-config-file $DOT ...$step | complete).exit_code in [0 $EXIT_PENDING]
            }
            let again = with-env $env_home { backup-native $ctx $m }
            rm --recursive --force $home
            if not ($restored and $again.ok and (module-hash $m.dir) == $before) { error make {msg: $"backup: ($m.id) round trip changed the module or failed"} }
            log-info $"backup: ($m.id) round trip ok"
        }
    }
}
