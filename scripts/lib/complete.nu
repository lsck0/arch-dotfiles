# Completion for dot from its own command table: `dot internal complete <words>` answers both zsh's _dot and
# the generated nushell externs, so neither goes stale.

use log.nu [runs-dir]
use platform.nu [platform-load]
use modules.nu [modules-discover]
use options.nu [options-schema]
use wallpaper.nu [wallpaper-list]
use cli.nu [concat]

const REPO = path self ../..
const COMPLETE_FILES = "<files>"
const COMPLETE_FILE_SHAPES = [path filepath directory glob]
const COMPLETE_NU_SHAPE = "oneof<bool, string>"
const COMPLETE_DOT = "~/.local/bin/dot"
const COMPLETE_NU_COMPLETER = "nu-complete dot"
const COMPLETE_ZSH = r##'#compdef dot
# generated by `dot internal completions zsh`: every answer comes from `dot internal complete`, so it follows the command table
local dot=~/.local/bin/dot line
local -a lines described
[[ -x $dot ]] || return 1
lines=(${(f)"$($dot internal complete "${(@)words[2,CURRENT]}" </dev/null 2>/dev/null)"})
if [[ ${lines[1]%%$'\t'*} == "<files>" ]]; then
  _files
  return
fi
for line in $lines; do
  described+=("${${line%%$'\t'*}//:/\\:}:${line#*$'\t'}")
done
_describe -t dot-args dot described
'##

def complete-modules []: nothing -> table {
    modules-discover $REPO (platform-load $REPO).groups
}

# Module ids as {value, description}; like every completer here it takes the words typed so far.
export def module-ids [words: list<string>]: nothing -> list<record> {
    complete-modules | each {|m| {value: $m.id, description: ($m.meta.doc? | default "")} }
}

export def option-keys [words: list<string>]: nothing -> list<record> {
    complete-modules | each {|m|
        options-schema $m | items {|key, spec| {value: $"($m.id).($key)", description: ($spec.doc? | default "")} }
    } | concat
}

export def option-values [words: list<string>]: nothing -> list<record> {
    let target = $words | get --optional 0 | default "" | parse --regex '^(?<mod>.+)\.(?<key>[a-z][a-z0-9_]*)$' | get --optional 0
    if $target == null { return [] }
    let m = complete-modules | where id == $target.mod | get --optional 0
    if $m == null { return [] }
    let spec = options-schema $m | get --optional $target.key
    if $spec == null { return [] }
    let values = if ($spec.choices? | is-not-empty) { $spec.choices } else if $spec.type == "bool" { [true false] } else { [] }
    $values | each { {value: ($in | to nuon), description: (if $in == $spec.default? { "default" } else { "" })} }
}

export def theme-names [words: list<string>]: nothing -> list<record> {
    [{value: random, description: "a random wallpaper"}] ++ (wallpaper-list | each { {value: ($in | path basename), description: ""} })
}

export def run-ids [words: list<string>]: nothing -> list<record> {
    ls (runs-dir) | where name ends-with ".jsonl" | sort-by name --reverse | each { {value: ($in.name | path basename | str replace ".jsonl" ""), description: ""} }
}

def complete-values [completion: any, shape: any, words: list<string>]: nothing -> list<record> {
    if ($completion | describe | str starts-with "list") { return ($completion | each { {value: ($in | into string), description: ""} }) }
    match $completion {
        "module-ids" => (module-ids $words)
        "option-keys" => (option-keys $words)
        "option-values" => (option-values $words)
        "theme-names" => (theme-names $words)
        "run-ids" => (run-ids $words)
        _ => (if $shape in $COMPLETE_FILE_SHAPES { [{value: $COMPLETE_FILES, description: ""}] } else { [] })
    }
}

# Every `def "main ..."` in scope as {name, description, params}, name prefixed by prefix.
export def command-table [prefix: string = ""]: nothing -> table {
    scope commands | where name =~ '^main ' | each {|c|
        {
            name: ($c.name | str replace --regex '^main ' $prefix)
            description: ($c.description | lines | get --optional 0 | default "")
            params: ($c.signatures | values | first | where parameter_type not-in [input output] | select parameter_name parameter_type syntax_shape is_optional short_flag description completion)
        }
    }
}

def flag-find [params: table, word: string]: nothing -> any {
    let long = $word | parse --regex '^--(?<name>[^=]+)$' | get --optional 0.name
    let short = $word | parse --regex '^-(?<name>[^-])$' | get --optional 0.name
    $params | where parameter_type in [switch named] | where {|p| $p.parameter_name == $long or ($short != null and $p.short_flag == $short) } | get --optional 0
}

# Prints the candidates for the last word, one `value<tab>description` per line.
export def complete-run [table: table, words: list<string>]: nothing -> nothing {
    let current = $words | last | default ""
    let before = $words | drop 1
    let lead = $before | take while { not ($in | str starts-with "-") }
    let depth = seq 0 ($lead | length) | reverse | where {|n|
        let prefix = $lead | first $n | str join " "
        $n == 0 or ($table.name | any {|t| $t == $prefix or ($t | str starts-with $"($prefix) ") })
    } | first
    let name = $lead | first $depth | str join " "
    let params = $table | where name == $name | get --optional 0.params | default []
    let rest = $before | skip $depth
    mut positionals = []
    mut pending: any = null
    for word in $rest {
        if $pending != null { $pending = null; continue }
        let flag = flag-find $params $word
        if $flag != null { if $flag.parameter_type == "named" { $pending = $flag }; continue }
        $positionals = $positionals | append $word
    }
    let candidates = if $pending != null {
        complete-values $pending.completion $pending.syntax_shape $positionals
    } else if ($current | str starts-with "-") {
        $params | where parameter_type in [switch named] | each {|p| {value: $"--($p.parameter_name)", description: ($p.description | default "")} }
        | append {value: "--help", description: "flags and usage"}
    } else {
        let subs = if ($rest | is-not-empty) { [] } else {
            $table | where {|c| ($c.name | split row " " | length) > $depth and ($depth == 0 or ($c.name | str starts-with $"($name) ")) }
            | each {|c| $c.name | split row " " | get $depth } | uniq | each {|word|
                let full = $lead | first $depth | append $word | str join " "
                {value: $word, description: ($table | where name == $full | get --optional 0.description | default "")}
            }
        }
        let fixed = $params | where parameter_type == positional
        let index = $positionals | length
        let param = if $index < ($fixed | length) { $fixed | get $index } else { $params | where parameter_type == rest | get --optional 0 }
        let values = if $param == null { [] } else { complete-values $param.completion $param.syntax_shape $positionals }
        if ($values | any { $in.value == $COMPLETE_FILES }) and ($subs | is-empty) { $values } else { $subs ++ ($values | where value != $COMPLETE_FILES) }
    }
    $candidates | each { $"($in.value)\t($in.description | str replace --all "\n" ' ')" } | each { $"($in)\n" } | str join | print --no-newline
}

def completions-nu-param [p: record]: nothing -> string {
    let shape = if $p.syntax_shape == "path" { "path" } else { $COMPLETE_NU_SHAPE }
    let completer = if $p.completion == null {
        ""
    } else if ($p.completion | describe | str starts-with "list") {
        $"@($p.completion | each { into string } | to nuon)"
    } else {
        $"@'($COMPLETE_NU_COMPLETER)'"
    }
    let short = if $p.short_flag == null { "" } else { $"\(-($p.short_flag)\)" }
    match $p.parameter_type {
        "positional" => $"($p.parameter_name)(if $p.is_optional { '?' } else { '' }): ($shape)($completer)"
        "rest" => $"...($p.parameter_name): ($shape)($completer)"
        "switch" => $"--($p.parameter_name)($short)"
        "named" => $"--($p.parameter_name)($short): ($shape)($completer)"
    }
}

# Prints zsh's _dot or the nushell externs for the table.
export def completions-run [table: table, shell: string]: nothing -> nothing {
    match $shell {
        "zsh" => { print -n $COMPLETE_ZSH }
        "nu" => {
            let externs = $table | where name not-in ["internal completions"] | each {|c|
                let params = $c.params | each { completions-nu-param $in } | append "--help(-h)" | str join ", "
                [(if $c.description != "" { $"# ($c.description)" }) $"extern \"dot ($c.name)\" [($params)]"] | compact | str join "\n"
            }
            [
                "# generated by `dot internal completions nu` from dot's command table"
                $"def \"($COMPLETE_NU_COMPLETER)\" [context: string] {"
                $"    ^\('($COMPLETE_DOT)' | path expand\) internal complete ...\($context | split row ' ' | skip 1\) | complete | get stdout | lines"
                "    | each { split row \"\\t\" | {value: $in.0, description: ($in.1? | default '')} }"
                "}"
                ""
                ($externs | str join "\n\n")
            ] | str join "\n" | print
        }
        _ => { error make {msg: $"no completions for ($shell), one of zsh nu"} }
    }
}
