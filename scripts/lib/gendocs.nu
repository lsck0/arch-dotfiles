# docs/generated.md from the tree, never by hand: each platform's groups, the modules with their layers and
# dependencies, the systemd units the modules ship and the toggles

use modules.nu [modules-discover]
use platform.nu [platform-groups-all]

const REPO = path self ../..
const OUT = "docs/generated.md"
const UNIT_EXT = '\.(service|timer|socket|path|mount|automount|target)$'
const USER_VERBS = [link theme apply backup restore]

const HEADER = "# Generated reference

<!-- generated by dot gen from the tree, do not edit; dot test lint fails when it drifts -->

What the tree declares, derived from it: edit the files named here, then run `dot gen`.

## Platforms

`platforms/<host>.nuon`: the groups each machine installs and configures \(none set means every group\).

| platform | groups |
|---|---|"

const MODULES_HEADER = "
## Groups and modules

A module is a dir under `configs/<group>/` with a `mod.nu`: `user` for a link, theme or apply verb, `system` for a
system verb, `test` for a `*.test.nu` or `*.test.sh` beside it. Base is every group's implicit dependency."

const GRAPH_HEADER = "
## Dependency graph

From each group's `dependencies.txt` (`dot test lint` fails on an undeclared cross-group reference) and each module's
`meta.deps` (a dependency applies first).

```mermaid
graph LR"

const UNITS_HEADER = "
## Systemd units

Unit files the modules ship, by the layer whose verb names them.

| unit | module | layer | description | schedule |
|---|---|---|---|---|"

const KEYBINDS_FILE = "configs/desktop/hyprland/hyprland_keybindings.lua"
const KEYBINDS_RUNNER = "scripts/lib/hyprland-binds.lua"
const KEYBINDS_HEADER = "
## Keybinds

Every `hl.bind` in `configs/desktop/hyprland/hyprland_keybindings.lua` with its `description`, read by running the file
against a recording `hl` \(`scripts/lib/hyprland-binds.lua`\). Keys with one description share a row; a submap's keys
apply only while it is active."

const TOGGLES_HEADER = "
## Toggles

`scripts/toggles/toggle-<name>.nu`, walked by `status.nu` for quickshell and `menu.nu`.
"

# the lint walk: tracked plus untracked-not-ignored, minus deleted, so logs and local leftovers never document
def files []: nothing -> list<string> {
    ^git -C $REPO ls-files --cached --others --exclude-standard | lines | uniq | sort
    | where { $REPO | path join $in | path exists }
}

def cell [text: string]: nothing -> string { $text | str replace --all "|" '\|' }

def unit-value [text: string, key: string]: nothing -> string {
    $text | lines | where ($it | str starts-with $"($key)=") | get --optional 0 | default ""
    | str substring (($key | str length) + 1).. | cell $in
}

# a group's dependencies.txt: the other groups its files reach into
def group-deps [group: string]: nothing -> list<string> {
    let file = $REPO | path join configs $group dependencies.txt
    if not ($file | path exists) { return [] }
    open --raw $file | lines | each { split row "#" | first | str trim | split row " " | first }
    | where $it != "" | uniq | sort
}

# the layer of each export in <mod.nu> whose body names <name>
def verbs-naming [file: path, name: string]: nothing -> list<string> {
    open --raw $file | split row "\nexport def " | skip 1
    | where ($it | str contains $name)
    | each { if ($in | str starts-with "system ") { "system" } else { "user" } } | uniq | sort
}

# the nearest mod.nu up from the unit that names it
def unit-layer [unit: string]: nothing -> string {
    let name = $unit | path basename
    mut dir = $unit | path dirname
    while ($dir | str starts-with configs/) {
        let mod = $REPO | path join $dir mod.nu
        let found = if ($mod | path exists) { verbs-naming $mod $name } else { [] }
        if ($found | is-not-empty) { return ($found | str join ", ") }
        $dir = $dir | path dirname
    }
    "?"
}

# one table per submap, the global binds first; a bind without a description fails, so the table never loses a key
def keybinds []: nothing -> list<string> {
    let binds = ^lua ($REPO | path join $KEYBINDS_RUNNER) ($REPO | path join $KEYBINDS_FILE)
        | lines | split column "\t" submap keys description
    let bare = $binds | where description == ""
    if ($bare | is-not-empty) {
        error make {msg: $"($KEYBINDS_FILE): binds without a description: ($bare.keys | str join ', ')"}
    }
    $binds.submap | uniq | each {|submap|
        let rows = $binds | where submap == $submap | get description | uniq | each {|description|
            let keys = $binds | where submap == $submap and description == $description
                | get keys | each { str replace --all " + " "+" | $"`($in)`" } | str join ", "
            $"| (cell $keys) | (cell $description) |"
        }
        let title = if $submap == "" { "Global" } else { $"Submap `($submap)`" }
        ["" $"### ($title)" "" "| keys | action |" "|---|---|" ...$rows]
    } | flatten
}

export def gendocs-render []: nothing -> string {
    let tree = files
    let platform_files = $tree | where $it =~ '^platforms/[^/]+\.nuon$' and not ($it | str ends-with ".options.nuon")
    let platforms = $platform_files | each {|f|
        let groups = open ($REPO | path join $f) | get groups? | default []
        $"| ($f | path parse | get stem) | (if ($groups | is-empty) { '(all)' } else { $groups | str join ' ' }) |"
    }
    let modules = modules-discover $REPO (platform-groups-all $REPO) | where group != ""
    let groups = $modules | group-by group | items {|group, mods|
        let rows = $mods | sort-by id | each {|m|
            let layers = [
                (if ($m.verbs | any { $in in $USER_VERBS }) { "user" })
                (if "system" in $m.verbs { "system" })
                (if (glob ($m.dir | path join "*.test.{nu,sh}") | is-not-empty) { "test" })
            ] | compact
            let name = $m.id | str substring (($group | str length) + 1).. | default --empty '(group)'
            $"| ($name) | ($layers | str join ', ') |"
        }
        let deps = group-deps $group
        let depends = if ($deps | is-empty) { [] } else { [$"Depends on: ($deps | str join ', ')." ""] }
        ["" $"### ($group)" "" ...$depends "| module | layers |" "|---|---|"] ++ $rows
    } | flatten
    let group_edges = $modules.group | uniq | sort
        | each {|g| group-deps $g | each { $"    ($g) --> ($in)" } } | flatten
    let module_edges = $modules | each {|m| $m.meta.deps | each { $"    ($m.id) --> ($in)" } } | flatten | sort
    let edges = $group_edges ++ $module_edges
    let units = $tree | where $it =~ '^configs/.+' and $it =~ $UNIT_EXT | each {|unit|
        let text = open --raw ($REPO | path join $unit)
        # dbus activation files share the .service suffix
        if ($text | str contains "[D-BUS Service]") { return null }
        let schedule = if ($unit | str ends-with .timer) {
            $text | lines | where $it =~ '^On[A-Za-z]+=' | str join " " | cell $in
        } else { "" }
        {
            name: ($unit | path basename), module: ($unit | path dirname | str replace --regex '^configs/' '')
            layer: (unit-layer $unit), text: $text, schedule: $schedule
        }
    } | compact | sort-by module name
    | each { $"| ($in.name) | ($in.module) | ($in.layer) | (unit-value $in.text Description) | ($in.schedule) |" }
    let toggles = $tree | parse --regex '^scripts/toggles/toggle-(?<name>.*)\.nu$' | each { $"- ($in.name)" }
    [
        $HEADER ...$platforms $MODULES_HEADER ...$groups $GRAPH_HEADER ...$edges "```" $UNITS_HEADER ...$units
        $KEYBINDS_HEADER ...(keybinds) $TOGGLES_HEADER ...$toggles
    ]
    | str join "\n" | $"($in)\n"
}

# write docs/generated.md; --check writes nothing and fails with the diff when the file no longer matches the tree
export def gendocs-run [--check]: nothing -> nothing {
    let out = $REPO | path join $OUT
    let text = gendocs-render
    if not $check {
        mkdir ($out | path dirname)
        $text | save --force $out
        print -e $"gen: wrote ($OUT)"
        return
    }
    if not ($out | path exists) or (open --raw $out) != $text {
        let fresh = mktemp --tmpdir
        $text | save --force $fresh
        print (do { ^diff -u --label $OUT --label generated $out $fresh } | complete | get stdout)
        rm --force $fresh
        error make {msg: $"($OUT) drifted from the tree, run dot gen"}
    }
}
