# The homelab's lab.json rendered into platforms/homelab.nu, the values the dotfiles take from the lab. dot internal gen
# writes it from a present checkout; it is committed, so the system layer and a fresh install, which has no checkout
# before the secrets are unlocked, read the same values.

use options.nu [options-to-nuon]

export const HOMELAB_FILE = "platforms/homelab.nu"
# configs/base/pacman/pacman.conf's [lsck0] Server, filled with mirror.lsck0 by base/pacman and the iso
export const LSCK0_SERVER_PLACEHOLDER = "@LSCK0_SERVER@"
const LAB_RELATIVE = "src/generated/lab.json"
const LAB_SCHEMA = 1
const IPV4 = '^(\d{1,3}\.){3}\d{1,3}$'
const CIDR4 = '^(?<net>(\d{1,3}\.){3}\d{1,3})/(?<bits>\d{1,2})$'
const FINGERPRINT = '^[0-9A-F]{40}$'
const OCTET_BITS = 8
const HEAD = "# Generated by dot internal gen from the homelab's src/generated/lab.json: change the lab, then run the gen.
# Committed, so the system layer and a fresh install read it without a homelab checkout.
"

# The checkout's lab.json ($HOMELAB_DIR or ~/projects/homelab), null when there is none.
export def homelab-lab-path []: nothing -> any {
    let lab = $env.HOMELAB_DIR? | default ($nu.home-dir | path join projects homelab) | path join $LAB_RELATIVE
    if ($lab | path exists) { $lab }
}

# A subnet on an octet boundary as an ssh or shell case glob: 10.100.0.0/24 -> 10.100.0.*
export def homelab-subnet-glob [subnet: string]: nothing -> string {
    let parsed = $subnet | parse --regex $CIDR4 | first
    let bits = $parsed.bits | into int
    if $bits mod $OCTET_BITS != 0 { error make {msg: $"homelab: subnet ($subnet) is not on an octet boundary"} }
    $parsed.net | split row "." | first ($bits // $OCTET_BITS) | append "*" | str join "."
}

def field [lab: record, path: cell-path, shape: string]: nothing -> string {
    let value = $lab | get --optional $path
    if ($value | describe) != "string" or not ($value =~ $shape) {
        error make {msg: $"homelab: lab.json ($path | to nuon) is ($value | to nuon), not of the shape ($shape)"}
    }
    $value
}

# The generated file's text for one lab.json; fails on a schema or a value it does not know.
export def homelab-render [lab: record]: nothing -> string {
    if $lab.schema? != $LAB_SCHEMA { error make {msg: $"homelab: lab.json schema ($lab.schema? | to nuon), wants ($LAB_SCHEMA)"} }
    let zones = $lab.zones? | default {}
    if ($zones | is-empty) { error make {msg: "homelab: lab.json has no zones"} }
    let subnets = $zones | columns | each {|zone| field $lab ([zones $zone subnet] | into cell-path) $CIDR4 } | sort
    let router = field $lab $.router $IPV4
    let hypervisor = field $lab $.proxmox.ip $IPV4
    let values = {
        domain: (field $lab $.domain '^[A-Za-z0-9.-]+$')
        router: $router
        hypervisor: $hypervisor
        subnets: $subnets
        ssh_hosts: ($subnets | each { homelab-subnet-glob $in } | append [$router $hypervisor])
        nas: {
            ip: (field $lab $.nas.ip $IPV4)
            smb: (field $lab $.nas.smb '^//\S+/\S+$')
            syncthing: (field $lab $.nas.syncthing '^tcp://\S+:\d+$')
        }
        mirror: {
            arch: (field $lab $.mirror.arch '^https?://\S+\$repo\S*\$arch$')
            lsck0: (field $lab $.mirror.lsck0 '^https://\S+\$arch$')
            isoSigner: (field $lab $.mirror.isoSigner $FINGERPRINT)
        }
    }
    $"($HEAD)\nexport const HOMELAB = ($values | options-to-nuon)\n"
}

# Whether repo's generated file differs from what lab renders to; no lab (no checkout) is never stale.
export def homelab-stale [repo: path, lab: any]: nothing -> bool {
    if $lab == null { return false }
    let file = $repo | path join $HOMELAB_FILE
    not ($file | path exists) or (open --raw $file) != (homelab-render (open $lab))
}

# Writes repo's generated file from lab; without a lab the committed file stays.
export def homelab-write [repo: path, lab: any]: nothing -> nothing {
    if $lab == null { return }
    homelab-render (open $lab) | save --force ($repo | path join $HOMELAB_FILE)
}
