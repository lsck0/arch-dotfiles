# The homelab's lab.json rendered into platforms/homelab.nu, the values the dotfiles take from the lab. dot internal gen
# writes it from a present checkout; it is committed, so the system layer and a fresh install, which has no checkout
# before the secrets are unlocked, read the same values.

use options.nu [options-to-nuon]
use ../../platforms/homelab.nu [HOMELAB]

export const HOMELAB_FILE = "platforms/homelab.nu"
# configs/base/pacman/config/pacman.conf's [lsck0] Server, filled with mirror.lsck0 by base/pacman and the iso
export const LSCK0_SERVER_PLACEHOLDER = "@LSCK0_SERVER@"
export const LSCK0_SECTION = "[lsck0]"
const LSCK0_PROBE_TIMEOUT_S = 5
const LAB_RELATIVE = "src/generated/lab.json"
# beside lab.json: the lab's published public keys by name
const KEYS_FILE = "ssh-keys.json"
const BUILDER_ROLE = "app-builder"
# the builder's key for programming/offload's worker, absent until the lab publishes it
const BUILDER_KEY = "desktop-worker-key"
const ED25519 = '^ssh-ed25519 [A-Za-z0-9+/]+={0,2}( [A-Za-z0-9@._-]+)?$'
const LAB_SCHEMA = 1
const IPV4 = '^(\d{1,3}\.){3}\d{1,3}$'
const CIDR4 = '^(?<net>(\d{1,3}\.){3}\d{1,3})/(?<bits>\d{1,2})$'
const FINGERPRINT = '^[0-9A-F]{40}$'
const OCTET_BITS = 8
const HEAD = $"# Generated by dot internal gen from the homelab's ($LAB_RELATIVE): change the lab, then run the gen.
# Committed, so the system layer and a fresh install read it without a homelab checkout.
"

# Whether the lab's [lsck0] repo answers from here: its x86_64 database, one byte of it.
export def lsck0-reachable []: nothing -> bool {
    let db = ($HOMELAB.mirror.lsck0 | str replace '$arch' x86_64) + "/lsck0.db"
    (^curl -fs -m $LSCK0_PROBE_TIMEOUT_S -r 0-0 -o /dev/null $db | complete).exit_code == 0
}

# A pacman.conf's lines inside its [lsck0] section, header included, and outside it.
def lsck0-split []: string -> record {
    $in | lines | reduce --fold {inside: [], outside: [], in_section: false} {|l, acc|
        let in_section = if ($l | str starts-with "[") { $l == $LSCK0_SECTION } else { $acc.in_section }
        let side = if $in_section { "inside" } else { "outside" }
        $acc | update $side { append $l } | update in_section $in_section
    }
}

# A pacman.conf without its [lsck0] section: a machine off the lab syncs core, extra and multilib alone, where an
# unreachable Required repo would fail every pacman -Sy.
export def lsck0-drop []: string -> string {
    lsck0-split | get outside | to text
}

# A pacman.conf's [lsck0] section alone, for the iso's live pacman.conf.
export def lsck0-section []: string -> string {
    lsck0-split | get inside | str join "\n"
}

# The checkout's lab.json ($HOMELAB_DIR or ~/projects/homelab), null when there is none.
export def homelab-lab-path []: nothing -> any {
    let lab = $env.HOMELAB_DIR? | default ($nu.home-dir | path join projects homelab) | path join $LAB_RELATIVE
    if ($lab | path exists) { $lab }
}

# The checkout's lab.json, null when there is none or its schema is not the one this repo reads.
export def homelab-lab-load []: nothing -> any {
    let lab = try { open (homelab-lab-path) } catch { null }
    if ($lab | describe) =~ '^record' and $lab.schema? == $LAB_SCHEMA { $lab }
}

# A subnet on an octet boundary as an ssh or shell case glob: 10.100.0.0/24 -> 10.100.0.*
export def homelab-subnet-glob [subnet: string]: nothing -> string {
    let parsed = $subnet | parse --regex $CIDR4 | first
    let bits = $parsed.bits | into int
    if $bits mod $OCTET_BITS != 0 { error make {msg: $"homelab: subnet ($subnet) is not on an octet boundary"} }
    $parsed.net | split row "." | first ($bits // $OCTET_BITS) | append "*" | str join "."
}

def field [lab: record, path: cell-path, shape: string]: nothing -> string {
    let value = $lab | get --optional $path
    if ($value | describe) != "string" or not ($value =~ $shape) {
        error make {msg: $"homelab: lab.json ($path | to nuon) is ($value | to nuon), not of the shape ($shape)"}
    }
    $value
}

# The guest the lab builds on, by its role, with the worker key the lab published for it (null until then); null when
# no guest has the role.
def builder-render [lab: record, keys: any]: nothing -> any {
    let guests = $lab.guests? | default {} | values | where { $BUILDER_ROLE in ($in.roles? | default []) }
    if ($guests | is-empty) { return null }
    if ($guests | length) > 1 { error make {msg: $"homelab: lab.json has more than one ($BUILDER_ROLE) guest"} }
    let ip = $guests.0.ip?
    if ($ip | describe) != "string" or not ($ip =~ $IPV4) {
        error make {msg: $"homelab: lab.json's ($BUILDER_ROLE) guest has the ip ($ip | to nuon)"}
    }
    let key = if ($keys | describe) =~ '^record' { $keys | get --optional $BUILDER_KEY }
    if $key != null and (($key | describe) != "string" or not ($key =~ $ED25519)) {
        error make {msg: $"homelab: ($KEYS_FILE) ($BUILDER_KEY) is no ed25519 public key line"}
    }
    {ip: $ip, key: $key}
}

# The lab's Wazuh manager for base/wazuh's agent, null when the lab runs none.
def wazuh-render [lab: record]: nothing -> any {
    let wazuh = $lab.wazuh?
    if $wazuh == null { return null }
    let port = {|key|
        let value = $wazuh | get --optional $key
        if ($value | describe) != "int" or $value not-in 1..65535 {
            error make {msg: $"homelab: lab.json wazuh.($key) is ($value | to nuon), not a port"}
        }
        $value
    }
    {
        manager: (field $lab $.wazuh.manager $IPV4)
        events: (do $port events)
        enrollment: (do $port enrollment)
        version: (field $lab $.wazuh.version '^\d+\.\d+\.\d+$')
        secret: (field $lab $.wazuh.secret '^[a-z0-9-]+$')
    }
}

# The generated file's text for one lab.json and its ssh-keys.json (null when absent); fails on a schema or a value it
# does not know.
export def homelab-render [lab: record, keys: any = null, source: any = null]: nothing -> string {
    if $lab.schema? != $LAB_SCHEMA { error make {msg: $"homelab: lab.json schema ($lab.schema? | to nuon), wants ($LAB_SCHEMA)"} }
    let zones = $lab.zones? | default {}
    if ($zones | is-empty) { error make {msg: "homelab: lab.json has no zones"} }
    # the wireguard tunnel is a lab network too: every reader of the subnets (homelab dns, routes, ssh hosts) covers it
    let subnets = $zones | columns | each {|zone| field $lab ([zones $zone subnet] | into cell-path) $CIDR4 }
        | append (field $lab $.wireguard.subnet $CIDR4) | sort
    let router = field $lab $.router $IPV4
    let hypervisor = field $lab $.proxmox.ip $IPV4
    let values = {
        domain: (field $lab $.domain '^[A-Za-z0-9.-]+$')
        router: $router
        hypervisor: $hypervisor
        subnets: $subnets
        ssh_hosts: ($subnets | each { homelab-subnet-glob $in } | append [$router $hypervisor])
        nas: {
            ip: (field $lab $.nas.ip $IPV4)
            smb: (field $lab $.nas.smb '^//\S+/\S+$')
            syncthing: (field $lab $.nas.syncthing '^tcp://\S+:\d+$')
            # the share-relative dir of re-downloadable installers and engines, outside syncthing and every backup
            vendor: (field $lab $.nas.vendor '^[a-z0-9_-]+(/[a-z0-9_-]+)*$')
        }
        mirror: {
            arch: (field $lab $.mirror.arch '^https?://\S+\$repo\S*\$arch$')
            lsck0: (field $lab $.mirror.lsck0 '^https://\S+\$arch$')
            isoSigner: (field $lab $.mirror.isoSigner $FINGERPRINT)
        }
        # core/alloy's push doors: each desktop's node metrics and journal, basic auth per machine
        push: {
            prometheus: (field $lab $.monitoring.push.prometheus '^https://\S+$')
            loki: (field $lab $.monitoring.push.loki '^https://\S+$')
            desktops: ($lab.monitoring.push.desktops | each {|d| if ($d =~ '^[a-z0-9-]+$') { $d } else { error make {msg: $"homelab: lab.json monitoring.push.desktops has ($d | to nuon), not of the shape ^[a-z0-9-]+$"} } })
        }
        # programming/offload's worker: the one guest that logs in to it, and with which key
        builder: (builder-render $lab $keys)
        # base/wazuh's agent: where it enrolls and reports, and the secret holding the enrollment password
        wazuh: (wazuh-render $lab)
    }
    let text = $"($HEAD)\nexport const HOMELAB = ($values | options-to-nuon)\n"
    if $source == null { return $text }
    $"($text)\n# lab.json's commit date: a checkout behind it never rewrites this file\nexport const HOMELAB_SOURCE = \"($source | format date '%Y-%m-%dT%H:%M:%S%:z')\"\n"
}

def keys-load [lab: path]: nothing -> any {
    let file = $lab | path dirname | path join $KEYS_FILE
    if ($file | path exists) { open $file }
}

# lab.json's last commit date in its checkout, its mtime while it has uncommitted changes, null outside git.
def lab-date [lab: path]: nothing -> any {
    let dir = $lab | path dirname
    let dirty = ^git -C $dir status --porcelain -- $lab | complete
    if $dirty.exit_code != 0 { return null }
    if ($dirty.stdout | str trim) != "" { return (ls --long $lab | get 0.modified) }
    let date = ^git -C $dir log -1 --format=%cI -- $lab | complete | get stdout | str trim
    if $date != "" { $date | into datetime }
}

# The lab.json date the committed file was rendered from, null when it records none.
def recorded-date [file: path]: nothing -> any {
    if not ($file | path exists) { return null }
    let found = open --raw $file | parse --regex '(?m)^export const HOMELAB_SOURCE = "(?<date>[^"]+)"$'
    if ($found | is-not-empty) { $found.0.date | into datetime }
}

# The file to write for lab, null when lab is absent or older than what the committed file was rendered from: a
# checkout not pulled since would take back the lab's newer values.
def lab-text [repo: path, lab: any]: nothing -> any {
    if $lab == null { return null }
    let date = lab-date $lab
    let known = recorded-date ($repo | path join $HOMELAB_FILE)
    if $date != null and $known != null and $date < $known { return null }
    homelab-render (open $lab) (keys-load $lab) $date
}

# Whether repo's generated file differs from what lab renders to; no lab (no checkout) or one behind is never stale.
export def homelab-stale [repo: path, lab: any]: nothing -> bool {
    let text = lab-text $repo $lab
    let file = $repo | path join $HOMELAB_FILE
    $text != null and (not ($file | path exists) or (open --raw $file) != $text)
}

# Writes repo's generated file from lab; without a lab, or with one behind, the committed file stays.
export def homelab-write [repo: path, lab: any]: nothing -> nothing {
    let text = lab-text $repo $lab
    if $text == null {
        if $lab != null { print --stderr $"homelab: ($lab) is behind ($HOMELAB_FILE), kept; pull the homelab checkout" }
        return
    }
    $text | save --force ($repo | path join $HOMELAB_FILE)
}
