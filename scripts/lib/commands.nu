# The external commands each public module runs and the packages that bring them: dot internal gen writes the map,
# dot test lint checks every call against the module's declared packages, its deps' and the pacstrap set.

use modules.nu [modules-eval SECRETS_GROUP]
use state.nu [xdg]

export const COMMANDS_FILE = "scripts/lib/commands.txt"
export const ALLOW_FILE = "scripts/lib/commands-allow.txt"
const COMMANDS_HEAD = "# generated by dot internal gen from the repos' sync databases: a command the modules run, its package, the
# declared packages that bring it; base: in the pacstrap closure; -: in no repo package (the repo's own, a user install)"
export const OWNER_BASE = "base"
export const OWNER_NONE = "-"
# the sync databases gen resolves against, fetched as the user: pacman -Fy and pactree need no root on a dbpath of theirs
const SYNC_DB_CACHE = [dotfiles pacman-sync]
const SYNC_DB_KINDS = [db files]
const SYNC_DB_CONNECT_S = 5
# usrmerge: every bin dir is /usr/bin, which is where the files databases list them
const BIN_DIRS = '^/(?:usr/)?s?bin/'
const BIN_DIR = "usr/bin/"
# a config home no login has: profile-load under it reads no profile and no options but PROFILE_FILE
const PROFILE_HOME_NONE = "/nonexistent"
# PACSTRAP in bootstrap.nu plus the microcode it adds
const BASE_EXTRA = [amd-ucode intel-ucode]
# the repo's own commands and a user's installs, never a package's
const PATHS_EXEMPT = '^(/usr/local/|/home/|/root/|/etc/|/run/|/var/|/tmp/|%h|~|\$)|@'
const PATHS_PACKAGED = '^(/usr/|/bin/|/sbin/)'
const UNIT_GLOB = "**/*.{service,timer,socket,path,mount}"
# wallust's templates carry its placeholders, not code
const TEMPLATES_GLOB = "core/wallust/templates/**"
const QUOTED = r#''[^']*'|"(?:[^"\\]|\\.)*"|`[^`]*`'#
const COMMAND_NAME = '^[A-Za-z0-9_/][\w./+-]*$'
const LIB_DIR = path self .
# nu's parser tells an external from a builtin or a def; its flattened tokens carry these shapes
const SHAPE_EXTERNAL = "shape_external"
const SHAPE_CALL = "shape_internalcall"
const SHAPE_LIST = "shape_list"
const SHAPE_BLOCK = "shape_block"
const SHAPE_FLAG = "shape_flag"
const SHAPE_VARIABLE = "shape_variable"
const SHAPE_INTERPOLATION = "shape_string_interpolation"
const ARG_WORD_SHAPES = [shape_externalarg shape_globpattern shape_string]
const ARG_DYNAMIC_SHAPES = [shape_variable shape_string_interpolation]
# what ends an external's arguments in the text between two tokens
const ARG_END = '[|;]'
# a word known only at run time: a variable, an interpolation, a subexpression
const WORD_COMPUTED = ""
const CONST_NAME = '^\$[A-Z][A-Z0-9_]*$'
# Commands that run another one: the options that take a value, and the positionals before the command (timeout's
# duration, flock's lock file); an option in stop takes the command as a shell string, which is not followed.
const WRAPPERS = {
    timeout: {values: [-s --signal -k --kill-after], before: 1, stop: []}
    sudo: {values: [-u --user -g --group -C --close-from -D --chdir -h --host -p --prompt -r --role -t --type -U --other-user -T --command-timeout], before: 0, stop: []}
    setsid: {values: [], before: 0, stop: []}
    systemd-run: {
        values: [
            -u --unit -p --property --description --slice -E --setenv --uid --gid -M --machine -H --host --working-directory --nice
            --on-active --on-boot --on-startup --on-unit-active --on-unit-inactive --on-calendar --timer-property --path-property
            --socket-property --service-type
        ]
        before: 0, stop: []
    }
    env: {values: [-u --unset -C --chdir], before: 0, stop: [-S --split-string]}
    pkexec: {values: [--user], before: 0, stop: []}
    flock: {values: [-w --timeout -E --conflict-exit-code], before: 1, stop: [-c --command]}
}
# a local wrapper: a --wrapped def whose rest parameter's first word is run as the command
const WRAPPER_DEF = '(?m)^\s*(?:export )?def (?:--\S+ )*?--wrapped (?:--\S+ )*(?<name>[\w-]+) \[[^\]]*?\.\.\.(?<rest>\w+)'
const SHEBANG = '^#!\s*(?:/usr)?/bin/(?:env\s+(?:-S\s+)?)?(?<w>[\w.+-]+)'
const SH_BUILTINS = [
    . : "[" alias bg bind break builtin caller cd command compgen complete continue declare dirs disown echo enable eval exec
    exit export false fc fg getopts hash help history jobs kill let local logout mapfile popd printf pushd pwd read readarray
    readonly return set shift shopt source suspend test times trap true type typeset ulimit umask unalias unset wait
]
const PY_CALL = '\bsubprocess\.(?:run|call|check_call|check_output|Popen)\(\s*\[\s*(?:"(?<d>[^"]+)"|''(?<s>[^'']+)'')'
const CONST_DEF = '(?m)^\s*(?:export )?const (?<name>[A-Z][A-Z0-9_]*) = ["'']?(?<value>/?[\w./+-]+)["'']?\s*$'
# A fail-closed unit, the binary whose absence must never switch it off (that fails open), and the escape route that
# lets the machine fetch the binary while the unit holds: a repo file each and the pattern it must keep.
export const FAIL_CLOSED = [
    [unit gate file escape];
    [fw-egress.service tor configs/base/pacman/pacman.conf '(?m)^DownloadUser\s*=\s*alpm\s*$']
    [fw-egress.service tor configs/base/nftables/fw-egress.service 'u=\$\$\(id -u alpm\) && echo "add element inet fw_egress fetch_uid ']
    [fw-egress.service tor configs/base/nftables/fw-egress.nft '(?m)^\s*meta skuid @fetch_uid tcp dport \{ 80, 443 \} accept\s*$']
    [fw-egress.service tor configs/base/resolved/resolved.conf '(?m)^DNSOverTLS=yes\s*$']
    [fw-egress.service tor configs/base/nftables/fw-egress.service 'u=\$\$\(id -u systemd-resolve\) && echo "add element inet fw_egress resolver_uid ']
    [fw-egress.service tor configs/base/nftables/fw-egress.nft '(?m)^\s*meta skuid @resolver_uid tcp dport 853 accept\s*$']
]
const FAIL_CLOSED_OFF = '\bunit-(disable|mask)\b|\bsystemctl\b.*\b(stop|disable|mask|kill)\b'
const FAIL_CLOSED_LIST = '(?m)^\s*(?:export )?const (?<name>[A-Z][A-Z0-9_]*) = \[(?<values>[^\]\n]*)\]\s*$'
const FAIL_CLOSED_LET = '(?m)^\s*(?:let|mut) (?<name>[a-z_][a-z0-9_-]*)\s*=\s*(?<value>.*)$'

def call-name [word: string, consts: record]: nothing -> any {
    let name = if ($word | str starts-with "$") { $consts | get --optional ($word | str substring 1..) } else { $word }
    if $name == null or $name =~ $PATHS_EXEMPT or not ($name =~ $COMMAND_NAME) { return null }
    if ($name | str starts-with "/") and not ($name =~ $PATHS_PACKAGED) { return null }
    $name
}

# The commands a call's words run: the first, and for a wrapper command its target and the target's own, as long as
# the target is a word and not computed (WORD_COMPUTED).
export def wrapper-chain [words: list<string>]: nothing -> list<string> {
    let name = $words | get --optional 0 | default $WORD_COMPUTED
    let spec = $WRAPPERS | get --optional ($name | path basename)
    if $spec == null { return [$name] }
    mut i = 1
    mut before = $spec.before
    while $i < ($words | length) {
        let w = $words | get $i
        if $w == $WORD_COMPUTED and $before == 0 { return [$name] }
        if $w == $WORD_COMPUTED { $before -= 1; $i += 1; continue }
        if $w == "--" { return ([$name] ++ (wrapper-chain ($words | skip ($i + 1)))) }
        if $w in $spec.stop { return [$name] }
        if $w in $spec.values { $i += 2; continue }
        if ($w | str starts-with "-") or ($w =~ '^\w+=') { $i += 1; continue }
        if $before > 0 { $before -= 1; $i += 1; continue }
        return ([$name] ++ (wrapper-chain ($words | skip $i)))
    }
    [$name]
}

# A token as a word: a plain or quoted literal as written, a $CONST for call-name to resolve, else WORD_COMPUTED.
def token-word [t: record]: nothing -> string {
    if $t.shape == $SHAPE_VARIABLE and $t.content =~ $CONST_NAME { return $t.content }
    if $t.shape in $ARG_DYNAMIC_SHAPES or $t.shape not-in $ARG_WORD_SHAPES { return $WORD_COMPUTED }
    let c = $t.content
    let quoted = ($c | str length) >= 2 and ($c | str substring 0..0) in ['"' "'" '`'] and ($c | str substring 0..0) == ($c | str substring (-1)..)
    if $quoted { $c | str substring 1..(-2) } else { $c }
}

# The words of the call whose arguments start at token i: its externalargs, globpatterns and strings in a row, computed
# ones too; a pipe, a semicolon or any other shape ends them.
def call-args [tokens: list<record>, text: binary, i: int]: nothing -> list<string> {
    mut words = []
    mut k = $i
    while $k < ($tokens | length) {
        let t = $tokens | get $k
        let gap = $text | bytes at (($tokens | get ($k - 1)).span.end)..<$t.span.start | decode utf-8
        if $gap =~ $ARG_END or not ($t.shape in $ARG_WORD_SHAPES or $t.shape in $ARG_DYNAMIC_SHAPES) { break }
        if ($gap | str contains "\n") and $t.shape in $ARG_DYNAMIC_SHAPES { break }
        $words = $words ++ [(token-word $t)]
        $k += 1
    }
    $words
}

# The items of the list that opens at token i (past a paren around it), in order, computed ones too.
def list-items [tokens: list<record>, i: int]: nothing -> list<string> {
    let rest = $tokens | skip $i | skip while {|t| $t.shape == $SHAPE_BLOCK and ($t.content | str trim) == "(" }
    if ($rest | get --optional 0.content | default "" | str trim) != "[" { return [] }
    $rest | skip 1 | take while {|t| not ($t.shape == $SHAPE_LIST and ($t.content | str trim) == "]") }
        | where {|t| not ($t.shape == $SHAPE_LIST and ($t.content | str trim) == "") }
        | each { token-word $in }
}

# The wrappers a file defines: --wrapped defs that run their rest parameter's first word.
def wrappers-local [text: string]: nothing -> list<string> {
    $text | parse --regex $WRAPPER_DEF | where {|d|
        let body = $text | split row $"def " | where ($it | str contains $"($d.name) [") | get --optional 0 | default ""
        $body =~ $"run-external \\.\\.\\.\\$($d.rest)\\b|\\^\\$($d.rest)\\.0\\b|\\bexec \\.\\.\\.\\$($d.rest)\\b"
    } | get name
}

# The calls in a nushell file's flattened parse (nu --ide-ast): {start, words}, words[0] the command. An external,
# ^$CONST, run-external, nu's exec, the module helper exec <name> [argv], --then [argv] and a local wrapper's args.
def nu-calls [text: string, tokens: list<record>]: nothing -> list<record> {
    let bin = $text | into binary
    let local = wrappers-local $text
    $tokens | enumerate | each {|e|
        let t = $e.item
        let i = $e.index
        let next = $tokens | get --optional ($i + 1)
        let caret = $t.span.start > 0 and ($bin | bytes at ($t.span.start - 1)..<$t.span.start) == 0x[5e]
        let words = if $t.shape == $SHAPE_EXTERNAL {
            [($t.content | str replace --regex '^\^' "")] ++ (call-args $tokens $bin ($i + 1))
        } else if $t.shape == $SHAPE_VARIABLE and $caret {
            [$t.content] ++ (call-args $tokens $bin ($i + 1))
        } else if $t.shape == $SHAPE_CALL and $t.content == "run-external" {
            call-args $tokens $bin ($i + 1)
        } else if $t.shape == $SHAPE_CALL and $t.content == "exec" and $next != null {
            # the helper's name is a string and its argv a list; nu's own exec takes the command as a bare word. An
            # interpolated name spans tokens up to its closing quote's.
            let after = if $next.shape == $SHAPE_INTERPOLATION {
                $tokens | enumerate | skip ($i + 2) | where item.shape == $SHAPE_INTERPOLATION | get --optional 0.index | default $i | $in + 1
            } else { $i + 2 }
            let decl = list-items $tokens $after
            if $next.shape in [shape_string $SHAPE_INTERPOLATION] and ($decl | is-not-empty) { $decl } else { call-args $tokens $bin ($i + 1) }
        } else if $t.shape == $SHAPE_FLAG and $t.content == "--then" {
            list-items $tokens ($i + 1)
        } else if $t.shape == $SHAPE_CALL and $t.content in $local {
            call-args $tokens $bin ($i + 1)
        } else { [] }
        if ($words | is-not-empty) { {start: $t.span.start, words: $words} }
    } | compact
}

def line-of [newlines: list<int>, offset: int]: nothing -> int {
    ($newlines | where $it < $offset | length) + 1
}

def calls-to-commands [calls: list<record>, consts: record, newlines: list<int>]: nothing -> table<line: int, cmd: string> {
    $calls | each {|c|
        let line = line-of $newlines $c.start
        wrapper-chain $c.words | each { call-name $in $consts } | compact | each {|cmd| {line: $line, cmd: $cmd} }
    } | flatten | uniq
}

# The flattened parse of a nushell file, its imports resolved from its own dir and the module API's.
def nu-tokens [file: path]: nothing -> list<record> {
    let file = $file | path expand
    let run = do { cd ($file | path dirname); ^$nu.current-exe --no-config-file -I $LIB_DIR --ide-ast $file } | complete
    if $run.exit_code != 0 { error make {msg: $"commands: nu --ide-ast ($file): ($run.stderr | str trim)"} }
    $run.stdout | from json
}

# The commands a nushell file runs, read from its parse: what nu itself calls an external, plus the declarations and
# wrappers that name a command as data (see nu-calls); a wrapper command adds its target.
export def commands-from-nu [file: path]: nothing -> table<line: int, cmd: string> {
    let text = open --raw $file | into string
    let consts = $text | parse --regex $CONST_DEF | reduce --fold {} {|c, acc| $acc | upsert $c.name $c.value }
    let newlines = $text | into binary | bytes index-of --all 0x[0a]
    calls-to-commands (nu-calls $text (nu-tokens $file)) $consts $newlines
}

# A word's text when every part of it is literal, quoted or not, else null.
def sh-word-literal [word: record]: nothing -> any {
    let parts = $word.Parts | each {|p|
        match $p.Type? {
            Lit | SglQuoted => $p.Value
            DblQuoted => (if ($p.Parts | all {|q| $q.Type? == "Lit" }) { $p.Parts.Value? | default [] | str join })
            _ => null
        }
    }
    if ($parts | any { $in == null }) { null } else { $parts | str join }
}

# The calls an alias line defines: each literal name=value's value split into words, one with an expansion computed.
def sh-alias-calls [args: list<record>]: nothing -> list<record> {
    $args | skip 1 | each {|a|
        let text = sh-word-literal $a
        if $text != null and ($text | str contains "=") {
            let words = $text | split row --number 2 "=" | last | split row --regex '\s+' | where $it != ""
            {line: $a.Pos.Line, words: ($words | each { if $in =~ '[$`"'']' { $WORD_COMPUTED } else { $in } })}
        }
    } | compact | where ($it.words | is-not-empty)
}

def sh-walk [node: any]: nothing -> list<record> {
    let kind = $node | describe
    if ($kind | str starts-with "list") or ($kind | str starts-with "table") { return ($node | each { sh-walk $in } | flatten) }
    if not ($kind | str starts-with "record") { return [] }
    let own = if $node.Type? == "CallExpr" and ($node.Args? | is-not-empty) {
        let words = $node.Args | each {|a| if ($a.Parts | all {|p| $p.Type? == "Lit" }) { $a.Parts.Value | str join } else { $WORD_COMPUTED } }
        let aliased = if $words.0 == "alias" { sh-alias-calls $node.Args } else { [] }
        [{line: $node.Args.0.Pos.Line, words: $words}] ++ $aliased
    } else { [] }
    $own ++ ($node | values | each { sh-walk $in } | flatten)
}

# The commands a shell script runs: its interpreter and each simple command's first word (shfmt's parse) that is no
# shell builtin or function of its own, and what an alias runs; exec and the wrapper commands add their targets. --zsh
# parses zsh, the language of the conf.d drop-ins.
export def commands-from-sh [text: string, --zsh]: nothing -> table<line: int, cmd: string> {
    let lang = if $zsh { [-ln zsh] } else { [] }
    let run = $text | ^shfmt ...$lang --to-json | complete
    if $run.exit_code != 0 { error make {msg: $"commands: shfmt: ($run.stderr | str trim)"} }
    let functions = $text | parse --regex '(?m)^\s*(?:function\s+)?(?<name>[\w-]+)\s*\(\)' | get name
    let shebang = $text | parse --regex $SHEBANG | get --optional 0.w | if $in == null { [] } else { [{line: 1, cmd: $in}] }
    let calls = sh-walk ($run.stdout | from json) | each {|c|
        let words = if $c.words.0? == "exec" { $c.words | skip 1 | skip while { $in | str starts-with "-" } } else { $c.words }
        wrapper-chain $words | where {|w| $w not-in $SH_BUILTINS and $w not-in $functions } | each { call-name $in {} } | compact
        | each {|cmd| {line: $c.line, cmd: $cmd} }
    } | flatten
    $shebang ++ $calls | uniq
}

# The commands a python script runs: its interpreter and the literal first word of a subprocess call's argv.
export def commands-from-py [text: string]: nothing -> table<line: int, cmd: string> {
    let shebang = $text | parse --regex $SHEBANG | get --optional 0.w | if $in == null { [] } else { [{line: 1, cmd: $in}] }
    let calls = $text | lines | enumerate | each {|l|
        $l.item | parse --regex $PY_CALL | each {|m| call-name ($m.d | default --empty $m.s) {} } | compact | each {|cmd| {line: ($l.index + 1), cmd: $cmd} }
    } | flatten
    $shebang ++ $calls | uniq
}

# The first word of a unit's Exec lines, past systemd's - @ : + ! prefixes, and a wrapper command's target.
export def commands-from-unit [text: string]: nothing -> table<line: int, cmd: string> {
    $text | lines | enumerate | each {|l|
        $l.item | parse --regex '^\s*Exec\w*=[-@:+!|]*(?<w>[^\s@]+(?:\s.*)?)$' | get w | each {|line|
            let words = $line | split row --regex '\s+' | where $it != "" | each { if $in =~ '[$%@"'']' { $WORD_COMPUTED } else { $in } }
            wrapper-chain $words | each { call-name $in {} } | compact
        } | flatten | each {|c| {line: ($l.index + 1), cmd: $c} }
    } | flatten
}

# Whether a module's code checks for the command before it runs it: which, a module's own has helper, or a shell
# script's command -v.
export def command-guarded [texts: list<string>, cmd: string]: nothing -> bool {
    let name = $cmd | path basename | str replace --all "." '\.' | str replace --all "+" '\+'
    $texts | any {|t| $t =~ $"\\b\(?:which|has|command -v\) \\s*[\"']?\(/usr/s?bin/\)?($name)\\b" }
}

# Each public module's dir, files and the calls in them; a file belongs to the nearest dir with a mod.nu.
export def commands-scan [repo: path]: nothing -> table {
    let repo = $repo | path expand
    let configs = $repo | path join configs
    let dirs = glob $"($configs)/*/**/mod.nu" --exclude [$"($SECRETS_GROUP)/**"] | path dirname | sort --reverse
    let skip = [$"($SECRETS_GROUP)/**" "**/*.test.nu" "**/test-*.py" $TEMPLATES_GLOB]
    let files = glob $"($configs)/*/**/*.{nu,sh,zsh,py}" --exclude $skip | append (glob $"($configs)/*/($UNIT_GLOB)" --exclude $skip)
    let owned = $files | each {|f| {file: $f, dir: ($dirs | where {|d| $f | str starts-with $"($d)/" } | get --optional 0)} } | where dir != null
    let read = $owned | par-each {|f|
        let text = open --raw $f.file | into string
        let calls = match ($f.file | path parse | get extension) {
            nu => (commands-from-nu $f.file)
            sh => (commands-from-sh $text)
            zsh => (commands-from-sh $text --zsh)
            py => (commands-from-py $text)
            _ => (commands-from-unit $text)
        }
        {dir: $f.dir, file: ($f.file | path relative-to $repo), text: $text, calls: $calls}
    }
    $read | group-by dir | items {|dir, files| {id: ($dir | path relative-to $configs), files: ($files | reject dir | sort-by file)} } | sort-by id
}

export def commands-used [scan: table]: nothing -> list<string> {
    $scan | get files | flatten | get calls | flatten | get --optional cmd | default [] | uniq | sort
}

# What a packages hook is evaluated under to learn every package it can want, whoever runs it on whichever machine:
# each repo profile and none, as the env profile-load reads (a config home that does not exist hides the caller's own
# profile and options), and each value a platform's options file sets.
export def packages-every-context [repo: path]: nothing -> record {
    let profiles = glob ($repo | path join profiles *.nuon) | sort | append "" | each {|f| {PROFILE_FILE: $f, XDG_CONFIG_HOME: $PROFILE_HOME_NONE} }
    let values = glob ($repo | path join platforms *.options.nuon) | sort | each {|f|
        open $f | items {|id, opts| $opts | items {|name, value| {id: $id, name: $name, value: $value} } } | flatten
    } | flatten
    {profiles: $profiles, values: $values}
}

# Every package a module can declare: meta's pacman and native, flatpak and nix for apps of theirs, and what its
# packages hook returns under each profile of every and each option value from defaults, choices, bools and platforms.
export def module-packages-every [m: record, every: record]: nothing -> list<string> {
    let managers = [[name wanted]; [flatpak ($m.meta.packages.flatpak | is-not-empty)] [nix ($m.meta.packages.nix | is-not-empty)]]
    let own = $m.meta.packages.pacman ++ $m.meta.packages.native ++ ($managers | where wanted | get name)
    if "packages" not-in $m.native { return $own }
    let defaults = $m.options | items {|name, spec| {name: $name, value: $spec.default} } | reduce --fold ($m.cfg | upsert enable true) {|o, acc|
        $acc | upsert $o.name $o.value
    }
    let variants = $m.options | items {|name, spec|
        let set = $every.values | where id == $m.id and name == $name | get value
        let values = $spec.choices? | default (if $spec.type == bool { [true false] } else { [] }) | append $set | uniq
        $values | each {|v| $defaults | upsert $name $v }
    } | flatten | prepend $defaults | uniq
    let runs = $every.profiles | each {|p| $variants | each {|cfg| {env: $p, cfg: $cfg} } } | flatten
    let hooked = $runs | par-each {|r|
        with-env $r.env { modules-eval [$m] packages {$m.id: $r.cfg} [] } | get 0.decls | get --optional 0 | default {} | select --optional pacman native | values | flatten | compact
    } | flatten
    $own ++ ($hooked | sort) | compact | uniq
}

# One row per command: its owner (a package, base, - or ?) and the declared packages whose install brings it.
export def commands-map-load [file: path]: nothing -> record {
    if not ($file | path exists) { return {} }
    open --raw $file | lines | where {|l| $l != "" and not ($l | str starts-with "#") } | each { split row " " } | reduce --fold {} {|w, acc|
        $acc | upsert $w.0 {owner: $w.1, providers: ($w | skip 2)}
    }
}

export def commands-map-render [map: record]: nothing -> string {
    let rows = $map | items {|cmd, r| [$cmd $r.owner] ++ $r.providers | str join " " } | sort
    [$COMMANDS_HEAD] ++ $rows | str join "\n" | $"($in)\n"
}

# The repos' sync databases (.db, .files and their signatures) in a user cache, refreshed from each repo's first server
# that answers; returns the dbpath for pacman -F and pactree -s. The repos and servers are pacman.conf's, the same on
# every machine dot installs, so gen resolves alike wherever it runs, whatever is installed there.
export def commands-sync-db []: nothing -> path {
    let dbpath = xdg cache ...$SYNC_DB_CACHE
    let sync = $dbpath | path join sync
    mkdir $sync
    for repo in (^pacman-conf --repo-list | lines) {
        let servers = ^pacman-conf --repo $repo Server | lines
        for kind in $SYNC_DB_KINDS {
            let file = $sync | path join $"($repo).($kind)"
            let fresh = $servers | any {|server|
                let url = $"($server)/($repo).($kind)"
                let since = if ($file | path exists) { [-z $file] } else { [] }
                let got = ^curl -fsSL -R --connect-timeout $SYNC_DB_CONNECT_S ...$since -o $"($file).part" $url | complete
                if $got.exit_code != 0 { rm --force $"($file).part"; return false }
                # -z left no part when the server's copy is no newer
                if ($"($file).part" | path exists) { mv --force $"($file).part" $file }
                let sig = ^curl -fsSL -R --connect-timeout $SYNC_DB_CONNECT_S -o $"($file).sig" $"($url).sig" | complete
                if $sig.exit_code != 0 { rm --force $"($file).sig" }
                true
            }
            if not $fresh { error make {msg: $"commands: no server of ($repo) answered for ($repo).($kind): ($servers | str join ' ')"} }
        }
    }
    $dbpath
}

# The path a files database lists a command under: a bare name or any bin dir is usr/bin, other paths as they are.
export def command-db-path [cmd: string]: nothing -> string {
    if not ($cmd | str starts-with "/") { return $"($BIN_DIR)($cmd)" }
    if $cmd =~ $BIN_DIRS { $cmd | str replace --regex $BIN_DIRS $BIN_DIR } else { $cmd | str substring 1.. }
}

# The packages owning each path, in pacman.conf's repo order, from pacman -F --machinereadable (repo NUL package NUL
# version NUL path per line).
export def command-owners-parse [text: string]: nothing -> record {
    $text | lines | each { split row (char nul) } | where ($it | length) == 4 | reduce --fold {} {|w, acc|
        let have = $acc | get --optional $w.3 | default []
        $acc | upsert $w.3 (if $w.1 in $have { $have } else { $have ++ [$w.1] })
    }
}

# One row from a command's owners: base when one is in the pacstrap closure, - when no repo package has it, else the
# first owner and the declared packages whose install brings one of them (brought_by: package to the declared ones
# whose dependency closure holds it).
export def command-row [owners: list<string>, closure: list<string>, brought_by: record]: nothing -> record {
    if ($owners | is-empty) { return {owner: $OWNER_NONE, providers: []} }
    if ($owners | any { $in in $closure }) { return {owner: $OWNER_BASE, providers: []} }
    let brings = $owners | each {|o| $brought_by | get --optional $o | default [] } | flatten
    {owner: $owners.0, providers: ($owners ++ $brings | uniq | sort)}
}

# The package names in pactree's tree output: "<tree>name[>=version]" or "<tree>provider provides dependency".
export def pactree-names [text: string]: nothing -> list<string> {
    $text | lines | each { str replace --regex '^[^A-Za-z0-9@_+]+' "" | split row " " | first | split row --regex '[<>=]' | first } | where $it != "" | uniq
}

# A package's dependency closure in the sync databases, itself first. Forward, as pacman installs it: a reverse walk
# follows every provider of a virtual dependency (any pinentry-* makes gnupg's dependents its own). The tree, not
# -l: the list names a dependency a provider satisfies by the dependency (libbemenu.so=0-64), not by its package.
def sync-closure [dbpath: path, package: string]: nothing -> list<string> {
    pactree-names (^pactree -s -b $dbpath $package | complete | get stdout)
}

# Resolves each command against the repos' sync databases, never this machine's installed packages.
export def commands-map-resolve [cmds: list<string>, declared: list<string>, base: list<string>]: nothing -> record {
    let dbpath = commands-sync-db
    let paths = $cmds | each {|c| {cmd: $c, path: (command-db-path $c)} }
    let found = with-env {LC_ALL: C} { ^/usr/bin/pacman -F --dbpath $dbpath --machinereadable ...($paths.path | uniq) | complete }
    if ($found.stderr | str trim | is-not-empty) { error make {msg: $"commands: pacman -F: ($found.stderr | str trim)"} }
    let owners = command-owners-parse $found.stdout
    let closure = $base ++ $BASE_EXTRA | par-each { sync-closure $dbpath $in } | flatten | uniq
    let brought_by = $declared | uniq | par-each {|d| sync-closure $dbpath $d | each {|p| {package: $p, by: $d} } } | flatten
        | group-by package | items {|p, rows| {$p: ($rows.by | uniq | sort)} } | reduce --fold {} {|r, acc| $acc | merge $r }
    $paths | reduce --fold {} {|p, acc|
        $acc | insert $p.cmd (command-row ($owners | get --optional $p.path | default []) $closure $brought_by)
    }
}

def deps-closure [id: string, deps: record]: nothing -> list<string> {
    mut seen = []
    mut todo = [$id]
    while ($todo | is-not-empty) {
        let next = $todo | first
        $todo = $todo | skip 1
        if $next in $seen { continue }
        $seen = $seen ++ [$next]
        $todo = $todo ++ ($deps | get --optional $next | default [])
    }
    $seen
}

# Calls whose package neither the module nor its transitive deps declare, nor the pacstrap set holds, nor a guard
# checks for; modules: id, deps, packages, files (file, text, calls). key is "<module> <command>", the allowlist's form.
export def commands-undeclared [modules: table, map: record]: nothing -> table<key: string, finding: string> {
    let deps = $modules | reduce --fold {} {|m, acc| $acc | insert $m.id $m.deps }
    let packages = $modules | reduce --fold {} {|m, acc| $acc | insert $m.id $m.packages }
    $modules | each {|m|
        let declared = deps-closure $m.id $deps | each {|d| $packages | get --optional $d | default [] } | flatten
        let texts = $m.files.text
        $m.files | each {|f|
            $f.calls | each {|c|
                let row = $map | get --optional $c.cmd
                let packaged = $row != null and $row.owner not-in [$OWNER_BASE $OWNER_NONE]
                if $packaged and not ($row.providers | any { $in in $declared }) and not (command-guarded $texts $c.cmd) {
                    let finding = $"($f.file):($c.line): runs ($c.cmd) from ($row.owner), which neither ($m.id) nor its deps declare; add it to meta.packages or guard the call with which"
                    {key: $"($m.id) ($c.cmd)", finding: $finding}
                }
            } | compact
        } | flatten
    } | flatten
}

# A nushell line without its comment: a whole-line one leaves nothing, a trailing one is cut outside quotes.
def fail-closed-code [line: string]: nothing -> string {
    if ($line | str trim --left | str starts-with "#") { return "" }
    $line | str replace --regex (r#'^((?:'# + $QUOTED + r#'|[^"'`#])*)\s#.*$'#) '$1'
}

# The line and the headers of every block around it, found by indentation; an else brings its if along.
def fail-closed-scope [lines: list<string>, index: int]: nothing -> list<string> {
    let indent = {|l| ($l | str length) - ($l | str trim --left | str length) }
    mut limit = do $indent ($lines | get $index)
    mut scope = [($lines | get $index)]
    for i in (seq ($index - 1) -1 0) {
        if $limit == 0 { break }
        let line = $lines | get $i
        let at = do $indent $line
        if ($line | str trim) == "" or $at >= $limit { continue }
        $scope = $scope | append $line
        $limit = if ($line | str trim --left | str starts-with "}") { $at + 1 } else { $at }
    }
    $scope
}

# Lines switching the unit off (by name, or through a const naming it) under a condition on the gate binary, with the
# lets and consts that condition reads resolved.
def fail-closed-gated [file: record, unit: string, gate: string]: nothing -> list<string> {
    let lines = $file.text | lines | each { fail-closed-code $in }
    let code = $lines | str join "\n"
    let scalars = $code | parse --regex $CONST_DEF | each {|c| {name: $c.name, values: [$c.value]} }
    let lists = $code | parse --regex $FAIL_CLOSED_LIST
        | each {|c| {name: $c.name, values: ($c.values | split row --regex '\s+' | where $it != "" | str trim --char '"')} }
    let consts = $scalars ++ $lists
    let lets = $code | parse --regex $FAIL_CLOSED_LET | reduce --fold {} {|l, acc| $acc | upsert $l.name $l.value }
    let names = $consts | where $unit in $it.values | each { $"\\$($in.name)\\b" }
    let unit_re = [($unit | str replace --all "." '\.')] ++ $names | str join "|"
    let gate_re = $"\(which\\s+['\"]?|/usr/bin/|/bin/|id -u\\s+\)($gate)\\b"
    $lines | enumerate | where {|l| $l.item =~ $FAIL_CLOSED_OFF } | each {|l|
        let scope = fail-closed-scope $lines $l.index | str join "\n"
        let read = $scope | parse --regex '\$(?<v>[a-z_][a-z0-9_-]*)' | get v | uniq | each {|v| $lets | get --optional $v } | compact
        let resolved = $consts | reduce --fold ([$scope] ++ $read | str join "\n") {|c, acc|
            $acc | str replace --all --regex $"\\$($c.name)\\b" ($c.values | str join " ")
        }
        if $scope =~ $unit_re and $resolved =~ $gate_re {
            $"($file.file):($l.index + 1): switches ($unit) off when ($gate) is missing, which fails open; keep it on, its escape route fetches ($gate)"
        }
    } | compact
}

# Each fail-closed unit's escape route is in place, and no module switches the unit off for lacking its gate binary.
export def commands-fail-closed [repo: path, modules: table]: nothing -> list<string> {
    let lost = $FAIL_CLOSED | each {|e|
        let path = $repo | path join $e.file
        let text = if ($path | path exists) { open --raw $path } else { "" }
        if not ($text =~ $e.escape) { $"($e.file): lost ($e.unit)'s escape route, wants a match for ($e.escape)" }
    } | compact
    let gates = $FAIL_CLOSED | select unit gate | uniq
    let off = $modules | each {|m|
        $m.files | where ($it.file | str ends-with ".nu") | each {|f|
            $gates | where {|g| $f.text | str contains $g.unit } | each {|g| fail-closed-gated $f $g.unit $g.gate } | flatten
        } | flatten
    } | flatten
    $lost ++ $off
}

# "<module> <command>  # reason" per line; a line without its reason or one no finding needs is a finding itself.
export def commands-allow-check [lines: list<string>, needed: list<string>]: nothing -> record<allowed: list<string>, findings: list<string>> {
    let rows = $lines | enumerate | where {|l| ($l.item | str trim) != "" and not ($l.item | str starts-with "#") } | each {|l|
        let key = $l.item | split row "#" | first | str trim | split row --regex '\s+' | str join " "
        {n: ($l.index + 1), key: $key, reason: ($l.item | str contains "#")}
    }
    let unreasoned = $rows | where not reason | each { $"($ALLOW_FILE):($in.n): '($in.key)' has no reason, add one after #" }
    let unneeded = $rows | where key not-in $needed | each { $"($ALLOW_FILE):($in.n): '($in.key)' is declared or gone now, drop the line" }
    {allowed: $rows.key, findings: ($unreasoned ++ $unneeded)}
}

# Every finding of both rules, from the modules pipeline-load found.
export def commands-check [repo: path, loaded: table]: nothing -> list<string> {
    let scan = commands-scan $repo
    let map = commands-map-load ($repo | path join $COMMANDS_FILE)
    let meta = $loaded | where group != $SECRETS_GROUP | reduce --fold {} {|m, acc| $acc | insert $m.id $m }
    let every = packages-every-context $repo
    let modules = $scan | each {|s|
        let m = $meta | get --optional $s.id
        $s | insert deps ($m.meta.deps? | default []) | insert packages (if $m == null { [] } else { module-packages-every $m $every })
    }
    let undeclared = commands-undeclared $modules $map
    let allow_file = $repo | path join $ALLOW_FILE
    let allow = commands-allow-check (if ($allow_file | path exists) { open --raw $allow_file | lines } else { [] }) ($undeclared.key? | default [])
    ($undeclared | where key not-in $allow.allowed | get --optional finding | default []) ++ (commands-fail-closed $repo $modules) ++ $allow.findings
}
